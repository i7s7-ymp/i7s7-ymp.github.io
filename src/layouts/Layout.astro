---
export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Pop City Portfolio - i7s7-ymp' } = Astro.props;
---

<!doctype html>
<html lang="ja" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- フォント読み込み -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="h-screen overflow-hidden bg-cyber-gradient font-sans text-white">
    <a href="#main-content" class="skip-link">メインコンテンツへ移動</a>
    <!-- 背景パーティクル -->
    <div class="pointer-events-none fixed inset-0 overflow-hidden">
      <div
        class="absolute -right-40 -top-40 h-80 w-80 animate-float rounded-full bg-accent-cyan opacity-15 blur-3xl"
      >
      </div>
      <div
        class="absolute -left-40 top-1/3 h-64 w-64 animate-float rounded-full bg-accent-blue opacity-15 blur-3xl"
        style="animation-delay: -1s;"
      >
      </div>
      <div
        class="absolute bottom-20 right-1/3 h-48 w-48 animate-float rounded-full bg-accent-neon opacity-15 blur-3xl"
        style="animation-delay: -2s;"
      >
      </div>
    </div>

    <div class="relative z-10 flex h-screen">
      <!-- サイドバー -->
      <aside
        class="flex w-72 flex-col border-r border-primary-600/30 bg-dark-900/80 shadow-2xl backdrop-blur-md"
      >
        <div
          class="border-b border-primary-600/30 bg-gradient-to-r from-primary-700/20 to-accent-cyan/20 p-6"
        >
          <div class="flex items-center space-x-3">
            <div
              class="flex h-12 w-12 animate-glow items-center justify-center rounded-full bg-neon-gradient shadow-lg"
            >
              <span class="text-xl font-bold text-white">i7</span>
            </div>
            <div>
              <h1 class="font-sans text-xl font-bold text-white">
                i7s7-ymp
                <span class="animate-pulse text-accent-cyan">◆</span>
              </h1>
              <p class="font-mono text-sm text-primary-400">./creative.portfolio</p>
            </div>
          </div>
        </div>

        <nav class="flex-1 p-6" aria-label="Main navigation">
          <ul class="space-y-3">
            <li>
              <a href="/" class="nav-link group" data-page="home">
                <div class="flex items-center space-x-3">
                  <div class="h-2 w-2 rounded-full bg-accent-neon group-hover:animate-pulse"></div>
                  <span class="font-medium">Home</span>
                </div>
                <span class="font-mono text-xs text-primary-400 opacity-60">index.tsx</span>
              </a>
            </li>
            <li>
              <a href="/support" class="nav-link group" data-page="support">
                <div class="flex items-center space-x-3">
                  <div class="h-2 w-2 rounded-full bg-accent-cyan group-hover:animate-pulse"></div>
                  <span class="font-medium">Architecture</span>
                </div>
                <span class="font-mono text-xs text-primary-400 opacity-60">system.config</span>
              </a>
            </li>
            <li>
              <a href="/achievements" class="nav-link group" data-page="achievements">
                <div class="flex items-center space-x-3">
                  <div class="h-2 w-2 rounded-full bg-accent-gold group-hover:animate-pulse"></div>
                  <span class="font-medium">Achievements</span>
                </div>
                <span class="font-mono text-xs text-primary-400 opacity-60">records.json</span>
              </a>
            </li>
            <li>
              <a href="/social" class="nav-link group" data-page="social">
                <div class="flex items-center space-x-3">
                  <div class="h-2 w-2 rounded-full bg-accent-pink group-hover:animate-pulse"></div>
                  <span class="font-medium">Social</span>
                </div>
                <span class="font-mono text-xs text-primary-400 opacity-60">connect.links</span>
              </a>
            </li>
            <li>
              <a href="/agent" class="nav-link group" data-page="agent">
                <div class="flex items-center space-x-3">
                  <div class="h-2 w-2 rounded-full bg-accent-blue group-hover:animate-pulse"></div>
                  <span class="font-medium">AI Agent</span>
                </div>
                <span class="font-mono text-xs text-primary-400 opacity-60">agent.ai</span>
              </a>
            </li>
          </ul>
        </nav>

        <!-- モードトグル -->
        <div class="border-t border-primary-500/30 p-6">
          <button
            id="theme-toggle"
            class="group flex w-full items-center justify-between rounded-lg border border-primary-500/30 bg-gradient-to-r from-primary-600/20 to-accent-pink/20 p-3 backdrop-blur-sm transition-all hover:scale-105 hover:shadow-lg"
          >
            <div class="flex items-center space-x-3">
              <div class="h-3 w-3 animate-pulse rounded-full bg-pop-gradient"></div>
              <span class="font-medium text-white">シティモード</span>
            </div>
            <span class="text-sm text-accent-cyan">◇</span>
          </button>
        </div>

        <!-- ステータス -->
        <div
          class="border-t border-primary-500/30 bg-gradient-to-r from-dark-900/50 to-primary-900/20 p-6"
        >
          <div class="space-y-2 font-mono text-xs">
            <div class="flex justify-between">
              <span class="text-primary-300">status:</span>
              <span class="text-accent-neon">online</span>
            </div>
            <div class="flex justify-between">
              <span class="text-primary-300">mode:</span>
              <span class="text-accent-cyan">creative</span>
            </div>
            <div class="flex justify-between">
              <span class="text-primary-300">vibe:</span>
              <span class="text-accent-pink" id="current-time">loading...</span>
            </div>
          </div>
        </div>
      </aside>

      <!-- メインコンテンツ -->
      <main id="main-content" class="flex flex-1 flex-col overflow-hidden" tabindex="-1">
        <!-- ヘッダー -->
        <header
          class="border-b border-primary-500/30 bg-dark-900/60 p-4 shadow-lg backdrop-blur-md"
        >
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-4">
              <div class="flex space-x-2">
                <div class="h-4 w-4 animate-pulse rounded-full bg-red-400 shadow-lg"></div>
                <div
                  class="h-4 w-4 animate-pulse rounded-full bg-yellow-400 shadow-lg"
                  style="animation-delay: 0.5s;"
                >
                </div>
                <div
                  class="h-4 w-4 animate-pulse rounded-full bg-green-400 shadow-lg"
                  style="animation-delay: 1s;"
                >
                </div>
              </div>
              <div
                class="rounded-full border border-primary-500/30 bg-gradient-to-r from-primary-600/30 to-accent-cyan/30 px-4 py-2 backdrop-blur-sm"
              >
                <span class="font-mono text-sm text-white">portfolio@city:~</span>
              </div>
            </div>
            <div class="flex items-center space-x-4">
              <div
                class="rounded-full border border-primary-500/30 bg-gradient-to-r from-accent-pink/20 to-primary-600/20 px-3 py-1 backdrop-blur-sm"
              >
                <span class="font-mono text-sm text-accent-cyan" id="uptime">calculating...</span>
              </div>
            </div>
          </div>
        </header>

        <!-- ページコンテンツ -->
        <div
          class="flex-1 overflow-auto bg-gradient-to-br from-dark-900/40 to-primary-950/40 p-8 backdrop-blur-sm"
        >
          <slot />
        </div>
      </main>
    </div>

    <style>
      .nav-link {
        @apply block w-full rounded-lg p-4 text-left transition-all duration-300 hover:scale-105 hover:border hover:border-primary-500/30 hover:bg-gradient-to-r hover:from-primary-600/30 hover:to-accent-pink/30 hover:shadow-lg hover:backdrop-blur-md;
        color: rgba(255, 255, 255, 0.9);
      }

      .nav-link.active {
        @apply border border-primary-500/50 bg-gradient-to-r from-primary-600/40 to-accent-pink/40 shadow-xl backdrop-blur-md;
        color: white;
        box-shadow: 0 0 20px rgba(168, 85, 247, 0.3);
      }

      /* カスタムスクロールバー */
      ::-webkit-scrollbar {
        width: 8px;
      }

      ::-webkit-scrollbar-track {
        background: rgba(15, 23, 42, 0.3);
        border-radius: 4px;
      }

      ::-webkit-scrollbar-thumb {
        background: linear-gradient(180deg, #a855f7, #ff6b9d);
        border-radius: 4px;
        border: 1px solid rgba(168, 85, 247, 0.3);
      }

      ::-webkit-scrollbar-thumb:hover {
        background: linear-gradient(180deg, #9333ea, #e91e63);
        box-shadow: 0 0 10px rgba(168, 85, 247, 0.5);
      }

      /* グローバルスタイル */
      body {
        background: linear-gradient(135deg, #9333ea 0%, #6b21a8 50%, #3b0764 100%);
        background-attachment: fixed;
      }

      html.light body {
        background: linear-gradient(135deg, #e0e7ff 0%, #c7d2fe 40%, #bfdbfe 100%);
        color: #1e293b;
      }
      html.light .section-card {
        border-color: rgba(99, 102, 241, 0.25);
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.85), rgba(224, 231, 255, 0.7));
        color: #1e293b;
      }
      html.light .stat-card h4 {
        color: #2563eb;
      }
      html.light .panel-title,
      html.light .gradient-heading-sm {
        @apply from-indigo-600 to-blue-500;
      }
      html.light .badge-pill {
        background: linear-gradient(90deg, rgba(99, 102, 241, 0.15), rgba(59, 130, 246, 0.08));
      }
      html.light .nav-link {
        color: #1e293b;
      }
      html.light .nav-link.active {
        box-shadow: 0 0 15px rgba(59, 130, 246, 0.35);
      }
      html.light #theme-toggle span.font-medium {
        color: #1e293b;
      }

      /* ================= New Global Utility Styles (Geek + Pop) ================= */
      :root {
        --panel-border: rgba(168, 85, 247, 0.3);
        --panel-bg-from: rgba(30, 27, 75, 0.6);
        --panel-bg-to: rgba(15, 23, 42, 0.3);
      }

      .section-card {
        @apply relative overflow-hidden rounded-2xl border p-6 shadow-xl backdrop-blur-md transition-all duration-300;
        border-color: var(--panel-border);
        background: linear-gradient(135deg, var(--panel-bg-from), var(--panel-bg-to));
      }
      .section-card:hover {
        @apply scale-[1.01] shadow-2xl;
      }
      .section-card::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
          radial-gradient(circle at 85% 15%, rgba(168, 85, 247, 0.25), transparent 60%),
          radial-gradient(circle at 15% 85%, rgba(236, 72, 153, 0.15), transparent 55%);
        opacity: 0.6;
        pointer-events: none;
      }
      html.light .section-card::before {
        background:
          radial-gradient(circle at 85% 15%, rgba(99, 102, 241, 0.25), transparent 60%),
          radial-gradient(circle at 15% 85%, rgba(59, 130, 246, 0.2), transparent 55%);
      }
      .panel-title {
        @apply bg-gradient-to-r from-white to-primary-200 bg-clip-text text-xl font-bold text-transparent;
      }
      .terminal-caption {
        @apply mb-2 flex items-center space-x-2 font-mono text-xs text-primary-400/80;
      }
      .badge-list {
        @apply mt-4 flex flex-wrap gap-2;
      }
      .badge-pill {
        @apply rounded-full border px-3 py-1 text-xs font-medium tracking-wide backdrop-blur-sm;
        border-color: rgba(255, 255, 255, 0.2);
        background: linear-gradient(90deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02));
      }
      .badge-pill:hover {
        @apply border-primary-400 text-primary-200;
      }
      .subtle-divider {
        @apply my-4 h-px bg-gradient-to-r from-transparent via-primary-600/40 to-transparent;
      }
      .stat-grid {
        @apply grid gap-4 sm:grid-cols-2 lg:grid-cols-4;
      }
      .stat-card {
        @apply section-card relative p-4 text-center shadow-md;
      }
      .stat-card h4 {
        @apply mb-1 text-2xl font-bold text-accent-cyan;
      }
      .stat-card span {
        @apply text-sm text-primary-200;
      }
      .gradient-heading-sm {
        @apply bg-gradient-to-r from-accent-pink via-white to-accent-cyan bg-clip-text font-semibold text-transparent;
      }
      /* Scrollbar hiding utility (shared) */
      .hide-scrollbar {
        scrollbar-width: none;
        -ms-overflow-style: none;
      }
      .hide-scrollbar::-webkit-scrollbar {
        display: none;
      }
      /* SectionCard structural helpers (opt-in) */
      .sc-header {
        @apply mb-4 flex items-center justify-between;
      }
      .sc-body {
        @apply space-y-3;
      }
      .sc-footer {
        @apply mt-4;
      }

      /* Skip link accessibility */
      .skip-link {
        position: absolute;
        left: 0;
        top: -40px;
        background: #111827;
        color: #fff;
        padding: 8px 16px;
        z-index: 50;
        border-radius: 0 0 6px 0;
        transform: translateY(0);
        transition: top 0.2s;
      }
      .skip-link:focus {
        top: 0;
        outline: 2px solid #22d3ee;
      }
      html.light .skip-link {
        background: #1e293b;
        color: #fff;
      }

      /* Focus styles */
      .nav-link:focus-visible {
        outline: 2px solid #22d3ee;
        outline-offset: 2px;
      }
      html.light .nav-link:focus-visible {
        outline-color: #2563eb;
      }

      /* Reduced motion preference */
      @media (prefers-reduced-motion: reduce) {
        .animate-glow,
        .animate-float,
        .animate-ping,
        .animate-pulse {
          animation: none !important;
        }
        * {
          scroll-behavior: auto !important;
        }
      }
      /* ========================================================================== */
    </style>

    <script>
      // 現在時刻の更新
      function updateTime() {
        const now = new Date();
        const timeString = now.toLocaleTimeString('ja-JP', {
          hour12: false,
          hour: '2-digit',
          minute: '2-digit',
        });
        const timeElement = document.getElementById('current-time');
        if (timeElement) {
          timeElement.textContent = timeString;
        }
      }

      // アップタイムの更新
      const startTime = Date.now();
      function updateUptime() {
        const elapsed = Date.now() - startTime;
        const minutes = Math.floor(elapsed / (1000 * 60));
        const seconds = Math.floor((elapsed % (1000 * 60)) / 1000);
        const uptimeElement = document.getElementById('uptime');
        if (uptimeElement) {
          if (minutes > 0) {
            uptimeElement.textContent = `${minutes}m active`;
          } else {
            uptimeElement.textContent = `${seconds}s active`;
          }
        }
      }

      // ナビゲーションのアクティブ状態
      function updateActiveNav() {
        const currentPath = window.location.pathname;
        document.querySelectorAll('.nav-link').forEach(link => {
          link.classList.remove('active');
          if (link.getAttribute('href') === currentPath) {
            link.classList.add('active');
          }
        });
      }

      // テーマトグル（将来的な拡張用）
      function toggleTheme() {
        const root = document.documentElement;
        const isDark = root.classList.contains('dark');
        if (isDark) {
          root.classList.remove('dark');
          root.classList.add('light');
          localStorage.setItem('theme', 'light');
        } else {
          root.classList.remove('light');
          root.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        }
        updateThemeLabel();
      }

      function applyStoredTheme() {
        const stored = localStorage.getItem('theme');
        if (stored === 'light') {
          document.documentElement.classList.remove('dark');
          document.documentElement.classList.add('light');
        }
        updateThemeLabel();
      }

      function updateThemeLabel() {
        const btn = document.getElementById('theme-toggle');
        if (!btn) return;
        const isDark = document.documentElement.classList.contains('dark');
        const span = btn.querySelector('span.font-medium');
        if (span) span.textContent = isDark ? 'シティモード' : 'ライトモード';
      }

      // パーティクルアニメーション
      function createParticles() {
        const container = document.querySelector('.fixed.inset-0');
        if (!container) return;

        for (let i = 0; i < 5; i++) {
          setTimeout(() => {
            const particle = document.createElement('div');
            particle.className =
              'absolute w-1 h-1 bg-accent-cyan rounded-full opacity-60 animate-ping';
            particle.style.left = Math.random() * 100 + '%';
            particle.style.top = Math.random() * 100 + '%';
            particle.style.animationDelay = Math.random() * 2 + 's';
            container.appendChild(particle);

            setTimeout(() => {
              particle.remove();
            }, 4000);
          }, i * 1000);
        }
      }

      // イベントリスナー
      document.addEventListener('DOMContentLoaded', () => {
        applyStoredTheme();
        updateTime();
        updateUptime();
        updateActiveNav();

        setInterval(updateTime, 1000);
        setInterval(updateUptime, 1000);
        setInterval(createParticles, 8000);

        const themeToggle = document.getElementById('theme-toggle');
        if (themeToggle) themeToggle.addEventListener('click', toggleTheme);

        // 初回パーティクル生成
        createParticles();
      });

      // ページ遷移時のアクティブ状態更新
      document.addEventListener('astro:page-load', updateActiveNav);
    </script>
  </body>
</html>
