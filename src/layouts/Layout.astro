---
export interface Props {
  title: string;
  description?: string;
  headerPills?: string[]; // ステータスピル（uptime/timeは自動付与）
}

import '../styles/tokens.css';

const {
  title,
  description = 'Portfolio - i7s7-ymp',
  headerPills = ['build:ok'],
} = Astro.props as Props;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- tokens.css は frontmatter import 済み -->
  </head>
  <body class="min-h-screen overflow-x-hidden font-sans text-white antialiased">
    <!-- モバイル/タブレット向け PC 推奨バナー -->
    <div
      id="device-advisory"
      class="fixed inset-x-0 top-0 z-[100] hidden items-center justify-between gap-4 border-b border-accent-cyan/30 bg-dark-900/95 px-4 py-2 font-mono text-[11px] text-primary-200 shadow-lg backdrop-blur-md"
      role="status"
      aria-live="polite"
    >
      <div class="flex items-center gap-2">
        <span class="inline-flex h-2 w-2 animate-pulse rounded-full bg-accent-cyan/80"></span>
        <span>より快適な体験のため PC (幅 ≥ 1280px) での閲覧を推奨しています。</span>
      </div>
      <button
        type="button"
        id="device-advisory-close"
        class="rounded border border-primary-500/40 px-2 py-0.5 text-primary-300 transition hover:border-accent-cyan/60 hover:text-white"
        aria-label="案内を閉じる">×</button
      >
    </div>
    <div class="fixed inset-0 -z-20">
      <div
        class="absolute inset-0 bg-gradient-to-br from-fuchsia-800 via-indigo-900 to-slate-950 opacity-90"
      >
      </div>
      <div
        class="absolute bottom-20 right-1/3 h-48 w-48 animate-float rounded-full bg-accent-neon opacity-15 blur-3xl"
        style="animation-delay:-2s;"
      >
      </div>
    </div>
    <!-- mesh-global-layer removed; mesh handled by main scroll container pseudo elements -->
    <div class="relative z-10 flex h-screen">
      <aside
        class="flex w-72 flex-col border-r border-primary-600/30 bg-dark-900/80 shadow-2xl backdrop-blur-md"
      >
        <div
          class="border-b border-primary-600/30 bg-gradient-to-r from-primary-700/20 to-accent-cyan/20 p-6"
        >
          <div class="flex items-center space-x-3">
            <div
              class="flex h-12 w-12 animate-glow items-center justify-center rounded-full bg-neon-gradient shadow-lg"
            >
              <span class="text-xl font-bold">i7</span>
            </div>
            <div>
              <h1 class="font-sans text-xl font-bold">
                i7s7-ymp <span class="animate-pulse text-accent-cyan">◆</span>
              </h1>
              <p class="font-mono text-sm text-primary-400">Hiroki Yamashita</p>
            </div>
          </div>
        </div>
        <nav class="flex-1 p-6" aria-label="Main navigation">
          <ul class="space-y-3">
            <li>
              <a href="/" class="nav-link group" data-page="home"
                ><div class="flex items-center space-x-3">
                  <div class="h-2 w-2 rounded-full bg-accent-neon group-hover:animate-pulse">
                  </div><span class="font-medium">Home</span>
                </div><span class="font-mono text-xs text-primary-400 opacity-60">ホーム</span></a
              >
            </li>
            <li>
              <a href="/achievements" class="nav-link group" data-page="achievements"
                ><div class="flex items-center space-x-3">
                  <div class="h-2 w-2 rounded-full bg-accent-gold group-hover:animate-pulse">
                  </div><span class="font-medium">Achievements</span>
                </div><span class="font-mono text-xs text-primary-400 opacity-60">経歴</span></a
              >
            </li>
            <li>
              <a href="/support" class="nav-link group" data-page="support"
                ><div class="flex items-center space-x-3">
                  <div class="h-2 w-2 rounded-full bg-accent-cyan group-hover:animate-pulse">
                  </div><span class="font-medium">Architecture</span>
                </div><span class="font-mono text-xs text-primary-400 opacity-60">設計</span></a
              >
            </li>
            <li>
              <a href="/social" class="nav-link group" data-page="social"
                ><div class="flex items-center space-x-3">
                  <div class="h-2 w-2 rounded-full bg-accent-pink group-hover:animate-pulse">
                  </div><span class="font-medium">Social Links</span>
                </div><span class="font-mono text-xs text-primary-400 opacity-60">SNSリンク</span
                ></a
              >
            </li>
            <li>
              <a href="/chatbot" class="nav-link group" data-page="chatbot"
                ><div class="flex items-center space-x-3">
                  <div class="h-2 w-2 rounded-full bg-accent-blue group-hover:animate-pulse">
                  </div><span class="font-medium">AI Chatbot</span>
                </div><span class="font-mono text-xs text-primary-400 opacity-60"
                  >チャットボット</span
                ></a
              >
            </li>
          </ul>
        </nav>
        <div
          class="border-t border-primary-500/30 bg-gradient-to-r from-dark-900/50 to-primary-900/20 p-6"
        >
          <div class="space-y-2 font-mono text-xs">
            <div class="flex justify-between">
              <span class="text-primary-300">status:</span><span class="text-accent-neon"
                >online</span
              >
            </div>
            <div class="flex justify-between">
              <span class="text-primary-300">vibe:</span><span
                class="text-accent-pink"
                id="current-time">--:--</span
              >
            </div>
          </div>
        </div>
      </aside>
      <main
        id="main-content"
        class="flex flex-1 flex-col overflow-hidden overflow-x-hidden"
        tabindex="-1"
      >
        <header class="neo-header" aria-label="Runtime status">
          <div class="nh-inner-only-pills">
            <div class="nh-status font-mono" role="status">
              {
                headerPills.map(p => {
                  const low = p.toLowerCase();
                  const extra = low.includes('ok') ? 'ok' : low.includes('time') ? 'time' : '';
                  return <span class={`pill ${extra}`}>{p}</span>;
                })
              }
            </div>
          </div>
        </header>
        <div class="main-scroll flex-1 overflow-auto overflow-x-hidden p-8 backdrop-blur-sm">
          <!-- Geek variant extra visual layer (inert) -->
          <div class="geek-code-rain" aria-hidden="true"></div>
          <slot />
        </div>
      </main>
    </div>
    <style>
      body {
        /* Slightly darker than previous medium variant */
        background: linear-gradient(
          135deg,
          #451b78 0%,
          /* start: dark violet */ #32115b 40%,
          /* mid: deeper violet */ #20104a 72%,
          /* transition */ #0f0724 100% /* deep end */
        );
        background-color: #0f0724; /* solid fallback */
        background-attachment: fixed;
      }
      /* Device advisory visibility */
      @media (max-width: 1023px) {
        #device-advisory {
          display: flex;
        }
      }
      @media (min-width: 1024px) {
        #device-advisory {
          display: none !important;
        }
      }
      html,
      body {
        overflow-x: hidden;
      }
      .nav-link {
        @apply block w-full rounded-lg p-4 text-left transition-all duration-300 hover:scale-105 hover:border hover:border-primary-500/30 hover:bg-gradient-to-r hover:from-primary-600/30 hover:to-accent-pink/30 hover:shadow-lg hover:backdrop-blur-md;
        color: rgba(255, 255, 255, 0.9);
      }
      .nav-link.active {
        @apply border border-primary-500/50 bg-gradient-to-r from-primary-600/40 to-accent-pink/40 shadow-xl backdrop-blur-md;
        color: #fff;
        box-shadow: 0 0 20px rgba(168, 85, 247, 0.3);
      }
      ::-webkit-scrollbar {
        width: 8px;
      }
      ::-webkit-scrollbar-track {
        background: rgba(15, 23, 42, 0.3);
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb {
        background: linear-gradient(180deg, #a855f7, #ff6b9d);
        border-radius: 4px;
        border: 1px solid rgba(168, 85, 247, 0.3);
      }
      ::-webkit-scrollbar-thumb:hover {
        background: linear-gradient(180deg, #9333ea, #e91e63);
        box-shadow: 0 0 10px rgba(168, 85, 247, 0.5);
      }
      .header-indicator {
        --hi-border: rgba(255, 255, 255, 0.15);
        --hi-bg: linear-gradient(145deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02));
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 3.75rem;
        height: 1.4rem;
        padding: 0 0.4rem;
        border: 1px solid var(--hi-border);
        border-radius: 0.85rem;
        background: var(--hi-bg);
        box-shadow:
          0 4px 12px -2px rgba(0, 0, 0, 0.45),
          0 0 0 1px rgba(168, 85, 247, 0.18) inset;
        overflow: hidden;
        user-select: none;
      }
      /* ==== Continuous One-Direction Wave ============================= */
      .wave-svg {
        width: 3.2rem;
        height: 0.95rem;
        fill: none;
        overflow: visible;
      }
      .wave-track {
        animation: wave-slide 4s linear infinite;
      }
      .wave {
        stroke-linecap: round;
        vector-effect: non-scaling-stroke;
      }
      .stroke-layer {
        stroke-width: 2;
        filter: drop-shadow(0 0 4px #22d3ee) drop-shadow(0 0 10px rgba(34, 211, 238, 0.35));
      }
      .glow-layer {
        stroke-width: 5;
        opacity: 0.12;
        filter: blur(2px) drop-shadow(0 0 6px #a855f7);
      }
      @keyframes wave-slide {
        0% {
          transform: translateX(0);
        }
        100% {
          transform: translateX(-120px);
        }
      }
      /* Subtle sheen */
      .header-indicator {
        position: relative;
      }
      .header-indicator::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(
          120deg,
          transparent 0 40%,
          rgba(255, 255, 255, 0.18) 55%,
          transparent 70%
        );
        mix-blend-mode: screen;
        animation: sheen-move 5.2s linear infinite;
        opacity: 0.55;
        pointer-events: none;
      }
      @keyframes sheen-move {
        0% {
          transform: translateX(-40%);
        }
        100% {
          transform: translateX(40%);
        }
      }
      /* Safety: prevent hover scale from creating horizontal overflow on ultra-wide */
      .section-card {
        max-width: 100%;
      }
      .section-card:hover {
        overflow: hidden;
      }
      #main-content {
        overflow-x: hidden;
      }
      @media (prefers-reduced-motion: reduce) {
        .wave-group,
        .wave-path,
        .wave-svg,
        .header-indicator::after {
          animation: none !important;
          filter: none !important;
        }
      }
      /* =============================================================== */
      /* ================= MINIMAL 90s CYBER HEADER ===================== */
      .neo-header {
        position: relative;
        border-bottom: 1px solid rgba(255, 255, 255, 0.12);
        background: linear-gradient(180deg, rgba(15, 23, 42, 0.78), rgba(15, 23, 42, 0.55));
        backdrop-filter: blur(10px);
        box-shadow: 0 2px 8px -4px rgba(0, 0, 0, 0.6);
      }
      .neo-header::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 2px;
        background: linear-gradient(90deg, #22d3ee, #6366f1, #ec4899, #22d3ee);
        background-size: 180% 100%;
        animation: nhBar 18s linear infinite;
        opacity: 0.55;
      }
      .nh-inner-only-pills {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0.5rem 1.2rem;
        display: flex;
        justify-content: flex-end;
        align-items: center;
      }
      .nh-status {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
      }
      .pill {
        font-size: 0.6rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        padding: 0.35rem 0.55rem;
        border: 1px solid rgba(255, 255, 255, 0.18);
        border-radius: 6px;
        background: linear-gradient(145deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02));
        color: #e2e8f0;
        position: relative;
      }
      .pill.ok {
        color: #10e7a6;
        text-shadow: 0 0 6px rgba(16, 231, 166, 0.6);
      }
      .pill.time {
        color: #ec4899;
        text-shadow: 0 0 6px rgba(236, 72, 153, 0.5);
      }
      .pill::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(120deg, transparent, rgba(255, 255, 255, 0.15), transparent);
        opacity: 0;
        transition: 0.6s;
      }
      .pill:hover::before {
        opacity: 1;
      }
      @keyframes nhBar {
        0% {
          background-position: 0 0;
        }
        100% {
          background-position: 180% 0;
        }
      }
      @media (max-width: 780px) {
        .nh-status {
          width: 100%;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .neo-header::after {
          animation: none !important;
        }
      }
      /* =============================================================== */
      /* ===================== GLOBAL MESH BACKGROUND (layered fixed bg) ================== */
      .main-scroll {
        position: relative;
        z-index: 0;
        /* Slightly darker base; toned-down mesh alphas */
        /* Increased glow alphas for better visibility on dark base */
        background-image:
          linear-gradient(140deg, #151022 0%, #110d1c 55%, #0c0915 85%, #07050f 100%),
          radial-gradient(circle at 15% 25%, rgba(236, 72, 153, 0.22), transparent 60%),
          radial-gradient(circle at 85% 72%, rgba(34, 211, 238, 0.2), transparent 65%),
          radial-gradient(circle at 38% 82%, rgba(168, 85, 247, 0.18), transparent 65%),
          radial-gradient(circle at 72% 18%, rgba(14, 165, 233, 0.17), transparent 60%),
          /* grid lines */
            repeating-linear-gradient(
              90deg,
              rgba(255, 255, 255, 0.035) 0 2px,
              transparent 2px 120px
            ),
          repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.02) 0 2px, transparent 2px 90px);
        background-size:
          100% 100%,
          150% 150%,
          160% 160%,
          170% 170%,
          155% 155%,
          200% 100%,
          100% 200%;
        background-attachment: fixed, fixed, fixed, fixed, fixed, fixed, fixed;
        /* Static base now; dynamic motion handled by pseudo-elements */
        background-blend-mode: normal, screen, screen, screen, screen, overlay, overlay;
      }
      /* Hidden by default; shown in geek variant */
      .geek-code-rain {
        position: fixed;
        inset: 0;
        pointer-events: none;
        opacity: 0;
        mix-blend-mode: screen;
        z-index: 0;
        background: repeating-linear-gradient(
          180deg,
          rgba(0, 255, 170, 0) 0 52px,
          rgba(0, 255, 170, 0.25) 52px 53px,
          rgba(0, 255, 170, 0) 53px 104px
        );
        background-size: 180px 600px;
        animation: code-rain 24s linear infinite; /* slower for subtlety */
        filter: blur(1px) brightness(1.2) saturate(140%);
      }
      @keyframes code-rain {
        0% {
          background-position: 0 0;
        }
        100% {
          background-position: 0 600px;
        }
      }
      /* ================= Geek Variant Overrides ================= */
      body.theme-geek .geek-code-rain {
        opacity: 0.1;
      }
      body.theme-geek .main-scroll::before {
        background:
          radial-gradient(
            circle at 18% 32%,
            rgba(236, 72, 153, 0.55) 0%,
            rgba(236, 72, 153, 0) 42%
          ),
          radial-gradient(
            circle at 80% 68%,
            rgba(34, 211, 238, 0.55) 0%,
            rgba(34, 211, 238, 0) 44%
          ),
          radial-gradient(circle at 44% 78%, rgba(168, 85, 247, 0.5) 0%, rgba(168, 85, 247, 0) 46%),
          /* horizontal scan band */
            linear-gradient(
              180deg,
              rgba(255, 255, 255, 0) 0%,
              rgba(255, 255, 255, 0.08) 50%,
              rgba(255, 255, 255, 0) 100%
            ),
          /* hex-ish lattice using three angled line grids */
            repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.05) 0 1px, transparent 1px 42px),
          repeating-linear-gradient(60deg, rgba(255, 255, 255, 0.04) 0 1px, transparent 1px 48px),
          repeating-linear-gradient(120deg, rgba(255, 255, 255, 0.04) 0 1px, transparent 1px 48px);
        filter: blur(10px) saturate(135%) contrast(105%);
        /* Geek ON: stop animation (static background) */
        animation: none;
        opacity: 0.25; /* keep subtle glow */
      }
      body.theme-geek .main-scroll::after {
        background:
          conic-gradient(
            from 0deg at 50% 50%,
            rgba(0, 255, 170, 0.15),
            rgba(255, 255, 255, 0) 55%,
            rgba(0, 255, 170, 0.15)
          ),
          repeating-linear-gradient(180deg, rgba(255, 255, 255, 0.07) 0 1px, transparent 1px 5px);
        animation: none;
        opacity: 0.16;
        mix-blend-mode: screen;
      }
      body.theme-geek .pill.ok {
        color: #00ffb0;
        text-shadow: 0 0 6px rgba(0, 255, 176, 0.7);
      }
      body.theme-geek .pill.time {
        color: #a855f7;
        text-shadow: 0 0 6px rgba(168, 85, 247, 0.6);
      }
      body.theme-geek .nav-link.active {
        box-shadow:
          0 0 22px -4px rgba(0, 255, 170, 0.4),
          0 0 40px -12px rgba(168, 85, 247, 0.35);
      }
      body.theme-geek .neo-header::after {
        background: linear-gradient(90deg, #00ffb0, #a855f7, #22d3ee, #00ffb0);
      }
      /* Reduced motion variant adjustments */
      @media (prefers-reduced-motion: reduce) {
        body.theme-geek .main-scroll::before,
        body.theme-geek .main-scroll::after,
        body.theme-geek .geek-code-rain {
          animation: none !important;
        }
      }
      /* New orbital node animation */
      /* Reverted: Orbital nodes + conic sweep */
      .main-scroll::before {
        content: '';
        position: fixed;
        inset: 0;
        pointer-events: none;
        background:
          radial-gradient(
            circle at 20% 30%,
            rgba(236, 72, 153, 0.55) 0%,
            rgba(236, 72, 153, 0) 38%
          ),
          radial-gradient(
            circle at 78% 65%,
            rgba(34, 211, 238, 0.55) 0%,
            rgba(34, 211, 238, 0) 40%
          ),
          radial-gradient(circle at 42% 78%, rgba(168, 85, 247, 0.5) 0%, rgba(168, 85, 247, 0) 42%),
          radial-gradient(
            circle at 68% 25%,
            rgba(14, 165, 233, 0.45) 0%,
            rgba(14, 165, 233, 0) 38%
          ),
          radial-gradient(
            circle at 35% 48%,
            rgba(236, 72, 153, 0.35) 0%,
            rgba(236, 72, 153, 0) 45%
          ),
          radial-gradient(circle at 60% 55%, rgba(34, 211, 238, 0.35) 0%, rgba(34, 211, 238, 0) 46%);
        mix-blend-mode: screen;
        filter: blur(12px) saturate(120%);
        animation: nodes-rotate 58s linear infinite; /* slightly faster */
        opacity: 0.2; /* further toned down */
        z-index: 0;
      }
      .main-scroll::after {
        content: '';
        position: fixed;
        inset: 0;
        pointer-events: none;
        background:
          conic-gradient(
            from 0deg at 50% 50%,
            rgba(255, 255, 255, 0.12),
            rgba(255, 255, 255, 0) 60%,
            rgba(255, 255, 255, 0.12)
          ),
          repeating-linear-gradient(180deg, rgba(255, 255, 255, 0.06) 0 1px, transparent 1px 5px);
        mix-blend-mode: overlay;
        animation: sweep-rotate 34s linear infinite; /* slightly faster */
        opacity: 0.12; /* further toned down */
        z-index: 0;
      }
      @keyframes nodes-rotate {
        0% {
          transform: rotate(0deg) scale(1);
        }
        25% {
          transform: rotate(90deg) scale(1.05);
        }
        50% {
          transform: rotate(180deg) scale(1);
        }
        75% {
          transform: rotate(270deg) scale(1.05);
        }
        100% {
          transform: rotate(360deg) scale(1);
        }
      }
      @keyframes sweep-rotate {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .main-scroll {
          animation: none !important;
        }
        .main-scroll::before,
        .main-scroll::after {
          animation: none !important;
          opacity: 0.22;
          filter: none;
        }
      }
      /* Large screen scaling */
      @media (min-width: 1600px) {
        html {
          font-size: 17px;
        }
        .nh-inner-only-pills {
          max-width: 1550px;
        }
        .section-card {
          padding: 2rem;
        }
      }
      @media (min-width: 1920px) {
        html {
          font-size: 18px;
        }
        .nh-inner-only-pills {
          max-width: 1750px;
        }
        .section-card {
          padding: 2.25rem;
        }
      }
      @media (min-width: 2300px) {
        html {
          font-size: 19px;
        }
        .nh-inner-only-pills {
          max-width: 1950px;
        }
        .section-card {
          padding: 2.5rem;
        }
      }
      @media (min-width: 2600px) {
        html {
          font-size: 20px;
        }
        .nh-inner-only-pills {
          max-width: 2100px;
        }
        .section-card {
          padding: 2.75rem;
        }
      }
      /* =============================================================== */
      /* =============================================================== */
      @media (prefers-reduced-motion: reduce) {
        .wave-path {
          animation: none !important;
        }
      }
    </style>
    <script>
      function updateTime() {
        const now = new Date();
        const t = now.toLocaleTimeString('ja-JP', {
          hour12: false,
          hour: '2-digit',
          minute: '2-digit',
        });
        const el = document.getElementById('current-time');
        if (el) el.textContent = t;
      }
      function updateActiveNav() {
        const p = window.location.pathname;
        document.querySelectorAll('.nav-link').forEach(a => {
          a.classList.remove('active');
          if (a.getAttribute('href') === p) a.classList.add('active');
        });
      }
      function createParticles() {
        const container = document.querySelector('.fixed.inset-0');
        if (!container) return;
        for (let i = 0; i < 4; i++) {
          setTimeout(() => {
            const d = document.createElement('div');
            d.className = 'absolute w-1 h-1 bg-accent-cyan rounded-full opacity-60 animate-ping';
            d.style.left = Math.random() * 100 + '%';
            d.style.top = Math.random() * 100 + '%';
            d.style.animationDelay = Math.random() * 2 + 's';
            container.appendChild(d);
            setTimeout(() => d.remove(), 4000);
          }, i * 900);
        }
      }
      function setupDeviceAdvisory() {
        const banner = document.getElementById('device-advisory');
        const closeBtn = document.getElementById('device-advisory-close');
        if (!banner) return;
        const mqDesktop = window.matchMedia('(min-width: 1024px)');
        function refreshVisibility() {
          if (!banner) return;
          if (mqDesktop.matches || localStorage.getItem('hideDeviceAdvisory') === '1') {
            banner.style.display = 'none';
          } else {
            banner.style.display = 'flex';
          }
        }
        refreshVisibility();
        mqDesktop.addEventListener('change', refreshVisibility);
        closeBtn?.addEventListener('click', () => {
          localStorage.setItem('hideDeviceAdvisory', '1');
          refreshVisibility();
        });
      }
      document.addEventListener('DOMContentLoaded', () => {
        updateTime();
        updateActiveNav();
        createParticles();
        setupDeviceAdvisory();
        setInterval(updateTime, 1000 * 30);
      });
      document.addEventListener('astro:page-load', updateActiveNav);
    </script>
  </body>
</html>
