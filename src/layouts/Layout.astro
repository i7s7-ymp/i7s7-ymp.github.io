---
export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Geek Portfolio - i7s7-ymp' } = Astro.props;
---

<!doctype html>
<html lang="ja" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- フォント読み込み -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="h-screen overflow-hidden bg-gray-900 font-mono text-green-400">
    <div class="flex h-screen">
      <!-- サイドバー -->
      <aside class="flex w-64 flex-col border-r border-green-400/30 bg-gray-800">
        <div class="border-b border-green-400/30 p-6">
          <h1 class="text-xl font-bold text-green-400">
            <span class="text-gray-400">$</span> i7s7-ymp
            <span class="animate-pulse">_</span>
          </h1>
          <p class="mt-1 text-sm text-gray-400">./portfolio.sh</p>
        </div>

        <nav class="flex-1 p-4">
          <ul class="space-y-2">
            <li>
              <a href="/" class="nav-link" data-page="home">
                <span class="text-gray-400">></span> home.md
              </a>
            </li>
            <li>
              <a href="/support" class="nav-link" data-page="support">
                <span class="text-gray-400">></span> architecture.yaml
              </a>
            </li>
            <li>
              <a href="/achievements" class="nav-link" data-page="achievements">
                <span class="text-gray-400">></span> achievements.json
              </a>
            </li>
            <li>
              <a href="/social" class="nav-link" data-page="social">
                <span class="text-gray-400">></span> social.links
              </a>
            </li>
            <li>
              <a href="/agent" class="nav-link" data-page="agent">
                <span class="text-gray-400">></span> agent.py
              </a>
            </li>
          </ul>
        </nav>

        <!-- ダークモードトグル -->
        <div class="border-t border-green-400/30 p-4">
          <button
            id="theme-toggle"
            class="w-full rounded p-2 text-left transition-colors hover:bg-gray-700"
          >
            <span class="text-gray-400">></span> toggle_theme()
          </button>
        </div>

        <!-- システム情報 -->
        <div class="border-t border-green-400/30 p-4 text-xs text-gray-500">
          <div>uptime: <span id="uptime">0d 0h 0m</span></div>
          <div>mem: <span class="text-green-400">78%</span></div>
          <div>cpu: <span class="text-yellow-400">42%</span></div>
        </div>
      </aside>

      <!-- メインコンテンツ -->
      <main class="flex flex-1 flex-col overflow-hidden">
        <!-- ターミナルヘッダー -->
        <header
          class="flex items-center justify-between border-b border-green-400/30 bg-gray-800 p-3"
        >
          <div class="flex items-center space-x-2">
            <div class="h-3 w-3 rounded-full bg-red-500"></div>
            <div class="h-3 w-3 rounded-full bg-yellow-500"></div>
            <div class="h-3 w-3 rounded-full bg-green-500"></div>
            <span class="ml-4 text-sm text-gray-400">terminal@portfolio:~</span>
          </div>
          <div class="text-sm text-gray-400" id="current-time"></div>
        </header>

        <!-- ページコンテンツ -->
        <div class="flex-1 overflow-auto bg-gray-900 p-6">
          <slot />
        </div>
      </main>
    </div>

    <style>
      .nav-link {
        @apply block w-full rounded p-2 text-left text-green-400 transition-colors hover:bg-gray-700;
      }

      .nav-link.active {
        @apply bg-gray-700 text-green-300;
      }

      /* カスタムスクロールバー */
      ::-webkit-scrollbar {
        width: 8px;
      }

      ::-webkit-scrollbar-track {
        @apply bg-gray-800;
      }

      ::-webkit-scrollbar-thumb {
        @apply rounded bg-green-400/30;
      }

      ::-webkit-scrollbar-thumb:hover {
        @apply bg-green-400/50;
      }
    </style>

    <script>
      // 現在時刻の更新
      function updateTime() {
        const now = new Date();
        const timeString = now.toLocaleTimeString('ja-JP', { hour12: false });
        const timeElement = document.getElementById('current-time');
        if (timeElement) {
          timeElement.textContent = timeString;
        }
      }

      // アップタイムの更新
      const startTime = Date.now();
      function updateUptime() {
        const elapsed = Date.now() - startTime;
        const days = Math.floor(elapsed / (1000 * 60 * 60 * 24));
        const hours = Math.floor((elapsed % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((elapsed % (1000 * 60 * 60)) / (1000 * 60));
        const uptimeElement = document.getElementById('uptime');
        if (uptimeElement) {
          uptimeElement.textContent = `${days}d ${hours}h ${minutes}m`;
        }
      }

      // ナビゲーションのアクティブ状態
      function updateActiveNav() {
        const currentPath = window.location.pathname;
        document.querySelectorAll('.nav-link').forEach(link => {
          link.classList.remove('active');
          if (link.getAttribute('href') === currentPath) {
            link.classList.add('active');
          }
        });
      }

      // テーマトグル
      function toggleTheme() {
        const html = document.documentElement;
        if (html.classList.contains('dark')) {
          html.classList.remove('dark');
          html.classList.add('light');
        } else {
          html.classList.remove('light');
          html.classList.add('dark');
        }
      }

      // イベントリスナー
      document.addEventListener('DOMContentLoaded', () => {
        updateTime();
        updateUptime();
        updateActiveNav();

        setInterval(updateTime, 1000);
        setInterval(updateUptime, 60000);

        const themeToggle = document.getElementById('theme-toggle');
        if (themeToggle) {
          themeToggle.addEventListener('click', toggleTheme);
        }
      });

      // ページ遷移時のアクティブ状態更新
      document.addEventListener('astro:page-load', updateActiveNav);
    </script>
  </body>
</html>
