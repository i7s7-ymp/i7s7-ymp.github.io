---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
// @ts-ignore
import data from '../data/achievements.yml';

// 年単位にグルーピング（period の最初の4桁を年とみなす）
const timelineByYear: Record<string, any[]> = data.timeline.reduce(
  (acc: Record<string, any[]>, item: any) => {
    const m = (item.period || '').match(/\d{4}/);
    const year = m ? m[0] : 'その他';
    (acc[year] = acc[year] || []).push(item);
    return acc;
  },
  {}
);
// 表示対象年を固定（空年も見出しを出したい場合はこちらに列挙）
const displayYears: string[] = ['2025', '2024', '2023', '2022', '2021', '2020', '2019'];
// REFACTOR-STAGE2: displayYears と timelineByYear の同期ロジック（空年の扱い）を utility 化予定
---

<Layout
  title="実績 - i7s7-ymp Portfolio"
  headerTitle="achievements:timeline"
  headerPills={['build:ok']}
>
  <div class="space-y-10">
    <PageHeader
      title={data.header.title}
      subtitle={data.header.subtitle}
      icon="🏆"
      iconBgClass="bg-gradient-to-r from-accent-gold to-accent-pink"
    >
      {
        Array.isArray(data.header.tags) && data.header.tags.length > 0 && (
          <div slot="extra" class="flex flex-wrap gap-2 text-xs">
            {data.header.tags.map((t: string) => (
              <span class="badge-pill">{t}</span>
            ))}
          </div>
        )
      }
    </PageHeader>

    <!-- 職歴・経験タイムライン -->
    <div class="section-card">
      <div class="mb-4 flex items-center justify-between gap-4">
        <h3 class="gradient-heading-sm flex items-center space-x-2 text-lg font-semibold">
          <span class="text-accent-cyan">職務経歴</span>
        </h3>
        <div class="flex items-center gap-4 text-[11px] text-primary-400/60">
          <span class="hidden md:inline">年マーカーにホバー / フォーカスで詳細</span>
        </div>
      </div>
      <div class="relative" aria-label="2019-2025 タイムライン (選択式)">
        <div
          class="absolute left-0 right-0 top-1/2 h-px -translate-y-1/2 bg-gradient-to-r from-primary-500/30 via-primary-500/20 to-primary-500/30"
        >
        </div>
        <ol
          id="yearMarkers"
          class="year-markers-condensed relative flex justify-center gap-16 py-10"
        >
          {
            displayYears.map(year => {
              const items = timelineByYear[year] || [];
              return (
                <li
                  class={`year-node relative flex flex-col items-center ${year === '2025' ? 'is-active' : ''}`}
                  data-year={year}
                  tabindex="0"
                  role="button"
                  aria-pressed={year === '2025' ? 'true' : 'false'}
                >
                  <div class="relative z-10 flex flex-col items-center">
                    <div class="year-dot mb-2 h-4 w-4 rounded-full bg-accent-gold shadow-[0_0_0_4px_rgba(255,215,0,0.15)] ring-2 ring-accent-gold/40 transition" />
                    <span class="year-label font-mono text-[11px] tracking-wide text-primary-300 transition">
                      {year}
                    </span>
                    <span class="mt-1 text-[10px] text-primary-500/50" data-count>
                      {items.length || 0}件
                    </span>
                  </div>
                </li>
              );
            })
          }
        </ol>
        <div id="yearDetails" class="relative mt-4">
          {
            displayYears.map(year => {
              const items = timelineByYear[year] || [];
              return (
                <section
                  data-year-panel={year}
                  class={`year-panel ${year === '2025' ? '' : 'hidden'} rounded-xl border border-primary-500/30 bg-dark-900/80 p-5 shadow-lg ring-1 ring-primary-500/20 backdrop-blur-sm`}
                  aria-hidden={year === '2025' ? 'false' : 'true'}
                >
                  <header class="mb-4 flex items-center justify-between gap-4">
                    <div class="flex items-center gap-3">
                      <span class="inline-flex items-center rounded bg-primary-500/10 px-3 py-1 font-mono text-[11px] tracking-wide text-accent-gold/80 ring-1 ring-primary-500/30">
                        {year}
                      </span>
                      <h4 class="text-sm font-semibold text-primary-100">{year} の実績</h4>
                      <span class="text-[11px] text-primary-400/60">{items.length || 0}件</span>
                    </div>
                  </header>
                  {items.length === 0 && <p class="text-[12px] text-primary-500/60">記録なし</p>}
                  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                    {items.map((item: any, idx: number) => (
                      <article class="rounded-lg border border-primary-500/15 bg-dark-800/60 p-3 transition hover:border-primary-400/40">
                        <h5 class="mb-1 line-clamp-2 text-[13px] font-semibold leading-snug text-primary-50">
                          {idx + 1}. {item.role}
                        </h5>
                        <p class={`mb-1 font-mono text-[10px] text-accent-${item.color}/70`}>
                          {item.company} / {item.period}
                        </p>
                        <ul class="space-y-1 text-[11px] leading-snug text-primary-200">
                          {item.points.slice(0, 5).map((p: string) => (
                            <li class="flex items-start gap-1.5">
                              <span class={`mt-[3px] text-accent-${item.color}`}>▹</span>
                              <span class="min-w-0 flex-1">{p}</span>
                            </li>
                          ))}
                          {item.points.length > 5 && (
                            <li class="text-[10px] italic text-primary-400/60">
                              ...他 {item.points.length - 5} 件
                            </li>
                          )}
                        </ul>
                        {item.badges?.length && (
                          <div class="mt-2 flex flex-wrap gap-1">
                            {item.badges.slice(0, 8).map((b: string) => (
                              <span class="badge-pill text-[9px]">{b}</span>
                            ))}
                            {item.badges.length > 8 && (
                              <span class="badge-pill text-[9px]">+{item.badges.length - 8}</span>
                            )}
                          </div>
                        )}
                      </article>
                    ))}
                  </div>
                </section>
              );
            })
          }
        </div>
      </div>
    </div>

    <!-- 資格・認定 -->
    <div class="section-card">
      <h3 class="gradient-heading-sm mb-3 flex items-center space-x-2 text-lg font-semibold">
        <span class="text-accent-cyan">資格・認定</span>
      </h3>
      <ul class="grid grid-cols-1 gap-3 md:grid-cols-2" aria-label="資格・認定一覧">
        {
          data.certifications.map((c: any) => (
            <li class="flex items-center gap-3 rounded-lg border border-primary-500/20 bg-dark-900/50 p-3">
              <div
                class={`flex h-11 w-11 items-center justify-center rounded-md bg-${c.color}-400/15 ring-1 ring-${c.color}-400/30`}
              >
                <span class={`text-sm font-bold tracking-wide text-${c.color}-300`}>{c.code}</span>
              </div>
              <div class="min-w-0">
                <p class="truncate font-medium text-primary-100">{c.title}</p>
                <p class="text-xs text-primary-300/70">{c.level}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Layout>

<script is:inline>
  /* eslint-disable no-console */
  // util (inline 化して import 依存排除)
  function computeAndLockPanelHeights(panels) {
    if (!panels.length) return;
    const states = panels.map(p => p.classList.contains('hidden'));
    panels.forEach(p => p.classList.remove('hidden'));
    let max = 0;
    panels.forEach(p => {
      const h = p.scrollHeight;
      if (h > max) max = h;
    });
    panels.forEach((p, i) => {
      if (states[i]) p.classList.add('hidden');
      p.style.minHeight = max + 'px';
    });
  }
  function attachResponsiveRecalc(panels, delay = 180) {
    let t;
    window.addEventListener('resize', () => {
      if (t) clearTimeout(t);
      t = setTimeout(() => computeAndLockPanelHeights(panels), delay);
    });
  }

  (function initTimeline() {
    let attempt = 0;
    function tryInit() {
      attempt++;
      const markers = [...document.querySelectorAll('.year-node')];
      const panels = [...document.querySelectorAll('[data-year-panel]')];
      if (!markers.length || !panels.length) {
        if (attempt < 10) {
          console.log('[timeline] retry init attempt', attempt);
          return setTimeout(tryInit, 50 * attempt);
        }
        console.warn('[timeline] init failed: no markers/panels');
        return;
      }
      console.log('[timeline] init ok markers', markers.length, 'panels', panels.length);
      function selectYear(year) {
        if (!year) return;
        let activeEl = null;
        markers.forEach(m => {
          const active = m.getAttribute('data-year') === year;
          m.classList.toggle('is-active', active);
          m.setAttribute('aria-pressed', active ? 'true' : 'false');
          if (active) activeEl = m;
        });
        panels.forEach(p => {
          const active = p.getAttribute('data-year-panel') === year;
          p.classList.toggle('hidden', !active);
          p.setAttribute('aria-hidden', active ? 'false' : 'true');
          if (active) p.style.removeProperty('display');
          else p.style.display = 'none';
        });
        if (activeEl) {
          activeEl.classList.remove('activating');
          void activeEl.offsetWidth;
          activeEl.classList.add('activating');
          activeEl.addEventListener('animationend', () => activeEl.classList.remove('activating'), {
            once: true,
          });
        }
        requestAnimationFrame(() => computeAndLockPanelHeights(panels));
        console.log('[timeline] selectYear', year);
      }
      // expose for debugging
      window.__selectYear = selectYear;
      markers.forEach(m => {
        m.addEventListener('click', () => selectYear(m.getAttribute('data-year')));
        m.addEventListener('keydown', e => {
          const i = markers.indexOf(m);
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            selectYear(m.getAttribute('data-year'));
          } else if (e.key === 'ArrowRight') {
            e.preventDefault();
            markers[(i + 1) % markers.length].focus();
          } else if (e.key === 'ArrowLeft') {
            e.preventDefault();
            markers[(i - 1 + markers.length) % markers.length].focus();
          } else if (e.key === 'Home') {
            e.preventDefault();
            markers[0].focus();
          } else if (e.key === 'End') {
            e.preventDefault();
            markers[markers.length - 1].focus();
          }
        });
      });
      computeAndLockPanelHeights(panels);
      attachResponsiveRecalc(panels, 160);
      window.addEventListener('orientationchange', () => computeAndLockPanelHeights(panels));
      selectYear('2025');
      console.log('[timeline] ready');
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', tryInit);
    } else {
      tryInit();
    }
    document.addEventListener('astro:page-load', tryInit);
  })();
  /* eslint-enable no-console */
</script>

<style>
  /* line clamp helper */
  .line-clamp {
    max-height: 2.4em;
    overflow: hidden;
    position: relative;
  }
  .line-clamp::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(17, 17, 25, 0) 40%, rgba(17, 17, 25, 0.9) 95%);
    pointer-events: none;
  }

  /* Timeline Neo-Geek Theme */
  :root {
    --yr-active: #34d399;
    --yr-active-accent: #10b981;
    --yr-inactive: #64748b;
  }
  .year-node {
    --_scale: 0.82;
  }
  .year-node:focus-visible .year-dot {
    outline: 2px solid var(--yr-active);
    outline-offset: 3px;
  }
  .year-node .year-dot {
    position: relative;
  }
  .year-node .year-dot::before,
  .year-node .year-dot::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
  }
  .year-node .year-dot::before {
    background: radial-gradient(var(--yr-active) 8%, transparent 68%);
    filter: blur(5px);
    transition: opacity 0.45s;
  }
  .year-node .year-dot::after {
    border: 2px dashed var(--yr-active);
    animation: timeline-spin 14s linear infinite;
    transition: opacity 0.55s;
    mix-blend-mode: screen;
  }
  .year-node:hover .year-dot::before,
  .year-node:hover .year-dot::after,
  .year-node:focus-visible .year-dot::before,
  .year-node:focus-visible .year-dot::after {
    opacity: 0.35;
  }

  /* Active marker */
  .year-node.is-active {
    --_scale: 1.38;
  }
  .year-node.is-active .year-dot {
    background: linear-gradient(135deg, var(--yr-active) 15%, var(--yr-active-accent) 85%);
    box-shadow: var(
      --shadow-year-active,
      0 0 0 3px rgba(52, 211, 153, 0.25),
      0 0 12px 5px rgba(52, 211, 153, 0.4),
      0 0 32px 14px rgba(52, 211, 153, 0.15)
    );
    transform: scale(var(--_scale));
    animation: timeline-pulse 2.4s ease-in-out infinite;
  }
  .year-node.is-active .year-dot::before {
    opacity: 0.95;
    filter: blur(11px);
  }
  .year-node.is-active .year-dot::after {
    opacity: 0.55;
    animation: timeline-spin 7s linear infinite reverse;
    border-color: var(--yr-active-accent);
  }
  .year-node.is-active .year-label {
    color: var(--yr-active);
    font-weight: 700;
    letter-spacing: 0.07em;
    text-shadow:
      0 0 4px rgba(52, 211, 153, 0.6),
      0 0 18px rgba(16, 185, 129, 0.35);
    position: relative;
  }
  .year-node.is-active .year-label::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 3px;
    background:
      linear-gradient(
        90deg,
        transparent,
        var(--yr-active) 15%,
        var(--yr-active-accent) 50%,
        var(--yr-active) 85%,
        transparent
      ),
      linear-gradient(90deg, transparent 40%, rgba(255, 255, 255, 0.4) 50%, transparent 60%);
    background-size:
      100% 100%,
      200% 100%;
    animation: timeline-scan 3.6s linear infinite;
    border-radius: 2px;
    filter: drop-shadow(0 0 4px rgba(52, 211, 153, 0.55));
  }

  /* Inactive markers */
  .year-node .year-dot {
    transition:
      transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1),
      filter 0.5s,
      background 0.5s,
      box-shadow 0.5s;
    transform: scale(var(--_scale));
  }
  .year-node:not(.is-active) .year-dot {
    background: linear-gradient(135deg, #475569, #2e3a48);
    box-shadow: var(
      --shadow-year-inactive,
      0 0 0 2px rgba(128, 144, 168, 0.28),
      0 0 6px 0 rgba(20, 28, 42, 0.55),
      0 0 10px -2px rgba(128, 144, 168, 0.35)
    );
    filter: grayscale(0.35) brightness(0.98) saturate(0.85) contrast(1.05);
  }
  .year-node:not(.is-active):hover .year-dot,
  .year-node:not(.is-active):focus-visible .year-dot {
    filter: grayscale(0.08) brightness(1.08) saturate(0.95) contrast(1.1);
    transform: scale(0.95);
    box-shadow:
      0 0 0 2px rgba(150, 166, 188, 0.5),
      0 0 14px 3px rgba(128, 144, 168, 0.4),
      0 0 22px 6px rgba(30, 46, 64, 0.45);
  }
  .year-node:not(.is-active) .year-label {
    color: rgba(176, 190, 205, 0.72);
    font-weight: 600;
    letter-spacing: 0.025em;
    text-shadow: 0 0 2px rgba(120, 136, 160, 0.4);
    transition:
      color 0.4s,
      text-shadow 0.45s,
      letter-spacing 0.45s;
  }
  .year-node:not(.is-active):hover .year-label,
  .year-node:not(.is-active):focus-visible .year-label {
    color: rgba(222, 228, 235, 0.92);
    text-shadow: 0 0 5px rgba(170, 185, 205, 0.55);
    letter-spacing: 0.06em;
  }
  .year-node:not(.is-active) [data-count] {
    opacity: 0.42;
    transition:
      opacity 0.35s,
      filter 0.4s;
  }
  .year-node:not(.is-active):hover [data-count],
  .year-node:not(.is-active):focus-visible [data-count] {
    opacity: 0.7;
    filter: brightness(1.05);
  }

  /* Activation pop */
  .year-node.activating .year-dot {
    animation:
      timeline-popIn 0.42s cubic-bezier(0.45, 1.7, 0.6, 1) forwards,
      timeline-pulse 2.4s ease-in-out infinite 0.42s;
  }
  @keyframes timeline-popIn {
    0% {
      transform: scale(0.4);
      filter: brightness(0.7) saturate(0.6);
    }
    60% {
      transform: scale(1.6);
      filter: brightness(1.3) saturate(1.4);
    }
    100% {
      transform: scale(var(--_scale));
      filter: brightness(1) saturate(1);
    }
  }
  @keyframes timeline-pulse {
    0%,
    100% {
      box-shadow:
        0 0 0 3px rgba(52, 211, 153, 0.25),
        0 0 12px 5px rgba(52, 211, 153, 0.4),
        0 0 32px 14px rgba(52, 211, 153, 0.15);
    }
    45% {
      box-shadow:
        0 0 0 3px rgba(52, 211, 153, 0.35),
        0 0 18px 8px rgba(52, 211, 153, 0.55),
        0 0 40px 18px rgba(52, 211, 153, 0.22);
    }
  }
  @keyframes timeline-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes timeline-scan {
    to {
      background-position:
        0 0,
        -200% 0;
    }
  }

  /* Panel fade */
  .year-panel {
    animation: timeline-panelFade 0.45s ease;
  }
  @keyframes timeline-panelFade {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .year-node .year-dot,
    .year-node .year-dot::after,
    .year-node.is-active .year-dot {
      animation: none !important;
    }
    .year-node.is-active .year-label::after {
      animation: none !important;
    }
  }

  /* Timeline color and gap adjustments */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--tl-marker-gap-desktop, 4rem);
  }
  @media (max-width: 1024px) {
    .timeline {
      gap: var(--tl-marker-gap-md, 3.25rem);
    }
  }
  @media (max-width: 640px) {
    .timeline {
      gap: var(--tl-marker-gap-sm, 2.6rem);
    }
  }
  .tl-item {
    position: relative;
  }
  .tl-marker {
    position: absolute;
    left: -2.4rem;
    top: 0.35rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--tl-inactive, #64748b);
    box-shadow:
      0 0 0 3px rgba(255, 255, 255, 0.07),
      0 0 0 6px rgba(100, 116, 139, 0.15);
    transition:
      background 0.35s,
      box-shadow 0.35s,
      transform 0.35s;
  }
  .tl-item.active .tl-marker {
    background: var(--tl-active, #34d399);
    box-shadow:
      0 0 0 3px rgba(255, 255, 255, 0.14),
      0 0 12px -2px rgba(52, 211, 153, 0.75);
    transform: scale(1.08);
  }
  .tl-line {
    position: absolute;
    left: -1.67rem;
    top: 1.65rem;
    bottom: -2.8rem;
    width: 2px;
    background: linear-gradient(
      var(--tl-line-angle, 180deg),
      rgba(255, 255, 255, 0.18),
      rgba(255, 255, 255, 0)
    );
    opacity: 0.65;
  }
  .tl-item:last-child .tl-line {
    display: none;
  }
  .tl-panel {
    position: relative;
    padding: 1.15rem 1.2rem 1.2rem 1.2rem;
    background: rgba(15, 23, 42, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 16px;
    backdrop-filter: blur(6px) saturate(120%);
    box-shadow:
      0 3px 10px -4px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(255, 255, 255, 0.04);
    transition:
      box-shadow 0.35s,
      border-color 0.35s,
      background 0.35s;
  }
  .tl-item.active .tl-panel {
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow:
      0 4px 16px -6px rgba(0, 0, 0, 0.65),
      0 0 0 1px rgba(255, 255, 255, 0.05),
      0 0 20px -8px rgba(52, 211, 153, 0.5);
  }
  .tl-heading {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    flex-wrap: wrap;
  }
  .tl-year {
    font-weight: 700;
    font-size: 1.35rem;
    letter-spacing: 0.5px;
    background: linear-gradient(
      135deg,
      var(--tl-active, #34d399),
      var(--tl-active-accent, #10b981)
    );
    -webkit-background-clip: text;
    color: transparent;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
  }
  .tl-title {
    font-weight: 600;
    color: #e2e8f0;
    letter-spacing: 0.5px;
  }
  .tl-desc {
    margin-top: 0.45rem;
    font-size: 0.88rem;
    line-height: 1.55;
    color: #b6c2d3;
  }
  .tl-tags {
    margin-top: 0.7rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .tl-tag {
    font-size: 0.6rem;
    letter-spacing: 0.6px;
    padding: 2px 7px 2px 6px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.15), rgba(255, 255, 255, 0.05));
    font-weight: 600;
    color: #e2e8f0;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .tl-item.active .tl-tag.primary {
    border-color: rgba(255, 255, 255, 0.28);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.06),
      0 0 0 4px rgba(52, 211, 153, 0.15);
  }
  @media (max-width: 860px) {
    .tl-marker {
      left: -2.1rem;
    }
    .tl-line {
      left: -1.38rem;
    }
  }
  @media (max-width: 640px) {
    .tl-marker {
      left: -1.9rem;
    }
    .tl-line {
      left: -1.16rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tl-marker,
    .tl-item.active .tl-marker {
      transition: none;
