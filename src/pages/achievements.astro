---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
// @ts-ignore
import data from '../data/achievements.yml';
---

<Layout title="実績 - i7s7-ymp Portfolio">
  <div class="space-y-10">
    <PageHeader
      title={data.header.title}
      subtitle={data.header.subtitle}
      icon="🏆"
      iconBgClass="bg-gradient-to-r from-accent-gold to-accent-pink"
    >
      <div slot="extra" class="flex flex-wrap gap-2 text-xs">
        {data.header.tags.map((t: string) => <span class="badge-pill">{t}</span>)}
      </div>
    </PageHeader>

    <!-- 職歴・経験（タイムライン形式） -->
    <div class="section-card">
      <h3 class="gradient-heading-sm mb-4 flex items-center space-x-2 text-lg font-semibold">
        <span class="text-accent-cyan">職務経歴</span>
      </h3>
      <ul class="relative space-y-6 border-l border-primary-500/30 pl-5">
        {
          data.timeline.map((item: any) => (
            <li class="group relative">
              <div
                class={`absolute -left-[9px] top-1 h-3 w-3 rounded-full bg-accent-${item.color} shadow-[0_0_0_3px_rgba(255,255,255,0.10)]`}
              />
              <h4 class="font-semibold leading-tight text-white">{item.role}</h4>
              <p class={`font-mono text-xs text-accent-${item.color}/80`}>
                {item.company} / {item.period}
              </p>
              <ul class="mt-2 space-y-1 text-sm text-primary-200">
                {item.points.map((p: string) => (
                  <li class="flex items-start gap-2">
                    <span class={`text-accent-${item.color}`}>▸</span>
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
              <div class="mt-2 flex flex-wrap gap-1.5">
                {item.badges.map((b: string) => (
                  <span class="badge-pill text-xs">{b}</span>
                ))}
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- 技術的成果（スキャン可能な短文化リスト） -->
    <div class="section-card">
      <h3 class="gradient-heading-sm mb-3 flex items-center space-x-2 text-lg font-semibold">
        <span class="text-accent-cyan">技術的成果</span>
      </h3>
      <ul class="grid grid-cols-1 gap-2 text-sm md:grid-cols-2" aria-label="主な技術的成果">
        {
          data.achievements.map((a: any) => (
            <li class="flex items-start gap-2 rounded border border-primary-500/20 bg-dark-900/40 p-3">
              <span class="mt-0.5 text-accent-cyan">✔</span>
              <div>
                <p class="font-medium text-primary-100">{a.title}</p>
                <p class="text-primary-300/80">{a.desc}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- 資格・認定 -->
    <div class="section-card">
      <h3 class="gradient-heading-sm mb-3 flex items-center space-x-2 text-lg font-semibold">
        <span class="text-accent-cyan">資格・認定</span>
      </h3>
      <ul class="grid grid-cols-1 gap-3 md:grid-cols-2" aria-label="資格・認定一覧">
        {
          data.certifications.map((c: any) => (
            <li class="flex items-center gap-3 rounded-lg border border-primary-500/20 bg-dark-900/50 p-3">
              <div
                class={`flex h-11 w-11 items-center justify-center rounded-md bg-${c.color}-400/15 ring-1 ring-${c.color}-400/30`}
              >
                <span class={`text-sm font-bold tracking-wide text-${c.color}-300`}>{c.code}</span>
              </div>
              <div class="min-w-0">
                <p class="truncate font-medium text-primary-100">{c.title}</p>
                <p class="text-xs text-primary-300/70">{c.level}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Layout>
