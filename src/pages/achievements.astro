---
import Layout from '../layouts/Layout.astro';
import StatCard from '../components/StatCard.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Layout title="Achievements - i7s7-ymp Portfolio">
  <div class="space-y-10">
    <PageHeader
      title="Achievements & Experience"
      subtitle="Professional milestones and technical accomplishments"
      icon="🏆"
      iconBgClass="bg-gradient-to-r from-accent-gold to-accent-pink"
    >
      <div slot="extra" class="flex flex-wrap gap-2 text-xs">
        <span class="badge-pill">projects</span>
        <span class="badge-pill">experience</span>
        <span class="badge-pill">growth</span>
      </div>
    </PageHeader>

    <!-- 統計情報 -->
    <div class="stat-grid">
      <StatCard value="50+" label="Projects" />
      <StatCard value="3+" label="Years Exp." accentClass="text-accent-pink" />
      <StatCard value="15+" label="Technologies" accentClass="text-accent-cyan" />
      <StatCard value="100k+" label="Lines of Code" accentClass="text-accent-gold" />
    </div>

    <!-- 職歴・経験 -->
    <div class="section-card">
      <h3 class="gradient-heading-sm mb-4 flex items-center space-x-2 text-lg font-semibold">
        <span class="text-accent-cyan">&gt;</span><span>work_history.log</span>
      </h3>
      <div class="space-y-4">
        <div class="border-l-2 border-green-400/30 pl-4">
          <h4 class="font-semibold text-green-400">Senior Full Stack Developer</h4>
          <p class="text-sm text-yellow-400">Tech Startup Inc. • 2022 - Present</p>
          <p class="mt-2 text-sm text-gray-300">
            フルスタック開発チームのリード。React/Node.jsを使用したWebアプリケーションの設計・開発。
            CI/CDパイプラインの構築とDevOps環境の整備。
          </p>
          <div class="mt-2 flex flex-wrap gap-2">
            <span class="rounded bg-green-400/20 px-2 py-1 text-xs text-green-400">React</span>
            <span class="rounded bg-blue-400/20 px-2 py-1 text-xs text-blue-400">Node.js</span>
            <span class="rounded bg-purple-400/20 px-2 py-1 text-xs text-purple-400">AWS</span>
          </div>
        </div>

        <div class="border-l-2 border-green-400/30 pl-4">
          <h4 class="font-semibold text-green-400">Frontend Developer</h4>
          <p class="text-sm text-yellow-400">Digital Agency Ltd. • 2021 - 2022</p>
          <p class="mt-2 text-sm text-gray-300">
            企業向けWebサイトの開発。レスポンシブデザインの実装とパフォーマンス最適化。
            モダンなフロントエンド技術を活用したユーザーエクスペリエンスの向上。
          </p>
          <div class="mt-2 flex flex-wrap gap-2">
            <span class="rounded bg-yellow-400/20 px-2 py-1 text-xs text-yellow-400">Vue.js</span>
            <span class="rounded bg-cyan-400/20 px-2 py-1 text-xs text-cyan-400">Nuxt.js</span>
            <span class="rounded bg-pink-400/20 px-2 py-1 text-xs text-pink-400">SCSS</span>
          </div>
        </div>

        <div class="border-l-2 border-green-400/30 pl-4">
          <h4 class="font-semibold text-green-400">Junior Developer</h4>
          <p class="text-sm text-yellow-400">Software Solutions Co. • 2020 - 2021</p>
          <p class="mt-2 text-sm text-gray-300">
            Webアプリケーションの開発サポート。バグ修正と新機能の実装。
            コードレビューとテスト駆動開発の学習。
          </p>
          <div class="mt-2 flex flex-wrap gap-2">
            <span class="rounded bg-orange-400/20 px-2 py-1 text-xs text-orange-400"
              >JavaScript</span
            >
            <span class="rounded bg-red-400/20 px-2 py-1 text-xs text-red-400">PHP</span>
            <span class="rounded bg-teal-400/20 px-2 py-1 text-xs text-teal-400">MySQL</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 技術的成果 -->
    <div class="section-card">
      <h3 class="gradient-heading-sm mb-4 flex items-center space-x-2 text-lg font-semibold">
        <span class="text-accent-cyan">&gt;</span><span>technical_achievements --list</span>
      </h3>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        <div class="space-y-3">
          <div class="flex items-start space-x-3">
            <span class="mt-1 text-green-400">✓</span>
            <div>
              <h4 class="font-medium text-green-400">OSS Contribution</h4>
              <p class="text-sm text-gray-300">
                人気オープンソースプロジェクトへのコントリビューション
              </p>
            </div>
          </div>
          <div class="flex items-start space-x-3">
            <span class="mt-1 text-green-400">✓</span>
            <div>
              <h4 class="font-medium text-green-400">Performance Optimization</h4>
              <p class="text-sm text-gray-300">Webアプリケーションの読み込み速度を50%改善</p>
            </div>
          </div>
          <div class="flex items-start space-x-3">
            <span class="mt-1 text-green-400">✓</span>
            <div>
              <h4 class="font-medium text-green-400">Microservices Architecture</h4>
              <p class="text-sm text-gray-300">
                モノリスからマイクロサービスへの移行プロジェクトをリード
              </p>
            </div>
          </div>
        </div>
        <div class="space-y-3">
          <div class="flex items-start space-x-3">
            <span class="mt-1 text-green-400">✓</span>
            <div>
              <h4 class="font-medium text-green-400">CI/CD Pipeline</h4>
              <p class="text-sm text-gray-300">GitHub ActionsとAWSを活用した自動デプロイ環境構築</p>
            </div>
          </div>
          <div class="flex items-start space-x-3">
            <span class="mt-1 text-green-400">✓</span>
            <div>
              <h4 class="font-medium text-green-400">Team Leadership</h4>
              <p class="text-sm text-gray-300">5人の開発チームのテクニカルリーダーとして従事</p>
            </div>
          </div>
          <div class="flex items-start space-x-3">
            <span class="mt-1 text-green-400">✓</span>
            <div>
              <h4 class="font-medium text-green-400">Tech Conference Speaker</h4>
              <p class="text-sm text-gray-300">技術カンファレンスでの登壇経験</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 資格・認定 -->
    <div class="section-card">
      <h3 class="gradient-heading-sm mb-4 flex items-center space-x-2 text-lg font-semibold">
        <span class="text-accent-cyan">&gt;</span><span>certificates.list()</span>
      </h3>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        <div class="flex items-center space-x-3 rounded bg-gray-900/50 p-3">
          <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-orange-400/20">
            <span class="font-bold text-orange-400">AWS</span>
          </div>
          <div>
            <h4 class="font-medium text-green-400">AWS Certified Solutions Architect</h4>
            <p class="text-sm text-gray-400">Associate Level • 2023</p>
          </div>
        </div>
        <div class="flex items-center space-x-3 rounded bg-gray-900/50 p-3">
          <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-blue-400/20">
            <span class="font-bold text-blue-400">JS</span>
          </div>
          <div>
            <h4 class="font-medium text-green-400">JavaScript Developer Certification</h4>
            <p class="text-sm text-gray-400">Advanced Level • 2022</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
