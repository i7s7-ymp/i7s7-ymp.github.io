---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Layout title="Design System - i7s7-ymp Portfolio">
  <div class="space-y-8">
    <PageHeader
      title="Design System Guide"
      subtitle="Utilities, tokens & usage conventions"
      icon="🎨"
      iconBgClass="bg-gradient-to-r from-accent-pink to-accent-purple"
    >
      <div slot="extra" class="flex flex-wrap gap-2 text-xs">
        <span class="badge-pill">ui</span>
        <span class="badge-pill">consistency</span>
        <span class="badge-pill">reference</span>
      </div>
    </PageHeader>

    <!-- Core Containers -->
    <div class="section-card p-6">
      <h3 class="gradient-heading-sm mb-4 flex items-center space-x-2 text-lg font-semibold">
        <span class="text-accent-cyan">&gt;</span><span>Containers</span>
      </h3>
      <div class="grid gap-4 md:grid-cols-2">
        <div class="space-y-2">
          <h4 class="font-semibold text-accent-cyan">section-card</h4>
          <p class="text-sm text-primary-200">
            汎用セクション枠。グラデ背景 + border + blur + hover拡大。
          </p>
          <div class="section-card p-4">
            <p class="text-sm text-primary-200">Sample content inside section-card.</p>
          </div>
        </div>
        <div class="space-y-2">
          <h4 class="font-semibold text-accent-cyan">stat-card</h4>
          <p class="text-sm text-primary-200">KPI/数字用の小型カード。section-card継承。</p>
          <div class="stat-card">
            <h4>123</h4>
            <span>Example</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Typography -->
    <div class="section-card p-6">
      <h3 class="gradient-heading-sm mb-4 flex items-center space-x-2 text-lg font-semibold">
        <span class="text-accent-cyan">&gt;</span><span>Typography</span>
      </h3>
      <ul class="space-y-3 font-mono text-xs text-primary-300">
        <li><span class="text-accent-cyan">panel-title</span>: ページ/大見出し用グラデテキスト</li>
        <li><span class="text-accent-cyan">gradient-heading-sm</span>: 小見出し用グラデテキスト</li>
        <li><span class="text-accent-cyan">terminal-caption</span>: コマンド行風キャプション</li>
      </ul>
      <div class="mt-4 space-y-2">
        <h2 class="panel-title text-2xl">Panel Title Example</h2>
        <h3 class="gradient-heading-sm text-lg">Gradient Heading Small Example</h3>
        <div class="terminal-caption">
          <span class="text-accent-cyan">$</span><span> echo "hello"</span>
        </div>
      </div>
    </div>

    <!-- Badges -->
    <div class="section-card p-6">
      <h3 class="gradient-heading-sm mb-4 flex items-center space-x-2 text-lg font-semibold">
        <span class="text-accent-cyan">&gt;</span><span>Badges</span>
      </h3>
      <div class="badge-list">
        <span class="badge-pill">open source</span>
        <span class="badge-pill">cloud</span>
        <span class="badge-pill">frontend</span>
        <span class="badge-pill">ai/ml</span>
      </div>
      <p class="mt-4 text-sm text-primary-300">
        badge-pill: 丸型・半透明グラデ背景。hover で境界色強調。
      </p>
    </div>

    <!-- Scroll & Overflow -->
    <div class="section-card p-6">
      <h3 class="gradient-heading-sm mb-4 flex items-center space-x-2 text-lg font-semibold">
        <span class="text-accent-cyan">&gt;</span><span>Overflow / Scroll</span>
      </h3>
      <p class="text-sm text-primary-200">
        hide-scrollbar: スクロール機能は保持しつつ表示のみ非表示。
      </p>
      <div class="mt-3 grid gap-4 md:grid-cols-2">
        <div>
          <p class="mb-2 text-xs text-primary-300">通常スクロール</p>
          <div
            class="h-24 overflow-y-auto rounded border border-primary-600/30 p-2 text-xs text-primary-300"
          >
            {Array.from({ length: 12 }).map((_, i) => <div>Line {i + 1}</div>)}
          </div>
        </div>
        <div>
          <p class="mb-2 text-xs text-primary-300">hide-scrollbar</p>
          <div
            class="hide-scrollbar h-24 overflow-y-auto rounded border border-primary-600/30 p-2 text-xs text-primary-300"
          >
            {Array.from({ length: 12 }).map((_, i) => <div>Line {i + 1}</div>)}
          </div>
        </div>
      </div>
    </div>

    <!-- Color Tokens Reference -->
    <div class="section-card p-6">
      <h3 class="gradient-heading-sm mb-4 flex items-center space-x-2 text-lg font-semibold">
        <span class="text-accent-cyan">&gt;</span><span>Accent Palette</span>
      </h3>
      <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
        {
          ['pink', 'cyan', 'neon', 'gold', 'coral', 'blue', 'indigo', 'purple'].map(c => (
            <div class="space-y-2">
              <div class={`h-12 w-full rounded bg-accent-${c}/60`} />
              <p class="font-mono text-xs text-primary-300">accent-{c}</p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Usage Principles -->
    <div class="section-card p-6">
      <h3 class="gradient-heading-sm mb-4 flex items-center space-x-2 text-lg font-semibold">
        <span class="text-accent-cyan">&gt;</span><span>Principles</span>
      </h3>
      <ol class="list-decimal space-y-2 pl-5 text-sm text-primary-200">
        <li>再利用できるレイアウト枠は section-card / stat-card を優先</li>
        <li>色は Tailwind 拡張パレット (accent-*) を組み合わせて使用</li>
        <li>動的に付与するクラスは safelist へ登録</li>
        <li>不要になったクラスは速やかに削除し CSS バンドルを抑制</li>
        <li>アクセシビリティ: グラデテキストは十分なコントラスト背景上で使用</li>
      </ol>
    </div>
  </div>
</Layout>
