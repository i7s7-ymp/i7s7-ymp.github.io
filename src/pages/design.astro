---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Design - i7s7-ymp Portfolio">
  <div class="space-y-6">
    <!-- ページタイトル -->
    <div class="border border-green-400/30 rounded-lg bg-gray-800/50 p-4">
      <div class="text-green-400 mb-2">
        <span class="text-gray-400">$</span> ls -la design/
      </div>
      <h2 class="text-2xl font-bold text-green-400">
        # Design Portfolio
      </h2>
      <p class="text-gray-300 mt-2">
        > Creative projects and design experiments
      </p>
    </div>
    
    <!-- デザインプロジェクト -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- プロジェクト1 -->
      <div class="border border-green-400/30 rounded-lg bg-gray-800/50 p-4 hover:bg-gray-800/70 transition-colors cursor-pointer">
        <div class="mb-3">
          <h3 class="text-lg font-semibold text-green-400">
            <span class="text-gray-400">></span> modern_dashboard.vue
          </h3>
          <span class="text-xs text-yellow-400">Vue.js • Tailwind CSS</span>
        </div>
        <div class="bg-gray-900 rounded p-3 mb-3">
          <div class="w-full h-32 bg-gradient-to-br from-green-400/20 to-blue-400/20 rounded flex items-center justify-center">
            <span class="text-green-400 text-sm">Dashboard Preview</span>
          </div>
        </div>
        <p class="text-gray-300 text-sm">
          モダンなダッシュボードUIの設計と実装。レスポンシブデザインとダークモード対応。
        </p>
        <div class="mt-3 flex space-x-2">
          <span class="px-2 py-1 bg-green-400/20 text-green-400 rounded text-xs">UI/UX</span>
          <span class="px-2 py-1 bg-blue-400/20 text-blue-400 rounded text-xs">Frontend</span>
        </div>
      </div>
      
      <!-- プロジェクト2 -->
      <div class="border border-green-400/30 rounded-lg bg-gray-800/50 p-4 hover:bg-gray-800/70 transition-colors cursor-pointer">
        <div class="mb-3">
          <h3 class="text-lg font-semibold text-green-400">
            <span class="text-gray-400">></span> mobile_app.figma
          </h3>
          <span class="text-xs text-yellow-400">React Native • Figma</span>
        </div>
        <div class="bg-gray-900 rounded p-3 mb-3">
          <div class="w-full h-32 bg-gradient-to-br from-purple-400/20 to-pink-400/20 rounded flex items-center justify-center">
            <span class="text-purple-400 text-sm">Mobile App Design</span>
          </div>
        </div>
        <p class="text-gray-300 text-sm">
          モバイルアプリのプロトタイプデザイン。ユーザビリティを重視したインターフェース設計。
        </p>
        <div class="mt-3 flex space-x-2">
          <span class="px-2 py-1 bg-purple-400/20 text-purple-400 rounded text-xs">Mobile</span>
          <span class="px-2 py-1 bg-pink-400/20 text-pink-400 rounded text-xs">Prototype</span>
        </div>
      </div>
      
      <!-- プロジェクト3 -->
      <div class="border border-green-400/30 rounded-lg bg-gray-800/50 p-4 hover:bg-gray-800/70 transition-colors cursor-pointer">
        <div class="mb-3">
          <h3 class="text-lg font-semibold text-green-400">
            <span class="text-gray-400">></span> web_components.ts
          </h3>
          <span class="text-xs text-yellow-400">TypeScript • Web Components</span>
        </div>
        <div class="bg-gray-900 rounded p-3 mb-3">
          <div class="w-full h-32 bg-gradient-to-br from-yellow-400/20 to-orange-400/20 rounded flex items-center justify-center">
            <span class="text-yellow-400 text-sm">Component Library</span>
          </div>
        </div>
        <p class="text-gray-300 text-sm">
          再利用可能なWebコンポーネントライブラリの設計と開発。TypeScript完全対応。
        </p>
        <div class="mt-3 flex space-x-2">
          <span class="px-2 py-1 bg-yellow-400/20 text-yellow-400 rounded text-xs">Components</span>
          <span class="px-2 py-1 bg-orange-400/20 text-orange-400 rounded text-xs">TypeScript</span>
        </div>
      </div>
      
      <!-- プロジェクト4 -->
      <div class="border border-green-400/30 rounded-lg bg-gray-800/50 p-4 hover:bg-gray-800/70 transition-colors cursor-pointer">
        <div class="mb-3">
          <h3 class="text-lg font-semibold text-green-400">
            <span class="text-gray-400">></span> ai_interface.py
          </h3>
          <span class="text-xs text-yellow-400">Python • Streamlit</span>
        </div>
        <div class="bg-gray-900 rounded p-3 mb-3">
          <div class="w-full h-32 bg-gradient-to-br from-cyan-400/20 to-teal-400/20 rounded flex items-center justify-center">
            <span class="text-cyan-400 text-sm">AI Interface</span>
          </div>
        </div>
        <p class="text-gray-300 text-sm">
          AIとのインタラクション用インターフェース。機械学習モデルとの連携UI。
        </p>
        <div class="mt-3 flex space-x-2">
          <span class="px-2 py-1 bg-cyan-400/20 text-cyan-400 rounded text-xs">AI/ML</span>
          <span class="px-2 py-1 bg-teal-400/20 text-teal-400 rounded text-xs">Python</span>
        </div>
      </div>
    </div>
    
    <!-- デザインツール -->
    <div class="border border-green-400/30 rounded-lg bg-gray-800/50 p-4">
      <h3 class="text-lg font-semibold text-green-400 mb-3">
        <span class="text-gray-400">></span> design_tools --version
      </h3>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="text-center">
          <div class="w-12 h-12 bg-orange-400/20 rounded-lg flex items-center justify-center mx-auto mb-2">
            <span class="text-orange-400 font-bold">F</span>
          </div>
          <span class="text-gray-300 text-sm">Figma</span>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-purple-400/20 rounded-lg flex items-center justify-center mx-auto mb-2">
            <span class="text-purple-400 font-bold">Ai</span>
          </div>
          <span class="text-gray-300 text-sm">Illustrator</span>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-blue-400/20 rounded-lg flex items-center justify-center mx-auto mb-2">
            <span class="text-blue-400 font-bold">Ps</span>
          </div>
          <span class="text-gray-300 text-sm">Photoshop</span>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-green-400/20 rounded-lg flex items-center justify-center mx-auto mb-2">
            <span class="text-green-400 font-bold">SK</span>
          </div>
          <span class="text-gray-300 text-sm">Sketch</span>
        </div>
      </div>
    </div>
  </div>
</Layout>
