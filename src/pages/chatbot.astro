---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import '../styles/page-grid.css';
import chatbotYaml from '../data/chatbot.yml';
import type { ChatbotData } from '../types/content';

const chatbotData = chatbotYaml as ChatbotData;
---

{/* 元: chatbot.astro -> chatbot.astro */}
<Layout title="AI Chatbot - i7s7-ymp Portfolio" headerPills={['build:ok']}>
  <PageHeader
    title={chatbotData.header.title}
    subtitle={chatbotData.header.subtitle}
    icon={chatbotData.header.icon}
    iconBgClass={chatbotData.header.iconBgClass}
  />
  <div class="arch-page-grid">
    <section class="arch-block" aria-labelledby="chatbot-chat-heading">
      <h3 id="chatbot-chat-heading" class="sr-only">ChatBot</h3>
      <div id="chatbot-layout" class="chatbot-layout flex flex-col lg:flex-row lg:space-x-6">
        <div
          id="chat-container"
          class="flex min-h-0 flex-1 flex-col rounded-2xl border border-primary-600/30 bg-dark-900/80 shadow-2xl backdrop-blur-md"
        >
          <div
            id="chat-messages"
            class="min-h-0 flex-1 space-y-4 overflow-y-auto p-4"
            aria-live="polite"
          >
            <div class="flex items-start space-x-3">
              <div
                class="flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-r from-primary-500 to-accent-pink"
              >
                <span class="text-sm">{chatbotData.header.icon || '🤖'}</span>
              </div>
              <div class="flex-1">
                <div class="rounded-2xl bg-primary-600/20 p-3 backdrop-blur-sm">
                  <p class="text-white">
                    こんにちは！<br />
                    私は「山下 大輝(i7s7-ymp)」について学習したチャットボットです。<br />
                    右サイドのクイック質問、または下の入力欄から送信できます。<br />
                    初回の生成には時間がかかる場合があります。
                  </p>
                </div>
                <p class="mt-1 text-xs text-primary-400">now</p>
              </div>
            </div>
          </div>
          <div class="border-t border-primary-500/30 p-4">
            <div class="flex items-center space-x-3">
              <div class="relative flex-1">
                <input
                  type="text"
                  id="chat-input"
                  placeholder="メッセージを入力してください..."
                  value="経歴について教えてください。"
                  class="w-full rounded-xl border border-primary-500/30 bg-dark-800/50 px-4 py-3 text-white placeholder-primary-400 backdrop-blur-sm focus:border-primary-400 focus:outline-none focus:ring-2 focus:ring-primary-400/20"
                  autocomplete="off"
                />
              </div>
              <button
                id="send-btn"
                class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-r from-primary-500 to-accent-pink text-white transition-all hover:scale-105 hover:shadow-lg"
                aria-label="Send message"
              >
                <span class="text-xl">➤</span>
              </button>
            </div>
          </div>
        </div>
        <div class="mt-6 flex h-full w-full flex-shrink-0 flex-col space-y-4 lg:mt-0 lg:w-80">
          <div
            class="rounded-2xl border border-primary-500/30 bg-dark-900/80 p-6 shadow-2xl backdrop-blur-md"
            style="min-height:240px;"
          >
            <div class="flex h-full flex-col items-center justify-start text-center">
              <div class="relative mx-auto mb-4 h-24 w-24">
                <div
                  class="flex h-full w-full animate-glow items-center justify-center rounded-full bg-gradient-to-r from-primary-500 via-accent-pink to-accent-cyan shadow-lg"
                >
                  <span class="text-4xl" aria-hidden="true">{chatbotData.header.icon || '🤖'}</span>
                </div>
              </div>
              <h3 class="text-xl font-bold text-white">
                {chatbotData.model?.name || 'Chatbot Model'}
              </h3>
              <p class="mt-2 text-xs tracking-wide text-primary-300">
                学習範囲: {chatbotData.model?.trainingScope || '経歴データ'}
              </p>
              <p class="mt-1 text-[10px] leading-relaxed text-primary-400/70">
                ※ 学習範囲は今後段階的に拡張・更新されていきます。
              </p>
              <div class="mt-1 h-3 select-none text-transparent">.</div>
            </div>
          </div>
          <div
            class={`rounded-2xl border border-primary-500/30 bg-dark-900/80 p-4 shadow-2xl backdrop-blur-md hide-scrollbar ${chatbotData.quickQuestions.length > 5 ? 'flex-1 overflow-y-auto' : 'overflow-visible'} ${chatbotData.quickQuestions.length <= 3 ? 'py-4' : ''}`}
            style={chatbotData.quickQuestions.length <= 3 ? 'max-height:none' : 'max-height:100%;'}
          >
            <h4 class="mb-3 font-semibold text-white">💡 よくある質問</h4>
            <div class="space-y-2">
              {
                chatbotData.quickQuestions.map((q: string) => (
                  <button class="quick-question w-full rounded-lg bg-primary-600/20 p-3 text-left text-sm text-primary-200 transition-colors hover:bg-primary-600/30">
                    {q}
                  </button>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script>
    import { initChatbotRuntime } from '../scripts/client/chatbotRuntime';

    initChatbotRuntime();
  </script>

  <style>
    .chatbot-layout {
      gap: 1.5rem;
    }
    .chatbot-layout.chatbot-layout--fixed {
      overflow: hidden;
      position: relative;
    }
    #chat-container {
      display: flex;
      flex-direction: column;
      min-height: 0;
      overflow: hidden;
    }
    #chat-container > #chat-messages {
      flex: 1 1 auto;
      min-height: 0;
      overflow-y: auto;
    }
    #chat-messages {
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    #chat-messages::-webkit-scrollbar {
      display: none;
    }
    .hide-scrollbar {
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .hide-scrollbar::-webkit-scrollbar {
      display: none;
    }
    @media (max-width: 1023px) {
      .chatbot-layout.chatbot-layout--fixed {
        height: auto !important;
        max-height: none !important;
      }
      #chat-container,
      #chat-container > #chat-messages {
        height: auto !important;
        max-height: none !important;
      }
    }
  </style>
</Layout>
