---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
// @ts-ignore
import data from '../data/chatbot.yml';
const chatbotData = data;
---

{/* 元: chatbot.astro -> chatbot.astro */}
<Layout title="AI Chatbot - i7s7-ymp Portfolio" headerPills={['build:ok']}>
  <PageHeader
    title={chatbotData.header.title}
    subtitle={chatbotData.header.subtitle}
    icon={chatbotData.header.icon}
    iconBgClass={chatbotData.header.iconBgClass}
  />
  <div class="arch-page-grid">
    <section class="arch-block" aria-labelledby="chatbot-chat-heading">
      <h3 id="chatbot-chat-heading" class="sr-only">ChatBot</h3>
      <div id="chatbot-layout" class="chatbot-layout flex flex-col lg:flex-row lg:space-x-6">
        <div
          id="chat-container"
          class="flex min-h-0 flex-1 flex-col rounded-2xl border border-primary-600/30 bg-dark-900/80 shadow-2xl backdrop-blur-md"
        >
          <div
            id="chat-messages"
            class="min-h-0 flex-1 space-y-4 overflow-y-auto p-4"
            aria-live="polite"
          >
            <div class="flex items-start space-x-3">
              <div
                class="flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-r from-primary-500 to-accent-pink"
              >
                <span class="text-sm">{chatbotData.header.icon || '🤖'}</span>
              </div>
              <div class="flex-1">
                <div class="rounded-2xl bg-primary-600/20 p-3 backdrop-blur-sm">
                  <p class="text-white">
                    こんにちは！<br />
                    私は「山下 大輝(i7s7-ymp)」について学習したチャットボットです。<br />
                    右サイドのクイック質問、または下の入力欄から送信できます。<br />
                    初回の生成には時間がかかる場合があります。
                  </p>
                </div>
                <p class="mt-1 text-xs text-primary-400">now</p>
              </div>
            </div>
          </div>
          <div class="border-t border-primary-500/30 p-4">
            <div class="flex items-center space-x-3">
              <div class="relative flex-1">
                <input
                  type="text"
                  id="chat-input"
                  placeholder="メッセージを入力してください..."
                  value="経歴について教えてください。"
                  class="w-full rounded-xl border border-primary-500/30 bg-dark-800/50 px-4 py-3 text-white placeholder-primary-400 backdrop-blur-sm focus:border-primary-400 focus:outline-none focus:ring-2 focus:ring-primary-400/20"
                  autocomplete="off"
                />
              </div>
              <button
                id="send-btn"
                class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-r from-primary-500 to-accent-pink text-white transition-all hover:scale-105 hover:shadow-lg"
                aria-label="Send message"
              >
                <span class="text-xl">➤</span>
              </button>
            </div>
          </div>
        </div>
        <div class="mt-6 flex h-full w-full flex-shrink-0 flex-col space-y-4 lg:mt-0 lg:w-80">
          <div
            class="rounded-2xl border border-primary-500/30 bg-dark-900/80 p-6 shadow-2xl backdrop-blur-md"
            style="min-height:240px;"
          >
            <div class="flex h-full flex-col items-center justify-start text-center">
              <div class="relative mx-auto mb-4 h-24 w-24">
                <div
                  class="flex h-full w-full animate-glow items-center justify-center rounded-full bg-gradient-to-r from-primary-500 via-accent-pink to-accent-cyan shadow-lg"
                >
                  <span class="text-4xl" aria-hidden="true">{chatbotData.header.icon || '🤖'}</span>
                </div>
              </div>
              <h3 class="text-xl font-bold text-white">
                {chatbotData.model?.name || 'Chatbot Model'}
              </h3>
              <p class="mt-2 text-xs tracking-wide text-primary-300">
                学習範囲: {chatbotData.model?.trainingScope || '経歴データ'}
              </p>
              <p class="mt-1 text-[10px] leading-relaxed text-primary-400/70">
                ※ 学習範囲は今後段階的に拡張・更新されていきます。
              </p>
              <div class="mt-1 h-3 select-none text-transparent">.</div>
            </div>
          </div>
          <div
            class={`rounded-2xl border border-primary-500/30 bg-dark-900/80 p-4 shadow-2xl backdrop-blur-md hide-scrollbar ${chatbotData.quickQuestions.length > 5 ? 'flex-1 overflow-y-auto' : 'overflow-visible'} ${chatbotData.quickQuestions.length <= 3 ? 'py-4' : ''}`}
            style={chatbotData.quickQuestions.length <= 3 ? 'max-height:none' : 'max-height:100%;'}
          >
            <h4 class="mb-3 font-semibold text-white">💡 よくある質問</h4>
            <div class="space-y-2">
              {
                chatbotData.quickQuestions.map((q: any) => (
                  <button class="quick-question w-full rounded-lg bg-primary-600/20 p-3 text-left text-sm text-primary-200 transition-colors hover:bg-primary-600/30">
                    {q}
                  </button>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Layout & Chat Scripts -->
  <script is:inline>
    // ===== Layout sizing =====
    function adjustChatbotLayoutHeight() {
      const chatbotLayout = document.getElementById('chatbot-layout');
      const chatContainer = document.getElementById('chat-container');
      if (!chatbotLayout) return;
      const rect = chatbotLayout.getBoundingClientRect();
      const target = Math.max(320, window.innerHeight - rect.top - 8);
      chatbotLayout.style.height = target + 'px';
      chatbotLayout.classList.add('chatbot-layout--fixed');
      if (chatContainer) chatContainer.style.height = target + 'px';
    }
    function scheduleAdjustments() {
      adjustChatbotLayoutHeight();
      setTimeout(adjustChatbotLayoutHeight, 150);
      setTimeout(adjustChatbotLayoutHeight, 400);
    }
    window.addEventListener('load', scheduleAdjustments);
    requestAnimationFrame(scheduleAdjustments);
    window.addEventListener('resize', adjustChatbotLayoutHeight);
    window.addEventListener('orientationchange', adjustChatbotLayoutHeight);
    window.addEventListener('visibilitychange', () => {
      if (!document.hidden) scheduleAdjustments();
    });

    // ===== Chat / Gradio integration =====
    const GRADIO_SPACE_URL =
      'https://genai-app-chatymp-1-1756129226295-304438944339.us-central1.run.app/';
    let gradioClientPromise = null;
    const conversationHistory = [];
    async function loadGradio() {
      if (!gradioClientPromise) {
        gradioClientPromise = (async () => {
          try {
            const mod = await import('https://esm.sh/@gradio/client');
            return await mod.Client.connect(GRADIO_SPACE_URL);
          } catch {
            // 接続失敗はユーザー向けに静かに扱う
            return null;
          }
        })();
      }
      return gradioClientPromise;
    }
    async function sendToModel(userMessage) {
      const client = await loadGradio();
      if (!client) return 'モデルへ接続できませんでした (一時的な問題)。';
      // ==== Schema introspection (cache) ====
      if (!window.__gradioSchema) {
        try {
          window.__gradioSchema = await client.view_api?.();
        } catch {}
      }
      const schema = window.__gradioSchema;
      const endpoint = '/chat';
      let inputNames = [];
      if (
        schema &&
        schema.endpoints &&
        schema.endpoints[endpoint] &&
        Array.isArray(schema.endpoints[endpoint].parameters)
      ) {
        inputNames = schema.endpoints[endpoint].parameters.map(p => p.name).filter(Boolean);
      }
      const base = userMessage;
      const historySnapshot = [...conversationHistory];
      // ChatInterface(type="messages", multimodal=True) では JS クライアントから
      // [MultimodalData(dict), history(list)] の配列形式が期待される。
      // MultimodalData は {text: "..."} などの辞書。plain string は ValidationError。
      const messageObjects = [
        { text: base },
        { text: base, mime_type: 'text/plain' },
        { message: base }, // 念のため
        { prompt: base },
      ];
      if (inputNames.length === 1) {
        // もしスキーマ上単一入力名が与えられている場合、ラップ辞書をそのキーに入れる形式も試行
        const n = inputNames[0];
        messageObjects.push({ [n]: { text: base } });
      }
      const historyArray = historySnapshot.map(m => ({ role: m.role, content: m.content }));
      const attempts = [
        ...messageObjects.map(m => [m, historyArray]),
        // 念のためヒストリ無し (Gradio が内部で空配列補完する場合)
        ...messageObjects.map(m => [m, []]),
      ];
      function pickVal(result) {
        const root = result && (result.data ?? result);
        // 配列(多重) -> 文字列配列抽出 & 連結
        if (Array.isArray(root)) {
          try {
            const flat = root.flat
              ? root.flat(Infinity)
              : (function fl(a) {
                  return a.reduce((o, v) => o.concat(Array.isArray(v) ? fl(v) : v), []);
                })(root);
            const strings = flat.filter(s => typeof s === 'string');
            if (strings.length) {
              return strings.join('').replace(/\n/g, '\n');
            }
          } catch {}
        }
        const arr = Array.isArray(root) ? root : [root];
        for (const item of arr) {
          if (item == null) continue;
          if (typeof item === 'string' && item.trim()) return item;
          if (typeof item === 'object') {
            for (const k of ['text', 'answer', 'output', 'response', 'generated_text', 'content']) {
              if (typeof item[k] === 'string' && item[k].trim()) return item[k];
            }
          }
        }
        try {
          return JSON.stringify(root);
        } catch {
          return String(root);
        }
      }
      for (const payload of attempts) {
        try {
          const result = await Promise.race([
            client.predict(endpoint, payload),
            new Promise((_, rej) => setTimeout(() => rej(new Error('timeout:18s')), 18000)),
          ]);
          return pickVal(result);
        } catch {}
      }
      return '推論エラーが発生しました。';
    }
    function now() {
      return new Date().toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' });
    }
    const chatMessages = document.getElementById('chat-messages');
    const chatInput = document.getElementById('chat-input');
    const sendBtn = document.getElementById('send-btn');
    function appendNode(node) {
      if (!chatMessages) return;
      chatMessages.appendChild(node);
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }
    function escapeText(s) {
      return s.replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]);
    }
    // ========= Message bubble helpers =========
    function createWrapper() {
      const wrap = document.createElement('div');
      wrap.className = 'flex items-start space-x-3';
      return wrap;
    }
    function renderUserBubble(text) {
      const wrap = createWrapper();
      wrap.innerHTML = `<div class='flex-1 flex justify-end'><div><div class='rounded-2xl bg-gradient-to-r from-primary-500 to-accent-pink p-3 backdrop-blur-sm'><p class='text-white'></p></div><p class='text-xs text-primary-400 mt-1 text-right'>${now()}</p></div></div><div class='flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-r from-accent-cyan to-accent-neon'><span class='text-sm'>👤</span></div>`;
      const p = wrap.querySelector('p.text-white');
      if (p) p.textContent = text;
      return wrap;
    }
    function renderAssistantPending(id) {
      const wrap = createWrapper();
      wrap.innerHTML = `<div id='${id}' class='flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-r from-primary-500 to-accent-pink'><span class='text-sm'>🎯</span></div><div class='flex-1'><div class='rounded-2xl bg-primary-600/20 p-3 backdrop-blur-sm'><p class='text-primary-300 animate-pulse'>生成中...</p></div><p class='text-xs text-primary-400 mt-1'>${now()}</p></div>`;
      return wrap;
    }
    function replaceAssistantBubble(id, content) {
      const node = document.getElementById(id);
      if (!node) return;
      const parent = node.parentElement;
      if (!parent) return;
      parent.innerHTML = `<div class='flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-r from-primary-500 to-accent-pink'><span class='text-sm'>🎯</span></div><div class='flex-1'><div class='rounded-2xl bg-primary-600/20 p-3 backdrop-blur-sm'><p class='text-white whitespace-pre-line'></p></div><p class='text-xs text-primary-400 mt-1'>${now()}</p></div>`;
      const p = parent.querySelector('p.text-white');
      if (p) p.textContent = content;
    }
    function normalizeOutput(r) {
      if (typeof r !== 'string') return String(r ?? '');
      const t = r.trim();
      if (t.startsWith('[')) {
        try {
          const parsed = JSON.parse(t);
          const flat = (function fl(a) {
            return Array.isArray(a) ? a.reduce((o, v) => o.concat(fl(v)), []) : [a];
          })(parsed);
          const strings = flat.filter(s => typeof s === 'string');
          if (strings.length) return strings.join('').replace(/\n/g, '\n');
        } catch {}
      }
      return r.replace(/\n/g, '\n');
    }
    // ========= Send queue / processing =========
    const sendQueue = [];
    let processing = false;
    function setUiBusy(busy) {
      if (sendBtn) sendBtn.disabled = busy;
      if (chatInput) chatInput.disabled = busy;
    }
    async function processQueue() {
      if (processing) return;
      processing = true;
      setUiBusy(true);
      while (sendQueue.length) {
        const text = sendQueue.shift();
        await handleSendCore(text);
      }
      setUiBusy(false);
      processing = false;
    }
    function enqueueSend(text) {
      sendQueue.push(text);
      processQueue();
    }
    async function handleSendCore(raw) {
      const text = raw;
      conversationHistory.push({ role: 'user', content: text });
      appendNode(renderUserBubble(escapeText(text)));
      const typingId = 'typing-' + crypto.randomUUID();
      appendNode(renderAssistantPending(typingId));
      let response = '';
      try {
        response = await sendToModel(text);
      } catch {
        response = 'エラーが発生しました。';
      }
      const normalized = normalizeOutput(response);
      replaceAssistantBubble(typingId, normalized);
      conversationHistory.push({ role: 'assistant', content: normalized });
    }
    function isBlankInput(v) {
      return !v || !v.replace(/[\s\u3000]/g, '');
    }
    async function handleSend() {
      if (!chatInput) return;
      const value = chatInput.value;
      if (isBlankInput(value)) return;
      const toSend = value.trim();
      chatInput.value = '';
      enqueueSend(toSend);
    }
    if (sendBtn) sendBtn.addEventListener('click', handleSend);
    if (chatInput)
      chatInput.addEventListener('keydown', e => {
        if (e.key === 'Enter') {
          if (e.shiftKey) {
            // allow newline
            return;
          }
          e.preventDefault();
          handleSend();
        }
      });
    document.querySelectorAll('.quick-question').forEach(btn => {
      btn.addEventListener('click', () => {
        if (chatInput) {
          chatInput.value = btn.textContent || '';
          handleSend();
        }
      });
    });
  </script>

  <style>
    .arch-page-grid {
      --arch-max: 1100px;
      width: 100%;
      max-width: var(--arch-max);
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      row-gap: clamp(3rem, 6vh, 4.5rem);
      padding-inline: clamp(1rem, 2.5vw, 2rem);
    }
    @media (max-width: 720px) {
      .arch-page-grid {
        row-gap: 3.25rem;
      }
    }
    .chatbot-layout {
      gap: 1.5rem;
    }
    .chatbot-layout.chatbot-layout--fixed {
      overflow: hidden;
      position: relative;
    }
    #chat-container {
      display: flex;
      flex-direction: column;
      min-height: 0;
      overflow: hidden;
    }
    #chat-container > #chat-messages {
      flex: 1 1 auto;
      min-height: 0;
      overflow-y: auto;
    }
    #chat-messages {
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    #chat-messages::-webkit-scrollbar {
      display: none;
    }
    .hide-scrollbar {
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .hide-scrollbar::-webkit-scrollbar {
      display: none;
    }
    @media (max-width: 1023px) {
      .chatbot-layout.chatbot-layout--fixed {
        height: auto !important;
        max-height: none !important;
      }
      #chat-container,
      #chat-container > #chat-messages {
        height: auto !important;
        max-height: none !important;
      }
    }
  </style>
</Layout>
