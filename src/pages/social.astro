---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
// @ts-ignore
import data from '../data/social.yml';

const gradMap: Record<string, string> = {
  gray: 'from-gray-700 to-gray-900',
  indigo: 'from-indigo-500 to-indigo-700',
  cyan: 'from-cyan-400 to-sky-500',
  'blue-600': 'from-blue-500 to-blue-700',
  // Discord公式カラー(#5865F2)に近い紫グラデ
  discord: 'from-indigo-500 to-indigo-600',
  default: 'from-slate-600 to-slate-800',
};
const glowMap: Record<string, string> = {
  gray: 'bg-gradient-to-r from-gray-400/20 via-gray-200/10 to-transparent',
  indigo: 'bg-gradient-to-r from-indigo-400/40 via-indigo-300/10 to-transparent',
  cyan: 'bg-gradient-to-r from-cyan-400/50 via-cyan-300/10 to-transparent',
  'blue-600': 'bg-gradient-to-r from-blue-500/50 via-blue-300/10 to-transparent',
  discord: 'bg-gradient-to-r from-indigo-400/40 via-indigo-300/10 to-transparent',
  default: 'bg-gradient-to-r from-emerald-400/40 via-emerald-300/10 to-transparent',
};

// ローカル保存した公式ロゴ (public/logos)
const logoUrlMap = {
  github: '/logos/github.svg',
  // 公式配布が PNG のため拡張子を修正
  linkedin: '/logos/linkedin.png',
  zenn: '/logos/zenn.svg',
  discord: '/logos/discord.svg',
  default: '/logos/github.svg',
};
---

<Layout title="Social - i7s7-ymp Portfolio">
  <div class="space-y-10">
    <PageHeader
      title={data.header.title}
      subtitle={data.header.subtitle}
      icon="🌐"
      iconBgClass="bg-gradient-to-r from-accent-cyan to-accent-pink"
    >
      <div slot="extra" class="flex flex-wrap gap-2 text-xs">
        {data.header.tags.map((t: string) => <span class="badge-pill">{t}</span>)}
      </div>
    </PageHeader>
    <div class="grid gap-6 md:grid-cols-2">
      {
        data.links.map((l: any) => {
          const icon = l.icon || 'default';
          const grad = gradMap[icon] || gradMap[l.color] || gradMap.default;
          const glow = glowMap[icon] || glowMap[l.color] || glowMap.default;
          const logoSrc = (logoUrlMap as any)[icon] || logoUrlMap.default;
          const isWhiteBg = icon === 'zenn' || icon === 'linkedin';
          const containerBase =
            'flex h-14 w-14 items-center justify-center overflow-hidden rounded-xl p-2 shadow-lg transition-all duration-300 group-hover:rotate-3 group-hover:scale-110';
          const containerClass = isWhiteBg
            ? `${containerBase} bg-white dark:bg-white ring-1 ring-black/5`
            : `${containerBase} bg-gradient-to-br ${grad}`;
          return (
            <a href={l.url} target="_blank" rel="noopener noreferrer" class="section-card group">
              <div class="mb-3 flex items-center space-x-3">
                <div class="relative">
                  <div class={containerClass}>
                    <img
                      src={logoSrc}
                      alt={`${l.name} ロゴ`}
                      loading="lazy"
                      decoding="async"
                      width="56"
                      height="56"
                      class="h-14 w-14 object-contain"
                    />
                  </div>
                  <div
                    class={`pointer-events-none absolute -inset-1 rounded-2xl opacity-0 blur-md transition-opacity group-hover:opacity-70 ${glow}`}
                  />
                  <div class="pointer-events-none absolute inset-0 rounded-xl ring-2 ring-white/10 transition group-hover:ring-white/25" />
                </div>
                <div>
                  <h3 class="font-semibold leading-tight text-primary-100">{l.name}</h3>
                  <p class="font-mono text-xs text-primary-400">{l.username}</p>
                </div>
              </div>
              <p class="text-sm text-primary-200">{l.desc}</p>
              {l.stats?.length && (
                <div class="mt-3 flex flex-wrap gap-3 font-mono text-[11px] text-primary-300">
                  {l.stats.map((s: any) => (
                    <span class="rounded bg-primary-600/20 px-2 py-1">{s}</span>
                  ))}
                </div>
              )}
            </a>
          );
        })
      }
    </div>

    <div class="section-card">
      <h3 class="gradient-heading-sm mb-4 flex items-center space-x-2 text-lg font-semibold">
        <span class="text-accent-cyan">連絡先</span>
      </h3>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        <div class="space-y-2">
          {
            data.contacts.slice(0, Math.ceil(data.contacts.length / 2)).map((c: any) => (
              <div class="flex items-center space-x-2">
                <span class="text-green-400">{c.icon}</span>
                <span class="text-gray-300">{c.value}</span>
              </div>
            ))
          }
        </div>
        <div class="space-y-2">
          {
            data.contacts.slice(Math.ceil(data.contacts.length / 2)).map((c: any) => (
              <div class="flex items-center space-x-2">
                <span class="text-green-400">{c.icon}</span>
                <span class="text-gray-300">{c.value}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</Layout>
