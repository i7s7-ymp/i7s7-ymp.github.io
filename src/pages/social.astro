---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
// @ts-ignore
import data from '../data/social.yml';
---

<Layout title="ソーシャル - i7s7-ymp Portfolio">
  <div class="space-y-10">
    <PageHeader
      title={data.header.title}
      subtitle={data.header.subtitle}
      icon="🌐"
      iconBgClass="bg-gradient-to-r from-accent-blue to-accent-cyan"
    >
      <div slot="extra" class="flex flex-wrap gap-2 text-xs">
        {data.header.tags.map((t: string) => <span class="badge-pill">{t}</span>)}
      </div>
    </PageHeader>

    <!-- ソーシャルリンクグリッド -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        data.links.map((l: any) => {
          const icon = l.icon;
          const gradientMap = {
            github: 'from-slate-700 via-slate-600 to-slate-500',
            linkedin: 'from-blue-600 via-indigo-500 to-sky-400',
            zenn: 'from-cyan-500 via-sky-500 to-blue-500',
            discord: 'from-indigo-500 via-indigo-600 to-purple-600',
            default: 'from-primary-500 via-accent-pink to-accent-cyan',
          };
          const glowMap = {
            github: 'bg-slate-400/30',
            linkedin: 'bg-indigo-400/30',
            zenn: 'bg-cyan-300/30',
            discord: 'bg-indigo-400/30',
            default: 'bg-primary-300/30',
          };
          // @ts-ignore dyn key
          const grad = gradientMap[icon] || gradientMap.default;
          // @ts-ignore dyn key
          const glow = glowMap[icon] || glowMap.default;
          const svgs = {
            github: (
              <svg
                viewBox="0 0 24 24"
                class="h-8 w-8 text-white"
                aria-hidden="true"
                fill="currentColor"
              >
                <path d="M12 2C6.48 2 2 6.58 2 12.26c0 4.5 2.87 8.32 6.84 9.67.5.1.68-.22.68-.49 0-.24-.01-.87-.01-1.71-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.09 0-1.13.39-2.05 1.03-2.77-.1-.26-.45-1.31.1-2.74 0 0 .84-.28 2.75 1.06a9.2 9.2 0 0 1 2.5-.35 9.2 9.2 0 0 1 2.5.35c1.9-1.34 2.74-1.06 2.74-1.06.55 1.43.2 2.48.1 2.74.64.72 1.02 1.64 1.02 2.77 0 3.96-2.34 4.82-4.57 5.08.36.32.67.95.67 1.92 0 1.38-.01 2.49-.01 2.83 0 .27.18.6.69.49A10.03 10.03 0 0 0 22 12.26C22 6.58 17.52 2 12 2Z" />
              </svg>
            ),
            linkedin: (
              <svg
                viewBox="0 0 24 24"
                class="h-7 w-7 text-white"
                aria-hidden="true"
                fill="currentColor"
              >
                <path d="M4.98 3.5a2.25 2.25 0 1 1 0 4.5 2.25 2.25 0 0 1 0-4.5ZM3 9h4v12H3V9Zm7.5 0h3.83v1.71h.05c.53-.96 1.84-1.97 3.79-1.97 4.06 0 4.81 2.57 4.81 5.92V21h-4v-5.2c0-1.24-.02-2.84-1.73-2.84-1.74 0-2.01 1.36-2.01 2.74V21h-4V9Z" />
              </svg>
            ),
            zenn: (
              <svg
                viewBox="0 0 24 24"
                class="h-8 w-8 text-white"
                aria-hidden="true"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect
                  x="3"
                  y="3"
                  width="18"
                  height="18"
                  rx="4"
                  class="fill-white/10 stroke-white/30"
                />
                <path d="M8 16h8l-8-8h8" class="stroke-white" />
              </svg>
            ),
            discord: (
              <svg
                viewBox="0 0 24 24"
                class="h-8 w-8 text-white"
                aria-hidden="true"
                fill="currentColor"
              >
                <path d="M20 4.5A19.7 19.7 0 0 0 15.73 3l-.23.46a18.5 18.5 0 0 1 4.07 1.25A14.9 14.9 0 0 0 13.9 3.5c-.27 0-.54.01-.81.02h-.18c-.27-.01-.54-.02-.81-.02A14.9 14.9 0 0 0 4.43 4.7 18.5 18.5 0 0 1 8.5 3.46L8.27 3A19.7 19.7 0 0 0 4 4.5C1.67 8.04.9 11.47 1.17 14.86v.01c2.07 2.55 5.1 3.24 7.8 3.63l.6-.77c-1.34-.4-2.54-1.1-3.55-2.07l.9.53.36.21a11 11 0 0 0 9.34 0l.36-.21.9-.53c-1.01.97-2.21 1.67-3.55 2.07l.6.77c2.7-.39 5.73-1.08 7.8-3.63v-.01C23.1 11.47 22.33 8.04 20 4.5ZM9.75 13.5c-.83 0-1.5-.9-1.5-2s.67-2 1.5-2 1.5.9 1.5 2-.67 2-1.5 2Zm4.5 0c-.83 0-1.5-.9-1.5-2s.67-2 1.5-2 1.5.9 1.5 2-.67 2-1.5 2Z" />
              </svg>
            ),
            default: (
              <svg
                viewBox="0 0 24 24"
                class="h-7 w-7 text-white"
                aria-hidden="true"
                fill="currentColor"
              >
                <path d="M12 2 2 7l10 5 10-5L12 2Zm0 7.3L5.74 7 12 4.7 18.26 7 12 9.3ZM4 10.79l8 4 8-4V17l-8 4-8-4v-6.21Z" />
              </svg>
            ),
          };
          // @ts-ignore dyn key
          const IconSvg = svgs[icon] || svgs.default;
          return (
            <a href={l.url} target="_blank" rel="noopener noreferrer" class="section-card group">
              <div class="mb-3 flex items-center space-x-3">
                <div class="relative">
                  <div
                    class={`flex h-14 w-14 items-center justify-center rounded-xl bg-gradient-to-br ${grad} text-xl shadow-lg transition-all duration-300 group-hover:rotate-3 group-hover:scale-110`}
                  >
                    {IconSvg}
                  </div>
                  <div
                    class={`pointer-events-none absolute -inset-1 rounded-2xl opacity-0 blur-md transition-opacity group-hover:opacity-70 ${glow}`}
                  />
                  <div class="pointer-events-none absolute inset-0 rounded-xl ring-2 ring-white/10 transition group-hover:ring-white/25" />
                </div>
                <div>
                  <h3 class="font-semibold leading-tight text-primary-100">{l.name}</h3>
                  <p class="font-mono text-xs text-primary-400">{l.username}</p>
                </div>
              </div>
              <p class="text-sm text-primary-200">{l.desc}</p>
              {l.stats?.length && (
                <div class="mt-3 flex flex-wrap gap-3 font-mono text-[11px] text-primary-300">
                  {l.stats.map((s: string) => (
                    <span class="rounded bg-primary-600/20 px-2 py-1">{s}</span>
                  ))}
                </div>
              )}
            </a>
          );
        })
      }
    </div>

    <!-- 連絡先 -->
    <div class="section-card">
      <h3 class="gradient-heading-sm mb-4 flex items-center space-x-2 text-lg font-semibold">
        <span class="text-accent-cyan">連絡先</span>
      </h3>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        <div class="space-y-2">
          {
            data.contacts.slice(0, Math.ceil(data.contacts.length / 2)).map((c: any) => (
              <div class="flex items-center space-x-2">
                <span class="text-green-400">{c.icon}</span>
                <span class="text-gray-300">{c.value}</span>
              </div>
            ))
          }
        </div>
        <div class="space-y-2">
          {
            data.contacts.slice(Math.ceil(data.contacts.length / 2)).map((c: any) => (
              <div class="flex items-center space-x-2">
                <span class="text-green-400">{c.icon}</span>
                <span class="text-gray-300">{c.value}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</Layout>
