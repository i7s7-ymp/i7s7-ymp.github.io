---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Social Media - i7s7-ymp Portfolio">
  <div class="space-y-6">
    <!-- ページタイトル -->
    <div class="rounded-lg border border-green-400/30 bg-gray-800/50 p-4">
      <div class="mb-2 text-green-400">
        <span class="text-gray-400">$</span> curl -s social.links | grep -E "(github|twitter|linkedin)"
      </div>
      <h2 class="text-2xl font-bold text-green-400"># Social Media & Links</h2>
      <p class="mt-2 text-gray-300">> Connect with me across platforms</p>
    </div>

    <!-- ソーシャルメディアリンク -->
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      <!-- GitHub -->
      <a
        href="https://github.com/i7s7-ymp"
        target="_blank"
        rel="noopener noreferrer"
        class="group rounded-lg border border-green-400/30 bg-gray-800/50 p-4 transition-colors hover:bg-gray-800/70"
      >
        <div class="mb-3 flex items-center space-x-3">
          <div
            class="flex h-12 w-12 items-center justify-center rounded-lg bg-gray-700 transition-colors group-hover:bg-gray-600"
          >
            <svg class="h-6 w-6 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-green-400">GitHub</h3>
            <p class="text-sm text-gray-400">@i7s7-ymp</p>
          </div>
        </div>
        <p class="text-sm text-gray-300">
          オープンソースプロジェクトとポートフォリオのコードを公開中
        </p>
        <div class="mt-3 flex items-center space-x-4 text-xs text-gray-400">
          <span>50+ repos</span>
          <span>100+ commits</span>
          <span>Active</span>
        </div>
      </a>

      <!-- Twitter -->
      <a
        href="https://twitter.com/i7s7_ymp"
        target="_blank"
        rel="noopener noreferrer"
        class="group rounded-lg border border-blue-400/30 bg-gray-800/50 p-4 transition-colors hover:bg-gray-800/70"
      >
        <div class="mb-3 flex items-center space-x-3">
          <div
            class="flex h-12 w-12 items-center justify-center rounded-lg bg-blue-500/20 transition-colors group-hover:bg-blue-500/30"
          >
            <svg class="h-6 w-6 text-blue-400" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-blue-400">Twitter</h3>
            <p class="text-sm text-gray-400">@i7s7_ymp</p>
          </div>
        </div>
        <p class="text-sm text-gray-300">技術情報の発信とコミュニティとの交流</p>
        <div class="mt-3 flex items-center space-x-4 text-xs text-gray-400">
          <span>Tech tweets</span>
          <span>Daily updates</span>
        </div>
      </a>

      <!-- LinkedIn -->
      <a
        href="https://linkedin.com/in/i7s7-ymp"
        target="_blank"
        rel="noopener noreferrer"
        class="group rounded-lg border border-blue-600/30 bg-gray-800/50 p-4 transition-colors hover:bg-gray-800/70"
      >
        <div class="mb-3 flex items-center space-x-3">
          <div
            class="flex h-12 w-12 items-center justify-center rounded-lg bg-blue-600/20 transition-colors group-hover:bg-blue-600/30"
          >
            <svg class="h-6 w-6 text-blue-500" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-blue-500">LinkedIn</h3>
            <p class="text-sm text-gray-400">i7s7-ymp</p>
          </div>
        </div>
        <p class="text-sm text-gray-300">プロフェッショナルなネットワークとキャリア情報</p>
        <div class="mt-3 flex items-center space-x-4 text-xs text-gray-400">
          <span>Professional</span>
          <span>Networking</span>
        </div>
      </a>

      <!-- Qiita -->
      <a
        href="https://qiita.com/i7s7_ymp"
        target="_blank"
        rel="noopener noreferrer"
        class="group rounded-lg border border-green-500/30 bg-gray-800/50 p-4 transition-colors hover:bg-gray-800/70"
      >
        <div class="mb-3 flex items-center space-x-3">
          <div
            class="flex h-12 w-12 items-center justify-center rounded-lg bg-green-500/20 transition-colors group-hover:bg-green-500/30"
          >
            <span class="text-lg font-bold text-green-500">Q</span>
          </div>
          <div>
            <h3 class="font-semibold text-green-500">Qiita</h3>
            <p class="text-sm text-gray-400">@i7s7_ymp</p>
          </div>
        </div>
        <p class="text-sm text-gray-300">技術記事の投稿と知識の共有</p>
        <div class="mt-3 flex items-center space-x-4 text-xs text-gray-400">
          <span>Tech articles</span>
          <span>Tutorials</span>
        </div>
      </a>

      <!-- Stack Overflow -->
      <a
        href="https://stackoverflow.com/users/i7s7-ymp"
        target="_blank"
        rel="noopener noreferrer"
        class="group rounded-lg border border-orange-500/30 bg-gray-800/50 p-4 transition-colors hover:bg-gray-800/70"
      >
        <div class="mb-3 flex items-center space-x-3">
          <div
            class="flex h-12 w-12 items-center justify-center rounded-lg bg-orange-500/20 transition-colors group-hover:bg-orange-500/30"
          >
            <svg class="h-6 w-6 text-orange-500" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M18.986 21.865v-6.404h2.134L24 9.98l-2.88-5.481h-4.133l-2.88 5.481 2.88 5.481h2.013v6.404h-3.96V24h9.973v-2.135h-2.027zm-9.573-5.481V24H0v-7.616h9.413z"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-orange-500">Stack Overflow</h3>
            <p class="text-sm text-gray-400">i7s7-ymp</p>
          </div>
        </div>
        <p class="text-sm text-gray-300">技術的な質問への回答とコミュニティ貢献</p>
        <div class="mt-3 flex items-center space-x-4 text-xs text-gray-400">
          <span>Q&A</span>
          <span>Community</span>
        </div>
      </a>

      <!-- Blog -->
      <a
        href="https://blog.i7s7-ymp.dev"
        target="_blank"
        rel="noopener noreferrer"
        class="group rounded-lg border border-purple-500/30 bg-gray-800/50 p-4 transition-colors hover:bg-gray-800/70"
      >
        <div class="mb-3 flex items-center space-x-3">
          <div
            class="flex h-12 w-12 items-center justify-center rounded-lg bg-purple-500/20 transition-colors group-hover:bg-purple-500/30"
          >
            <svg
              class="h-6 w-6 text-purple-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-purple-500">Tech Blog</h3>
            <p class="text-sm text-gray-400">blog.i7s7-ymp.dev</p>
          </div>
        </div>
        <p class="text-sm text-gray-300">技術ブログとプロジェクトの詳細解説</p>
        <div class="mt-3 flex items-center space-x-4 text-xs text-gray-400">
          <span>Deep dives</span>
          <span>Tutorials</span>
        </div>
      </a>
    </div>

    <!-- Contact Information -->
    <div class="rounded-lg border border-green-400/30 bg-gray-800/50 p-4">
      <h3 class="mb-4 text-lg font-semibold text-green-400">
        <span class="text-gray-400">></span> contact_info --show
      </h3>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        <div class="space-y-2">
          <div class="flex items-center space-x-2">
            <span class="text-green-400">📧</span>
            <span class="text-gray-300">contact@i7s7-ymp.dev</span>
          </div>
          <div class="flex items-center space-x-2">
            <span class="text-green-400">🌐</span>
            <span class="text-gray-300">https://i7s7-ymp.github.io</span>
          </div>
        </div>
        <div class="space-y-2">
          <div class="flex items-center space-x-2">
            <span class="text-green-400">📍</span>
            <span class="text-gray-300">Tokyo, Japan</span>
          </div>
          <div class="flex items-center space-x-2">
            <span class="text-green-400">🕒</span>
            <span class="text-gray-300">JST (UTC+9)</span>
          </div>
        </div>
      </div>
    </div>

    <!-- GitHubアクティビティ風 -->
    <div class="rounded-lg border border-green-400/30 bg-gray-800/50 p-4">
      <h3 class="mb-4 text-lg font-semibold text-green-400">
        <span class="text-gray-400">></span> git log --oneline --graph --since="1 week ago"
      </h3>
      <div class="space-y-2 font-mono text-sm">
        <div class="flex items-center space-x-2">
          <span class="text-green-400">●</span>
          <span class="text-yellow-400">a1b2c3d</span>
          <span class="text-gray-300">Update portfolio design system</span>
          <span class="text-gray-500">2 days ago</span>
        </div>
        <div class="flex items-center space-x-2">
          <span class="text-green-400">●</span>
          <span class="text-yellow-400">e4f5g6h</span>
          <span class="text-gray-300">Add new blog post about React patterns</span>
          <span class="text-gray-500">3 days ago</span>
        </div>
        <div class="flex items-center space-x-2">
          <span class="text-green-400">●</span>
          <span class="text-yellow-400">i7j8k9l</span>
          <span class="text-gray-300">Contribute to open source project</span>
          <span class="text-gray-500">5 days ago</span>
        </div>
        <div class="flex items-center space-x-2">
          <span class="text-green-400">●</span>
          <span class="text-yellow-400">m0n1o2p</span>
          <span class="text-gray-300">Share tech insights on Twitter</span>
          <span class="text-gray-500">1 week ago</span>
        </div>
      </div>
    </div>
  </div>
</Layout>
