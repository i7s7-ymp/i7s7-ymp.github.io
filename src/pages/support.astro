---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
// @ts-ignore
import data from '../data/support.yaml';

interface CloudCase {
  title: string;
  ops?: number;
  category?: string;
  desc?: string;
  diagram?: string;
  tags?: string[];
  colors?: string[];
  stack?: string;
}
interface AppPattern {
  name: string;
  desc?: string;
  diagram?: string;
  color?: string;
  uses?: number; // 利用回数など任意メトリック（未指定は1）
}

// 単一プロバイダ（AWS のみ使用）
const cloudCases: CloudCase[] = (data as any).cloudCases ?? [];
const appPatterns: AppPattern[] = (data as any).appPatterns ?? [];

// 指定順序（ユーザー指定最新順）
// 表示名と実データカテゴリ名称の差異を吸収（"Application Integration" vs "Application integrations"）
const targetCategories = [
  'Compute',
  'Database',
  'Storage',
  'Application Integration',
  'Network & Content Delivery',
  'Developer Tools',
  'Financial Management',
  'Analytics',
  'Security Identity & Compliance',
];

type CatStat = { name: string; total: number; items: CloudCase[] };
function buildStats(cases: CloudCase[]): CatStat[] {
  return targetCategories.map(name => {
    const items = cases.filter(c => {
      const cat = (c.category || '').trim();
      if (name === 'Application Integration')
        return cat === 'Application Integration' || cat === 'Application integrations';
      return cat === name;
    });
    const total = items.reduce((s, c) => s + (c.ops || 0), 0);
    return { name, total, items };
  });
}
let catStats: CatStat[] = buildStats(cloudCases);

// Y軸: 最大値を含む10刻みスケール
function computeScale(stats: CatStat[]) {
  const rawMax = Math.max(...stats.map(c => c.total), 0);
  const yMax = rawMax === 0 ? 10 : Math.ceil(rawMax / 10) * 10;
  const ticks: number[] = [];
  for (let v = 0; v <= yMax; v += 10) ticks.push(v);
  return { yMax, ticks };
}
let { yMax, ticks: catTicks } = computeScale(catStats);

// カテゴリごとの明確な配色 + パターン指定（色が近い場合の視覚差分強化）
interface CatStyle {
  color: string;
  pattern?: string;
}
const categoryStyles: Record<string, CatStyle> = {
  Compute: { color: 'purple', pattern: 'cross' },
  Database: { color: 'yellow', pattern: 'diag2' },
  Storage: { color: 'teal', pattern: 'vdash' },
  'Application Integration': { color: 'blue', pattern: 'diag' },
  'Network & Content Delivery': { color: 'red', pattern: 'hstripe' },
  'Developer Tools': { color: 'orange', pattern: 'grid' },
  'Financial Management': { color: 'green', pattern: 'dot' },
  Analytics: { color: 'cyan', pattern: 'none' },
  'Security Identity & Compliance': { color: 'pink', pattern: 'checker' },
};
function catStyle(name: string): CatStyle {
  return categoryStyles[name] || { color: 'cyan', pattern: 'none' };
}

// アプリケーション設計カテゴリ（横軸固定順序）
const patternCategories = [
  'Data-Centric',
  'Layered',
  'Component-Based',
  'Service-Oriented',
  'Distributed System',
  'Domain-Driven',
  'Event-Driven',
  'Separation Of Concern',
  'Interpreter',
  'Concurrency',
];
// カテゴリ毎の集計（name一致）: 同名が複数あれば uses 合計、存在しなければ0
type PatternStat = { name: string; total: number; color: string; sourceCount: number };
const patternStats: PatternStat[] = patternCategories.map(cat => {
  const matched = appPatterns.filter(p => p.name === cat);
  const total = matched.reduce((s, p) => s + (typeof p.uses === 'number' ? p.uses : 1), 0);
  // 最初のマッチ色 or fallback palette
  const palette = [
    'cyan',
    'blue',
    'green',
    'purple',
    'yellow',
    'orange',
    'teal',
    'pink',
    'red',
    'cyan',
  ];
  const fallback = palette[patternCategories.indexOf(cat) % palette.length];
  const color = (matched[0]?.color ?? fallback) as string;
  return { name: cat, total, color, sourceCount: matched.length } as PatternStat;
});
const patternRawMax = Math.max(...patternStats.map(p => p.total), 0);
const patternYMax = patternRawMax === 0 ? 1 : Math.ceil(patternRawMax / 5) * 5; // 5刻み程度
const patternTicks: number[] = [];
for (let v = 0; v <= patternYMax; v += Math.max(1, Math.round(patternYMax / 5)))
  patternTicks.push(v);
---

<Layout title="アーキテクチャ - i7s7-ymp Portfolio">
  <PageHeader
    title={data.header.title}
    subtitle={data.header.subtitle}
    icon={data.header.icon}
    iconBgClass={data.header.iconBgClass}
  />
  <div class="vchart-wrapper pb-10 pt-4">
    <div
      class="vchart"
      role="img"
      aria-label={`クラウドカテゴリ別運用件数 Y軸最大 ${yMax}`}
      aria-describedby="cat-note"
    >
      <div class="plot" data-count={catStats.length}>
        <div class="grid-y" aria-hidden="true">
          {
            catTicks.map(t => {
              const pct = (t / yMax) * 100;
              const top = 100 - pct;
              return (
                <div class="grid-row" style={`top:${top}%;`}>
                  <span class="grid-line" />
                  <span class="grid-label">{t}</span>
                </div>
              );
            })
          }
        </div>
        <div class="bars" data-count={catStats.length} style="--bar-w:70px;">
          {
            catStats.map(cat => {
              const hPct = cat.total === 0 ? 0 : (cat.total / yMax) * 100;
              const isHigh = hPct > 90;
              const { color, pattern } = catStyle(cat.name);
              const id = `cat-${cat.name.replace(/\s+/g, '-').toLowerCase()}`;
              return (
                <div
                  class="bar-box"
                  style={`--h:${hPct}%;`}
                  data-color={color}
                  data-id={id}
                  data-zero={cat.total === 0}
                  data-pattern={pattern}
                  title={`${cat.name}: ${cat.total} ops`}
                  data-high={isHigh}
                >
                  <div class="bar-hit" aria-label={`${cat.name} ${cat.total} ops`}>
                    <span class="bar-fill" />
                    <span class="bar-value font-mono">{cat.total}</span>
                  </div>
                </div>
              );
            })
          }
        </div>
        <div class="axis-x" aria-hidden="true"></div>
      </div>
      <div class="bar-labels" aria-hidden="false">
        {
          catStats.map(cat => {
            const { color } = catStyle(cat.name);
            const id = `cat-${cat.name.replace(/\s+/g, '-').toLowerCase()}`;
            return (
              <div
                class="x-label badge-pill"
                data-color={color}
                data-id={id}
                tabindex="0"
                aria-label={`${cat.name} カテゴリ`}
              >
                {cat.name}
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
  <p id="cat-note" class="chart-note" aria-label="カテゴリ分類注釈">
    ※ カテゴリ区分は主に AWS サービス分類 (Console / Docs, 2025年時点)
    を参考にしつつポートフォリオ用途で簡略化・統合しています。
  </p>
  <script>
    // @ts-nocheck 単一プロバイダ版: バー/ラベル相互ハイライト
    document.addEventListener('DOMContentLoaded', () => {
      function attachInteractions(root = document) {
        const bars = Array.from(root.querySelectorAll('.vchart .bar-box'));
        const labels = Array.from(root.querySelectorAll('.vchart .bar-labels .x-label'));
        const activate = id => {
          bars.forEach(b => b.classList.toggle('active', !!id && b.dataset.id === id));
          labels.forEach(l => l.classList.toggle('active', !!id && l.dataset.id === id));
        };
        const clear = () => activate(null);
        bars.forEach(b => {
          const id = b.dataset.id || '';
          const hit = b.querySelector('.bar-hit');
          if (hit) hit.tabIndex = 0;
          ['mouseenter', 'focus'].forEach(ev => b.addEventListener(ev, () => activate(id)));
          ['mouseleave', 'blur'].forEach(ev => b.addEventListener(ev, clear));
          b.addEventListener('click', () => activate(id));
        });
        labels.forEach(l => {
          const id = l.dataset.id || '';
          ['mouseenter', 'focus'].forEach(ev => l.addEventListener(ev, () => activate(id)));
          ['mouseleave', 'blur'].forEach(ev => l.addEventListener(ev, clear));
          l.addEventListener('click', () => activate(id));
          l.addEventListener('keydown', e => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              activate(id);
            } else if (e.key === 'Escape') clear();
          });
        });
        document.addEventListener('keydown', e => {
          if (e.key === 'Escape') clear();
        });
      }
      attachInteractions();
    });
  </script>

  <section class="patterns-section pb-20" aria-labelledby="pattern-chart-title">
    <h3 id="pattern-chart-title" class="mb-6 text-lg font-semibold text-green-400">
      アプリケーションパターン
    </h3>
    <div class="pchart-wrapper">
      <div
        class="pchart"
        role="img"
        aria-label={`アプリケーションパターン出現数 Y軸最大 ${patternYMax}`}
        aria-describedby="pattern-note"
      >
        <div class="plot" data-count={patternStats.length}>
          <div class="grid-y" aria-hidden="true">
            {
              patternTicks.map(t => {
                const pct = (t / patternYMax) * 100;
                const top = 100 - pct;
                return (
                  <div class="grid-row" style={`top:${top}%;`}>
                    <span class="grid-line" />
                    <span class="grid-label">{t}</span>
                  </div>
                );
              })
            }
          </div>
          <div class="bars pattern-bars" data-count={patternStats.length} style="--bar-w:60px;">
            {
              patternStats.map(p => {
                const hPct = p.total === 0 ? 0 : (p.total / patternYMax) * 100;
                const id = `pat-${p.name.replace(/\s+/g, '-').toLowerCase()}`;
                const isHigh = hPct > 90;
                return (
                  <div
                    class="bar-box"
                    style={`--h:${hPct}%;`}
                    data-color={p.color}
                    data-id={id}
                    data-zero={p.total === 0}
                    data-high={isHigh}
                  >
                    <div class="bar-hit" aria-label={`${p.name} ${p.total} uses`}>
                      <span class="bar-fill" />
                      <span class="bar-value font-mono">{p.total}</span>
                    </div>
                  </div>
                );
              })
            }
          </div>
          <div class="axis-x" aria-hidden="true"></div>
        </div>
        <div class="bar-labels pattern-labels" aria-hidden="false">
          {
            patternStats.map(p => {
              const id = `pat-${p.name.replace(/\s+/g, '-').toLowerCase()}`;
              return (
                <div
                  class="x-label badge-pill"
                  data-color={p.color}
                  data-id={id}
                  tabindex="0"
                  aria-label={`${p.name} パターン`}
                >
                  {p.name}
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
    <p id="pattern-note" class="chart-note mt-4">
      ※ 各パターンの値は uses プロパティ（未指定は 1）です。YAML に <code>uses:</code> を追加して調整できます。
    </p>
  </section>
</Layout>

<!-- プロバイダ切替関連コード除去後 -->

<style>
  .vchart-wrapper {
    position: relative;
  }
  .vchart {
    position: relative;
    min-height: 320px;
  }
  .plot {
    position: relative;
    padding: 0 0 46px 56px;
  }
  .grid-y {
    position: absolute;
    inset: 0 0 46px 0;
  }
  .grid-row {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
  }
  .grid-line {
    position: absolute;
    left: 56px;
    right: 0;
    top: 0;
    height: 1px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.18), transparent 55%);
  }
  .grid-label {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    font-size: 10px;
    font-family: ui-monospace, monospace;
    color: #94a3b8;
    padding-right: 6px;
  }
  .bars {
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: 1.25rem;
    height: 250px;
    margin-left: 56px;
  }
  .bars {
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }
  .bars::-webkit-scrollbar {
    height: 8px;
  }
  .bars::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
  }
  .bars::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.18);
    border-radius: 4px;
  }
  .bar-box {
    position: relative;
    width: var(--bar-w, 70px);
    flex: 0 0 var(--bar-w, 70px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    height: 100%;
  }
  .bar-hit {
    position: relative;
    width: 100%;
    height: 100%;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    outline: none;
  }
  .bar-fill {
    width: 100%;
    height: var(--h);
    min-height: 2px;
    border-radius: 6px 6px 4px 4px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.22), transparent),
      var(--bar-color, rgba(34, 211, 238, 0.55));
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08),
      0 5px 14px -4px rgba(0, 0, 0, 0.65);
    position: relative;
    overflow: hidden;
    animation: grow-bar 0.9s cubic-bezier(0.25, 0.85, 0.3, 1) both;
  }
  .bar-box[data-zero='false'] .bar-fill {
    min-height: 8px;
  }
  .bar-box[data-zero='true'] .bar-fill {
    filter: grayscale(0.45) brightness(0.75);
    opacity: 0.55;
  }
  .bar-fill::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 40% 18%, rgba(255, 255, 255, 0.48), transparent 62%);
    mix-blend-mode: overlay;
    opacity: 0.42;
  }
  .bar-value {
    position: absolute;
    bottom: calc(var(--h) + 6px);
    font-size: 11px;
    background: rgba(15, 23, 42, 0.88);
    padding: 2px 6px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    font-family: ui-monospace, monospace;
    color: #e2e8f0;
    letter-spacing: 0.5px;
    box-shadow: 0 2px 5px -2px rgba(0, 0, 0, 0.6);
  }
  /* 高さが90%以上のバーは内部上部にラベルを反転表示 */
  .bar-box[data-high='true'] .bar-value {
    bottom: auto;
    top: 4px;
    background: rgba(0, 0, 0, 0.28);
    border: 1px solid rgba(255, 255, 255, 0.25);
    mix-blend-mode: screen;
  }
  .bar-box[data-zero='true'] .bar-value {
    bottom: 8px;
  }
  /* in-bar labels removed; external labels below */
  .axis-x {
    position: absolute;
    left: 56px;
    right: 0;
    bottom: 46px;
    height: 1px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.05));
  }
  .bar-box:hover .bar-fill,
  .bar-box:focus-within .bar-fill {
    filter: brightness(1.18) saturate(1.2);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.22),
      0 10px 26px -6px rgba(0, 0, 0, 0.85);
  }
  .bar-box:hover .bar-value,
  .bar-box:focus-within .bar-value {
    background: rgba(15, 23, 42, 0.95);
  }
  @keyframes grow-bar {
    from {
      height: 0;
      filter: brightness(0.7) saturate(0.8);
    }
    65% {
      filter: brightness(1.15) saturate(1.1);
    }
    to {
      filter: brightness(1) saturate(1);
    }
  }
  .bar-box[data-color='cyan'] .bar-fill {
    --bar-color: linear-gradient(180deg, #22d3ee, #0891b2);
  }
  .bar-box[data-color='blue'] .bar-fill {
    --bar-color: linear-gradient(180deg, #3b82f6, #1d4ed8);
  }
  .bar-box[data-color='green'] .bar-fill {
    --bar-color: linear-gradient(180deg, #10b981, #047857);
  }
  .bar-box[data-color='purple'] .bar-fill {
    --bar-color: linear-gradient(180deg, #8b5cf6, #6d28d9);
  }
  .bar-box[data-color='yellow'] .bar-fill {
    --bar-color: linear-gradient(180deg, #fbbf24, #d97706);
  }
  .bar-box[data-color='orange'] .bar-fill {
    --bar-color: linear-gradient(180deg, #fb923c, #c2410c);
  }
  .bar-box[data-color='red'] .bar-fill {
    --bar-color: linear-gradient(180deg, #ef4444, #b91c1c);
  }
  .bar-box[data-color='teal'] .bar-fill {
    --bar-color: linear-gradient(180deg, #14b8a6, #0f766e);
  }
  .bar-box[data-color='pink'] .bar-fill {
    --bar-color: linear-gradient(180deg, #ec4899, #be185d);
  }
  /* パターンオーバーレイ */
  .bar-box[data-pattern]:not([data-pattern='none']) .bar-fill::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.45;
    mix-blend-mode: overlay;
    background-size: 16px 16px;
    background-repeat: repeat;
  }
  .bar-box[data-pattern='dot'] .bar-fill::before {
    background-image:
      radial-gradient(circle at 25% 25%, rgba(255, 255, 255, 0.6) 12%, transparent 13%),
      radial-gradient(circle at 75% 75%, rgba(255, 255, 255, 0.6) 12%, transparent 13%);
  }
  .bar-box[data-pattern='diag'] .bar-fill::before {
    background-image: repeating-linear-gradient(
      45deg,
      rgba(255, 255, 255, 0.55) 0 4px,
      transparent 4px 8px
    );
  }
  .bar-box[data-pattern='diag2'] .bar-fill::before {
    background-image: repeating-linear-gradient(
      -45deg,
      rgba(255, 255, 255, 0.5) 0 3px,
      transparent 3px 7px
    );
  }
  .bar-box[data-pattern='cross'] .bar-fill::before {
    background-image:
      repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.5) 0 2px, transparent 2px 8px),
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.5) 0 2px, transparent 2px 8px);
  }
  .bar-box[data-pattern='grid'] .bar-fill::before {
    background-image:
      repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.45) 0 1px, transparent 1px 8px),
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.45) 0 1px, transparent 1px 8px);
  }
  .bar-box[data-pattern='hstripe'] .bar-fill::before {
    background-image: repeating-linear-gradient(
      0deg,
      rgba(255, 255, 255, 0.55) 0 3px,
      transparent 3px 6px
    );
  }
  .bar-box[data-pattern='vdash'] .bar-fill::before {
    background-image: repeating-linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.55) 0 2px,
      transparent 2px 6px
    );
  }
  .bar-box[data-pattern='checker'] .bar-fill::before {
    background-image:
      linear-gradient(
        45deg,
        rgba(255, 255, 255, 0.55) 25%,
        transparent 25% 50%,
        rgba(255, 255, 255, 0.55) 50% 75%,
        transparent 75%
      ),
      linear-gradient(
        45deg,
        rgba(255, 255, 255, 0.35) 25%,
        transparent 25% 50%,
        rgba(255, 255, 255, 0.35) 50% 75%,
        transparent 75%
      );
    background-size: 12px 12px;
    background-position:
      0 0,
      6px 6px;
    opacity: 0.5;
  }
  /* App patterns */
  .patterns-section {
    max-width: 1100px;
    margin: 0 auto;
  }
  .pchart-wrapper {
    position: relative;
  }
  .pchart {
    position: relative;
    min-height: 300px;
  }
  .pattern-bars {
    height: 220px;
  }
  .pattern-labels {
    margin-top: 1rem;
  }
  .bar-labels {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 0.65rem;
    margin: 1.25rem 0 0 56px;
    font-size: 11px;
    line-height: 1.2;
    max-width: calc(100% - 56px);
  }
  /* badge-pill ベース (header と統一) */
  .badge-pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 4px 10px 4px 8px;
    font-weight: 500;
    letter-spacing: 0.3px;
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.85), rgba(15, 23, 42, 0.6));
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    cursor: pointer;
    transition:
      0.25s background,
      0.25s border-color,
      0.25s box-shadow,
      0.25s transform;
    backdrop-filter: blur(6px);
  }
  .badge-pill::before {
    content: '';
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--pill-color, #38bdf8);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.35),
      0 0 8px -1px var(--pill-color, #38bdf8);
  }
  .badge-pill[data-color='cyan'] {
    --pill-color: #22d3ee;
  }
  .badge-pill[data-color='blue'] {
    --pill-color: #3b82f6;
  }
  .badge-pill[data-color='green'] {
    --pill-color: #10b981;
  }
  .badge-pill[data-color='purple'] {
    --pill-color: #8b5cf6;
  }
  .badge-pill[data-color='yellow'] {
    --pill-color: #fbbf24;
  }
  .badge-pill[data-color='orange'] {
    --pill-color: #fb923c;
  }
  .badge-pill[data-color='red'] {
    --pill-color: #ef4444;
  }
  .badge-pill[data-color='teal'] {
    --pill-color: #14b8a6;
  }
  .badge-pill[data-color='pink'] {
    --pill-color: #ec4899;
  }
  .badge-pill:hover,
  .badge-pill:focus {
    background: linear-gradient(135deg, rgba(45, 55, 72, 0.9), rgba(25, 32, 48, 0.75));
