---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
// @ts-ignore
import data from '../data/support.yml';

interface ExperienceItem {
  title: string;
  category?: string[]; // 複数カテゴリ
  architecture?: string; // 単一パターン
  description?: string;
  uses?: number; // (仕様#3 未決定: 現状は1と同義)
}
const experiences: ExperienceItem[] = (data as any).experiences ?? [];

// 指定順序: 既存クラウド分類
const targetCategories = [
  'Compute',
  'Database',
  'Storage',
  'Application Integration',
  'Network & Content Delivery',
  'Developer Tools',
  'Financial Management',
  'Analytics',
  'Security Identity & Compliance',
];
type CatStat = { name: string; total: number };
const catStats: CatStat[] = targetCategories.map(name => ({ name, total: 0 }));
for (const exp of experiences) {
  const cats = Array.isArray(exp.category) ? exp.category : [];
  for (const c of cats) {
    const key = c === 'Application integrations' ? 'Application Integration' : c;
    const stat = catStats.find(s => s.name === key);
    if (stat) stat.total += 1; // uses 未適用（仕様#3 決定前）
  }
}

// (旧) 個別スケール計算は廃止 -> 後段で unified スケール適用

// カテゴリごとの明確な配色 + パターン指定（色が近い場合の視覚差分強化）
interface CatStyle {
  color: string;
}
const categoryStyles: Record<string, CatStyle> = {
  Compute: { color: 'purple' },
  Database: { color: 'yellow' },
  Storage: { color: 'teal' },
  'Application Integration': { color: 'blue' },
  'Network & Content Delivery': { color: 'red' },
  'Developer Tools': { color: 'orange' },
  'Financial Management': { color: 'green' },
  Analytics: { color: 'cyan' },
  'Security Identity & Compliance': { color: 'pink' },
};
function catStyle(name: string): CatStyle {
  return categoryStyles[name] || { color: 'cyan' };
}

// 表示用: カテゴリ日本語ラベルマップ（内部集計キーは英語維持）
const catLabelMap: Record<string, string> = {
  Compute: 'コンピュート',
  Database: 'データベース',
  Storage: 'ストレージ',
  'Application Integration': 'アプリケーション統合',
  'Network & Content Delivery': 'ネットワーク / コンテンツ配信',
  'Developer Tools': '開発ツール',
  'Financial Management': 'コスト管理',
  Analytics: '分析',
  'Security Identity & Compliance': 'セキュリティ / ID / コンプライアンス',
};
const catLabel = (name: string) => catLabelMap[name] || name;

// アプリケーションアーキテクチャ カテゴリ
const patternCategories = [
  'Data-Centric',
  'Layered',
  'Component-Based',
  'Service-Oriented',
  'Distributed System',
  'Domain-Driven',
  'Event-Driven',
  'Separation Of Concern',
  'Interpreter',
  'Concurrency',
];
type PatternStat = { name: string; total: number; color: string };
const palette = [
  'cyan',
  'blue',
  'green',
  'purple',
  'yellow',
  'orange',
  'teal',
  'pink',
  'red',
  'cyan',
] as const;
// 単一パターンに統一: pattern 情報は保持しない
const patternStats: PatternStat[] = patternCategories.map((name, i) => ({
  name,
  total: 0,
  color: palette[i % palette.length] as string,
}));
for (const exp of experiences) {
  const arch = exp.architecture;
  if (!arch) continue;
  const stat = patternStats.find(p => p.name === arch);
  if (stat) stat.total += 1; // uses 未適用（仕様#3 決定前）
}

// 統一Y軸スケール: 両チャートで同じ高さ基準を共有
function computeUnifiedScale(values: number[]) {
  const maxVal = Math.max(...values, 0);
  if (maxVal === 0) {
    return { yMax: 5, step: 1, ticks: [0, 1, 2, 3, 4, 5] };
  }
  const segments = 5; // tick は 0 含め 6 本
  // 基本ステップ候補
  let rawStep = maxVal / segments;
  const magnitude = 10 ** Math.floor(Math.log10(rawStep));
  const norm = rawStep / magnitude;
  // 1,2,2.5,5,10 ステップ系列
  let base;
  if (norm <= 1) base = 1;
  else if (norm <= 2) base = 2;
  else if (norm <= 2.5) base = 2.5;
  else if (norm <= 5) base = 5;
  else base = 10;
  let step = base * magnitude;
  if (step < 1) step = 1;
  const yMax = step * segments;
  const ticks: number[] = [];
  for (let v = 0; v <= yMax + 0.0001; v += step) ticks.push(v);
  return { yMax, step, ticks };
}
const allValues = [...catStats.map(c => c.total), ...patternStats.map(p => p.total)];
const unified = computeUnifiedScale(allValues);
const yMax = unified.yMax;
const catTicks = unified.ticks;
const patternYMax = unified.yMax;
const patternTicks = unified.ticks;

// パターン日本語ラベル
const patternLabelMap: Record<string, string> = {
  'Data-Centric': 'データ中心',
  Layered: 'レイヤード',
  'Component-Based': 'コンポーネント指向',
  'Service-Oriented': 'サービス指向',
  'Distributed System': '分散システム',
  'Domain-Driven': 'ドメイン駆動',
  'Event-Driven': 'イベント駆動',
  'Separation Of Concern': '関心分離',
  Interpreter: 'インタプリタ',
  Concurrency: '並行処理',
};
const patternLabel = (name: string) => patternLabelMap[name] || name;
---

<Layout title="アーキテクチャ - i7s7-ymp Portfolio">
  <PageHeader
    title={data.header.title}
    subtitle={data.header.subtitle}
    icon={data.header.icon}
    iconBgClass={data.header.iconBgClass}
  />
  <div class="chart-toggle-wrapper" role="group" aria-label="チャート種別切替">
    <button
      type="button"
      class="chart-toggle-btn active"
      data-chart-toggle
      data-target="cloud"
      aria-pressed="true"
      aria-controls="cloud-chart-section">クラウド</button
    >
    <button
      type="button"
      class="chart-toggle-btn"
      data-chart-toggle
      data-target="app"
      aria-pressed="false"
      aria-controls="app-chart-section">アプリ</button
    >
  </div>
  <section
    class="cloud-arch-section chart-section"
    aria-labelledby="cloud-arch-title"
    id="cloud-chart-section"
  >
    <h3 id="cloud-arch-title" class="mb-6 text-lg font-semibold text-cyan-400">
      クラウドアーキテクチャ
    </h3>
    <div class="chart-wrapper">
      <div
        class="vchart"
        role="img"
        aria-label={`クラウドカテゴリ別運用件数 Y軸最大 ${yMax}`}
        aria-describedby="cat-note"
      >
        <div class="plot" data-count={catStats.length}>
          <div class="grid-y" aria-hidden="true">
            {
              catTicks.map(t => {
                const pct = (t / yMax) * 100;
                const top = 100 - pct;
                return (
                  <div class="grid-row" style={`top:${top}%;`}>
                    <span class="grid-line" />
                    <span class="grid-label">{t}</span>
                  </div>
                );
              })
            }
          </div>
          <div class="bars" data-count={catStats.length} style="--bar-w:70px;">
            {
              catStats.map(cat => {
                const hPct = cat.total === 0 ? 0 : (cat.total / yMax) * 100;
                const isHigh = hPct > 90;
                const { color } = catStyle(cat.name);
                const id = `cat-${cat.name.replace(/\s+/g, '-').toLowerCase()}`;
                return (
                  <div
                    class="bar-box"
                    style={`--h:${hPct}%;`}
                    data-color={color}
                    data-id={id}
                    data-zero={cat.total === 0}
                    title={`${catLabel(cat.name)}: ${cat.total}件`}
                    data-high={isHigh}
                  >
                    <div class="bar-hit" aria-label={`${catLabel(cat.name)} ${cat.total}件`}>
                      <span class="bar-fill" />
                      <span class="bar-value font-mono">{cat.total}</span>
                    </div>
                  </div>
                );
              })
            }
          </div>
          <div class="axis-x" aria-hidden="true"></div>
        </div>
        <div class="bar-labels" aria-hidden="false">
          {
            catStats.map(cat => {
              const { color } = catStyle(cat.name);
              const id = `cat-${cat.name.replace(/\s+/g, '-').toLowerCase()}`;
              return (
                <div
                  class="x-label badge-pill"
                  data-color={color}
                  data-id={id}
                  tabindex="0"
                  aria-label={`${catLabel(cat.name)} カテゴリ`}
                >
                  {catLabel(cat.name)}
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
    <p id="cat-note" class="chart-note unified-note" aria-label="カテゴリ分類注釈">
      ※ カテゴリ区分は主に AWS サービス分類 (Console / Docs, 2025年時点)
      を参考にしつつポートフォリオ用途で簡略化・統合しています。
    </p>
  </section>
  <script>
    // @ts-nocheck 単一プロバイダ版: バー/ラベル相互ハイライト
    document.addEventListener('DOMContentLoaded', () => {
      function attachInteractions(root = document) {
        const bars = Array.from(root.querySelectorAll('.vchart .bar-box'));
        const labels = Array.from(root.querySelectorAll('.vchart .bar-labels .x-label'));
        const activate = id => {
          bars.forEach(b => b.classList.toggle('active', !!id && b.dataset.id === id));
          labels.forEach(l => l.classList.toggle('active', !!id && l.dataset.id === id));
        };
        const clear = () => activate(null);
        bars.forEach(b => {
          const id = b.dataset.id || '';
          const hit = b.querySelector('.bar-hit');
          if (hit) hit.tabIndex = 0;
          ['mouseenter', 'focus'].forEach(ev => b.addEventListener(ev, () => activate(id)));
          ['mouseleave', 'blur'].forEach(ev => b.addEventListener(ev, clear));
          b.addEventListener('click', () => activate(id));
        });
        labels.forEach(l => {
          const id = l.dataset.id || '';
          ['mouseenter', 'focus'].forEach(ev => l.addEventListener(ev, () => activate(id)));
          ['mouseleave', 'blur'].forEach(ev => l.addEventListener(ev, clear));
          l.addEventListener('click', () => activate(id));
          l.addEventListener('keydown', e => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              activate(id);
            } else if (e.key === 'Escape') clear();
          });
        });
        document.addEventListener('keydown', e => {
          if (e.key === 'Escape') clear();
        });
      }
      attachInteractions();
      // トグル制御
      const toggleButtons = Array.from(document.querySelectorAll('[data-chart-toggle]'));
      const cloudSection = document.getElementById('cloud-chart-section');
      const appSection = document.getElementById('app-chart-section');
      function setChart(which) {
        if (!cloudSection || !appSection) return;
        const showCloud = which === 'cloud';
        cloudSection.hidden = !showCloud;
        appSection.hidden = showCloud;
        toggleButtons.forEach(btn => {
          const active = btn.dataset.target === which;
          btn.classList.toggle('active', active);
          btn.setAttribute('aria-pressed', String(active));
        });
      }
      toggleButtons.forEach(btn => {
        btn.addEventListener('click', () => setChart(btn.dataset.target));
        btn.addEventListener('keydown', e => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            setChart(btn.dataset.target);
          }
          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
            e.preventDefault();
            const idx = toggleButtons.indexOf(btn);
            const dir = e.key === 'ArrowRight' ? 1 : -1;
            const next = (idx + dir + toggleButtons.length) % toggleButtons.length;
            toggleButtons[next].focus();
          }
        });
      });
      setChart('cloud');
    });
  </script>

  <section
    class="patterns-section chart-section"
    aria-labelledby="pattern-chart-title"
    id="app-chart-section"
    hidden
  >
    <h3 id="pattern-chart-title" class="mb-6 text-lg font-semibold text-green-400">
      アプリケーションパターン
    </h3>
    <div class="chart-wrapper">
      <div
        class="pchart"
        role="img"
        aria-label={`アプリケーションパターン出現数 Y軸最大 ${patternYMax}`}
        aria-describedby="pattern-note"
      >
        <div class="plot" data-count={patternStats.length}>
          <div class="grid-y" aria-hidden="true">
            {
              patternTicks.map(t => {
                const pct = (t / patternYMax) * 100;
                const top = 100 - pct;
                return (
                  <div class="grid-row" style={`top:${top}%;`}>
                    <span class="grid-line" />
                    <span class="grid-label">{t}</span>
                  </div>
                );
              })
            }
          </div>
          <div class="bars pattern-bars" data-count={patternStats.length} style="--bar-w:60px;">
            {
              patternStats.map(p => {
                const hPct = p.total === 0 ? 0 : (p.total / patternYMax) * 100;
                const id = `pat-${p.name.replace(/\s+/g, '-').toLowerCase()}`;
                const isHigh = hPct > 90;
                return (
                  <div
                    class="bar-box"
                    style={`--h:${hPct}%;`}
                    data-color={p.color}
                    data-id={id}
                    data-zero={p.total === 0}
                    data-high={isHigh}
                  >
                    <div class="bar-hit" aria-label={`${patternLabel(p.name)} ${p.total}件`}>
                      <span class="bar-fill" />
                      <span class="bar-value font-mono">{p.total}</span>
                    </div>
                  </div>
                );
              })
            }
          </div>
          <div class="axis-x" aria-hidden="true"></div>
        </div>
        <div class="bar-labels pattern-labels" aria-hidden="false">
          {
            patternStats.map(p => {
              const id = `pat-${p.name.replace(/\s+/g, '-').toLowerCase()}`;
              return (
                <div
                  class="x-label badge-pill"
                  data-color={p.color}
                  data-id={id}
                  tabindex="0"
                  aria-label={`${patternLabel(p.name)} パターン`}
                >
                  {patternLabel(p.name)}
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
    <p id="pattern-note" class="chart-note unified-note">
      ※ 値は experiences の件数（1エントリー=1）です。uses 反映ロジック(仕様#3) 未適用。
    </p>
  </section>
</Layout>

<!-- プロバイダ切替関連コード除去後 -->

<style>
  .chart-section {
    /* 両チャート共通の下余白統一 */
    padding-bottom: 3.5rem; /* 注釈位置を安定化 */
  }
  .chart-wrapper {
    position: relative;
  }
  .vchart-wrapper {
    position: relative;
  }
  .vchart {
    position: relative;
    min-height: 320px; /* 統一基準 */
  }
  .plot {
    position: relative;
    padding: 0 0 46px 56px;
  }
  .grid-y {
    position: absolute;
    inset: 0 0 46px 0;
  }
  .grid-row {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
  }
  .grid-line {
    position: absolute;
    left: 56px;
    right: 0;
    top: 0;
    height: 1px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.18), transparent 55%);
  }
  .grid-label {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    font-size: 10px;
    font-family: ui-monospace, monospace;
    color: #94a3b8;
    padding-right: 6px;
  }
  .bars {
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: 1.25rem;
    height: 250px;
    margin-left: 56px;
  }
  .bars {
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }
  .bars::-webkit-scrollbar {
    height: 8px;
  }
  .bars::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
  }
  .bars::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.18);
    border-radius: 4px;
  }
  .bar-box {
    position: relative;
    width: var(--bar-w, 70px);
    flex: 0 0 var(--bar-w, 70px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    height: 100%;
  }
  .bar-hit {
    position: relative;
    width: 100%;
    height: 100%;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    outline: none;
  }
  .bar-fill {
    width: 100%;
    height: var(--h);
    min-height: 2px;
    border-radius: 6px 6px 4px 4px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.22), transparent),
      var(--bar-color, rgba(34, 211, 238, 0.55));
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08),
      0 5px 14px -4px rgba(0, 0, 0, 0.65);
    position: relative;
    overflow: hidden;
    animation: grow-bar 0.9s cubic-bezier(0.25, 0.85, 0.3, 1) both;
  }
  .bar-box[data-zero='false'] .bar-fill {
    min-height: 8px;
  }
  .bar-box[data-zero='true'] .bar-fill {
    filter: grayscale(0.45) brightness(0.75);
    opacity: 0.55;
  }
  .bar-fill::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 40% 18%, rgba(255, 255, 255, 0.48), transparent 62%);
    mix-blend-mode: overlay;
    opacity: 0.42;
  }
  .bar-value {
    position: absolute;
    bottom: calc(var(--h) + 6px);
    font-size: 11px;
    background: rgba(15, 23, 42, 0.88);
    padding: 2px 6px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    font-family: ui-monospace, monospace;
    color: #e2e8f0;
    letter-spacing: 0.5px;
    box-shadow: 0 2px 5px -2px rgba(0, 0, 0, 0.6);
  }
  /* 高さが90%以上のバーは内部上部にラベルを反転表示 */
  .bar-box[data-high='true'] .bar-value {
    bottom: auto;
    top: 4px;
    background: rgba(0, 0, 0, 0.28);
    border: 1px solid rgba(255, 255, 255, 0.25);
    mix-blend-mode: screen;
  }
  .bar-box[data-zero='true'] .bar-value {
    bottom: 8px;
  }
  /* in-bar labels removed; external labels below */
  .axis-x {
    position: absolute;
    left: 56px;
    right: 0;
    bottom: 46px;
    height: 1px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.05));
  }
  .bar-box:hover .bar-fill,
  .bar-box:focus-within .bar-fill {
    filter: brightness(1.18) saturate(1.2);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.22),
      0 10px 26px -6px rgba(0, 0, 0, 0.85);
  }
  .bar-box:hover .bar-value,
  .bar-box:focus-within .bar-value {
    background: rgba(15, 23, 42, 0.95);
  }
  @keyframes grow-bar {
    from {
      height: 0;
      filter: brightness(0.7) saturate(0.8);
    }
    65% {
      filter: brightness(1.15) saturate(1.1);
    }
    to {
      filter: brightness(1) saturate(1);
    }
  }
  .bar-box[data-color='cyan'] .bar-fill {
    --bar-color: linear-gradient(180deg, #22d3ee, #0891b2);
  }
  .bar-box[data-color='blue'] .bar-fill {
    --bar-color: linear-gradient(180deg, #3b82f6, #1d4ed8);
  }
  .bar-box[data-color='green'] .bar-fill {
    --bar-color: linear-gradient(180deg, #10b981, #047857);
  }
  .bar-box[data-color='purple'] .bar-fill {
    --bar-color: linear-gradient(180deg, #8b5cf6, #6d28d9);
  }
  .bar-box[data-color='yellow'] .bar-fill {
    --bar-color: linear-gradient(180deg, #fbbf24, #d97706);
  }
  .bar-box[data-color='orange'] .bar-fill {
    --bar-color: linear-gradient(180deg, #fb923c, #c2410c);
  }
  .bar-box[data-color='red'] .bar-fill {
    --bar-color: linear-gradient(180deg, #ef4444, #b91c1c);
  }
  .bar-box[data-color='teal'] .bar-fill {
    --bar-color: linear-gradient(180deg, #14b8a6, #0f766e);
  }
  .bar-box[data-color='pink'] .bar-fill {
    --bar-color: linear-gradient(180deg, #ec4899, #be185d);
  }
  /* 単一パターンオーバーレイ (全バー共通) */
  .bar-fill::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.48;
    mix-blend-mode: overlay;
    background-image: radial-gradient(
      circle at 3px 3px,
      rgba(255, 255, 255, 0.55) 0 1.6px,
      transparent 1.7px
    );
    background-size: 10px 10px;
  }
  /* App patterns */
  .patterns-section {
    max-width: 1100px;
    margin: 0 auto;
  }
  .cloud-arch-section {
    max-width: 1100px;
    margin: 0 auto;
  }
  .chart-toggle-wrapper {
    display: flex;
    justify-content: flex-end;
    gap: 0.6rem;
    margin: 0 56px 1.25rem 56px;
  }
  .chart-toggle-btn {
    position: relative;
    padding: 6px 18px 6px 16px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.4px;
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.85), rgba(15, 23, 42, 0.6));
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #e2e8f0;
    cursor: pointer;
    transition:
      0.25s background,
      0.25s box-shadow,
      0.25s border-color,
      0.25s transform;
    backdrop-filter: blur(6px);
  }
  .chart-toggle-btn:hover,
  .chart-toggle-btn:focus {
    outline: none;
    border-color: rgba(255, 255, 255, 0.3);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.25),
      0 0 14px -2px #38bdf8;
  }
  .chart-toggle-btn.active {
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.3), rgba(15, 23, 42, 0.7));
    border-color: #38bdf8;
    box-shadow:
      0 0 0 1px #38bdf8,
      0 0 18px -2px #38bdf8;
