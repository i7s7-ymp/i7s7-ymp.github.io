---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
// @ts-ignore
import data from '../data/support.yml';
---

<Layout title="アーキテクチャ - i7s7-ymp Portfolio">
  <div class="space-y-10">
    <PageHeader
      title={data.header.title}
      subtitle={data.header.subtitle}
      icon={data.header.icon}
      iconBgClass={data.header.iconBgClass}
    >
      <div slot="extra" class="flex flex-wrap gap-2 text-xs">
        {data.header.tags.map((t: string) => <span class="badge-pill">{t}</span>)}
      </div>
    </PageHeader>
    <div class="space-y-6">
      <div class="section-card">
        <h3 class="mb-4 text-lg font-semibold text-green-400">クラウドアーキテクチャ事例</h3>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
          {
            data.cloudCases.map((c: any) => {
              const primaryColor = c.colors?.[0] || 'cyan';
              return (
                <div class="section-card overflow-hidden p-0">
                  <button
                    class="flex w-full items-start justify-between gap-4 px-4 py-3 text-left hover:bg-primary-600/10 focus:outline-none focus:ring-2 focus:ring-accent-cyan/40"
                    data-toggle
                    aria-expanded="false"
                  >
                    <div class="w-12 shrink-0" aria-hidden="true" />
                    <div>
                      <h4 class={`font-semibold text-${primaryColor}-400`}>{c.title}</h4>
                      <span class="block text-xs text-yellow-400">{c.stack}</span>
                    </div>
                    <span
                      data-chevron
                      class="ml-auto select-none rounded border border-primary-500/30 px-2 font-mono text-sm text-primary-300"
                    >
                      +
                    </span>
                  </button>
                  <div class="collapsible hidden border-t border-primary-600/20 px-4 pb-4 pt-3">
                    <div class="mb-3 rounded bg-gray-800/70 p-3">
                      <pre class="whitespace-pre-wrap text-[11px] leading-relaxed text-green-400">
                        {c.diagram}
                      </pre>
                    </div>
                    <p class="text-sm text-gray-300">{c.desc}</p>
                    <div class="mt-3 flex flex-wrap gap-2">
                      {c.tags.map((t: string, i: number) => (
                        <span
                          class={`rounded bg-${c.colors[i]}-400/20 px-2 py-1 text-xs text-${c.colors[i]}-400`}
                        >
                          {t}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>

      <!-- アプリケーションアーキテクチャ -->
      <div class="section-card">
        <h3 class="mb-4 text-lg font-semibold text-green-400">アプリケーションパターン</h3>

        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
          {
            data.appPatterns.map((p: any) => (
              <div class="section-card overflow-hidden p-0">
                <button
                  class="flex w-full items-start justify-between gap-4 px-4 py-3 text-left hover:bg-primary-600/10 focus:outline-none focus:ring-2 focus:ring-accent-cyan/40"
                  data-toggle
                  aria-expanded="false"
                >
                  <h4 class={`font-semibold text-${p.color}-400`}>{p.name}</h4>
                  <span
                    data-chevron
                    class="ml-auto select-none rounded border border-primary-500/30 px-2 font-mono text-sm text-primary-300"
                  >
                    +
                  </span>
                </button>
                <div class="collapsible hidden border-t border-primary-600/20 px-4 pb-4 pt-3">
                  <div class="mb-2 rounded bg-gray-800/70 p-2">
                    <pre class="whitespace-pre-wrap text-[11px] leading-relaxed text-gray-300">
                      {p.diagram}
                    </pre>
                  </div>
                  <p class="text-xs text-gray-400">{p.desc}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- 技術スタック (Marquee/電光掲示板) -->
      <div class="section-card overflow-hidden">
        <h3 class="mb-4 text-lg font-semibold text-green-400">技術スタック</h3>
        <div class="relative">
          <div
            class="marquee-mask pointer-events-none absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-dark-900 to-transparent"
          >
          </div>
          <div
            class="marquee-mask pointer-events-none absolute inset-y-0 right-0 w-24 bg-gradient-to-l from-dark-900 to-transparent"
          >
          </div>
          <div class="marquee-track flex w-fit gap-12 py-2 will-change-transform" data-marquee>
            <div class="flex flex-nowrap gap-12" data-segment aria-hidden="true">
              {
                data.techStack.categories.map((cat: any) => (
                  <div class="min-w-[220px] shrink-0">
                    <h4 class="mb-2 text-xs font-semibold uppercase tracking-wide text-yellow-400">
                      {cat.title}
                    </h4>
                    <div class="flex flex-wrap gap-2">
                      {cat.items.map((it: any) => (
                        <span
                          class={`flex items-center gap-1 rounded-full border border-${it.color}-400/30 bg-${it.color}-400/10 px-3 py-1 font-mono text-[11px] text-${it.color}-300 shadow-sm`}
                        >
                          <span class={`h-2 w-2 rounded-full bg-${it.color}-400`} />
                          {it.name}
                        </span>
                      ))}
                    </div>
                  </div>
                ))
              }
            </div>
            <!-- 1周目と2周目の間のスペース (以前: w-32) -->
            <div class="w-16 shrink-0" aria-hidden="true"></div>
            <div class="flex flex-nowrap gap-12" data-segment aria-hidden="true">
              {
                data.techStack.categories.map((cat: any) => (
                  <div class="min-w-[220px] shrink-0">
                    <h4 class="mb-2 text-xs font-semibold uppercase tracking-wide text-yellow-400">
                      {cat.title}
                    </h4>
                    <div class="flex flex-wrap gap-2">
                      {cat.items.map((it: any) => (
                        <span
                          class={`flex items-center gap-1 rounded-full border border-${it.color}-400/30 bg-${it.color}-400/10 px-3 py-1 font-mono text-[11px] text-${it.color}-300 shadow-sm`}
                        >
                          <span class={`h-2 w-2 rounded-full bg-${it.color}-400`} />
                          {it.name}
                        </span>
                      ))}
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
        <div class="mt-4 flex items-center gap-3 text-[11px] text-primary-400">
          <span class="h-2 w-2 animate-pulse rounded-full bg-accent-neon"></span>
          <span>横スクロール自動再生 / ホバーで一時停止</span>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  // トグル挙動: 折りたたみ/展開
  const toggleButtons = document.querySelectorAll('[data-toggle]');
  toggleButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      const panel = btn.nextElementSibling;
      if (!panel) return;
      btn.setAttribute('aria-expanded', (!expanded).toString());
      panel.classList.toggle('hidden', expanded);
      const chevron = btn.querySelector('[data-chevron]');
      if (chevron) chevron.textContent = expanded ? '+' : '−';
    });
  });

  // Marquee関連コードは削除済み
</script>

<style>
  /* Marquee animation */
  [data-marquee] {
    animation: marquee-scroll 40s linear infinite;
  }
  [data-marquee]:hover {
    animation-play-state: paused;
  }
  @keyframes marquee-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  .marquee-mask {
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-marquee] {
      animation: none;
    }
  }
</style>
