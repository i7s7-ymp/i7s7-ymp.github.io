---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
// @ts-ignore
import data from '../data/support.yml';
---

<Layout title="アーキテクチャ - i7s7-ymp Portfolio">
  <div class="space-y-10">
    <PageHeader
      title={data.header.title}
      subtitle={data.header.subtitle}
      icon={data.header.icon}
      iconBgClass={data.header.iconBgClass}
    >
      <div slot="extra" class="flex flex-wrap gap-2 text-xs">
        {data.header.tags.map((t: string) => <span class="badge-pill">{t}</span>)}
      </div>
    </PageHeader>

    <!-- クラウドアーキテクチャプロジェクト -->
    <div class="space-y-6">
      <div class="section-card">
        <h3 class="mb-4 text-lg font-semibold text-green-400">クラウドアーキテクチャ事例</h3>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
          {
            data.cloudCases.map((c: any) => (
              <div class="section-card p-4">
                <div class="mb-3">
                  <h4 class={`font-semibold text-${c.colors[0]}-400`}>{c.title}</h4>
                  <span class="text-xs text-yellow-400">{c.stack}</span>
                </div>
                <div class="mb-3 rounded bg-gray-800 p-3">
                  <pre class="text-xs text-green-400">{c.diagram}</pre>
                </div>
                <p class="text-sm text-gray-300">{c.desc}</p>
                <div class="mt-3 flex flex-wrap gap-2">
                  {c.tags.map((t: string, i: number) => (
                    <span
                      class={`rounded bg-${c.colors[i]}-400/20 px-2 py-1 text-xs text-${c.colors[i]}-400`}
                    >
                      {t}
                    </span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- アプリケーションアーキテクチャ -->
      <div class="section-card">
        <h3 class="mb-4 text-lg font-semibold text-green-400">アプリケーションパターン</h3>

        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
          {
            data.appPatterns.map((p: any) => (
              <div class="section-card p-4">
                <h4 class={`mb-2 font-semibold text-${p.color}-400`}>{p.name}</h4>
                <div class="mb-2 rounded bg-gray-800 p-2">
                  <pre class="text-xs text-gray-300">{p.diagram}</pre>
                </div>
                <p class="text-xs text-gray-400">{p.desc}</p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- 技術スタック -->
      <div class="section-card">
        <h3 class="mb-3 text-lg font-semibold text-green-400">技術スタック</h3>
        <div class="grid grid-cols-2 gap-6 md:grid-cols-4">
          {
            data.techStack.categories.map((cat: any) => (
              <div>
                <h4 class="mb-3 text-sm font-semibold text-yellow-400">{cat.title}</h4>
                <div class="space-y-2">
                  {cat.items.map((it: any) => (
                    <div class="flex items-center space-x-2">
                      <div class={`h-2 w-2 rounded bg-${it.color}-400`} />
                      <span class="text-sm text-gray-300">{it.name}</span>
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</Layout>
