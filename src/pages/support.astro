---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { computeUnifiedScale } from '../lib/chart/scale';
// Experimental component extraction (dev parity)
// (Removed experimental chart component imports)
// @ts-ignore
import data from '../data/support.yml';

interface ExperienceItem {
  title: string;
  category?: string[]; // 複数カテゴリ
  architecture?: string; // 単一パターン
  description?: string;
  uses?: number; // (仕様#3 未決定: 現状は1と同義)
}
// REFACTOR-STAGE2: experiences 読み込み → 汎用 data adapter 化検討 (将来 /src/lib/data/experiences.ts)
const experiences: ExperienceItem[] = (data as any).experiences ?? [];

// 指定順序: 既存クラウド分類
// REFACTOR-STAGE2 DUPLICATION: 並列チャート (カテゴリ / パターン) 間で同様の "ターゲット配列→集計→stats[]" パターンが存在
const targetCategories = [
  'Compute',
  'Database',
  'Storage',
  'Application Integration',
  'Network & Content Delivery',
  'Developer Tools',
  'Financial Management',
  'Analytics',
  'Security Identity & Compliance',
];
type CatStat = { name: string; total: number };
const catStats: CatStat[] = targetCategories.map(name => ({ name, total: 0 }));
for (const exp of experiences) {
  const cats = Array.isArray(exp.category) ? exp.category : [];
  for (const c of cats) {
    const key = c === 'Application integrations' ? 'Application Integration' : c;
    const stat = catStats.find(s => s.name === key);
    if (stat) stat.total += 1; // uses 未適用（仕様#3 決定前）
  }
}

// 個別スケール計算は廃止し unified スケールを使用

// カテゴリごとの明確な配色
// REFACTOR-STAGE2 NOTE: color マップは後で CSS カスタムプロパティへ移行予定 (Stage4)
interface CatStyle {
  color: string;
}
const categoryStyles: Record<string, CatStyle> = {
  Compute: { color: 'purple' },
  Database: { color: 'yellow' },
  Storage: { color: 'teal' },
  'Application Integration': { color: 'blue' },
  'Network & Content Delivery': { color: 'red' },
  'Developer Tools': { color: 'orange' },
  'Financial Management': { color: 'green' },
  Analytics: { color: 'cyan' },
  'Security Identity & Compliance': { color: 'pink' },
};
function catStyle(name: string): CatStyle {
  return categoryStyles[name] || { color: 'cyan' };
}

// 表示用: カテゴリ日本語ラベルマップ（内部集計キーは英語維持）
// REFACTOR-STAGE2 DUPLICATION: patternLabelMap と構造類似 → i18n/labels.ts 集約候補
const catLabelMap: Record<string, string> = {
  Compute: 'コンピュート',
  Database: 'データベース',
  Storage: 'ストレージ',
  'Application Integration': 'アプリケーション統合',
  'Network & Content Delivery': 'ネットワーク / コンテンツ配信',
  'Developer Tools': '開発ツール',
  'Financial Management': 'コスト管理',
  Analytics: '分析',
  'Security Identity & Compliance': 'セキュリティ / ID / コンプライアンス',
};
const catLabel = (name: string) => catLabelMap[name] || name;

// アプリケーションアーキテクチャ カテゴリ
// REFACTOR-STAGE2: patternCategories も targetCategories と同じ集計 DSL で統合抽象化可能
const patternCategories = [
  'Data-Centric',
  'Layered',
  'Component-Based',
  'Service-Oriented',
  'Distributed System',
  'Domain-Driven',
  'Event-Driven',
  'Separation Of Concern',
  'Interpreter',
  'Concurrency',
];
type PatternStat = { name: string; total: number; color: string };
const palette = [
  'cyan',
  'blue',
  'green',
  'purple',
  'yellow',
  'orange',
  'teal',
  'pink',
  'red',
  'cyan',
] as const;
// 単一パターンに統一: pattern 情報は保持しない
// REFACTOR-STAGE2: stats 構造 (name,total,color) は CatStat と部分的に共通。Generics 抽出予定 Stage5/6。
const patternStats: PatternStat[] = patternCategories.map((name, i) => ({
  name,
  total: 0,
  color: palette[i % palette.length] as string,
}));
for (const exp of experiences) {
  const arch = exp.architecture;
  if (!arch) continue;
  const stat = patternStats.find(p => p.name === arch);
  if (stat) stat.total += 1; // uses 未適用（仕様#3 決定前）
}

// 統一Y軸スケール: 両チャートで同じ高さ基準を共有 (computeUnifiedScale は util 化済)
// REFACTOR-STAGE2 DUPLICATION: 似たスケール計算が再出現する場合 lib/chart/scale.ts へ抽出
const allValues = [...catStats.map(c => c.total), ...patternStats.map(p => p.total)];
const unified = computeUnifiedScale(allValues);
const yMax = unified.yMax;
const catTicks = unified.ticks;
const patternYMax = unified.yMax;
const patternTicks = unified.ticks;

// パターン日本語ラベル
const patternLabelMap: Record<string, string> = {
  'Data-Centric': 'データ中心',
  Layered: 'レイヤード',
  'Component-Based': 'コンポーネント指向',
  'Service-Oriented': 'サービス指向',
  'Distributed System': '分散システム',
  'Domain-Driven': 'ドメイン駆動',
  'Event-Driven': 'イベント駆動',
  'Separation Of Concern': '関心分離',
  Interpreter: 'インタプリタ',
  Concurrency: '並行処理',
};
const patternLabel = (name: string) => patternLabelMap[name] || name;
---

<Layout title="アーキテクチャ - i7s7-ymp Portfolio">
  <PageHeader
    title={data.header.title}
    subtitle={data.header.subtitle}
    icon={data.header.icon}
    iconBgClass={data.header.iconBgClass}
  />
  <div class="chart-toggle-wrapper" role="group" aria-label="チャート種別切替">
    <button
      type="button"
      class="chart-toggle-btn active"
      data-chart-toggle
      data-target="cloud"
      aria-pressed="true"
      aria-controls="cloud-chart-section">クラウド</button
    >
    <button
      type="button"
      class="chart-toggle-btn"
      data-chart-toggle
      data-target="app"
      aria-pressed="false"
      aria-controls="app-chart-section">アプリ</button
    >
  </div>
  <section
    class="cloud-arch-section chart-section"
    aria-labelledby="cloud-arch-title"
    id="cloud-chart-section"
  >
    {
      /** REFACTOR-STAGE2 BLOCK START: BaseChart-like 構造 (grid -> bars -> labels -> note). dom/class を変えないまま将来 <Chart/> に抽出 */
    }
    <h3 id="cloud-arch-title" class="mb-6 text-lg font-semibold text-cyan-400">
      クラウドアーキテクチャ
    </h3>
    <div class="chart-wrapper">
      <div
        class="vchart"
        role="img"
        aria-label={`クラウドカテゴリ別運用件数 Y軸最大 ${yMax}`}
        aria-describedby="cat-note"
      >
        <div class="plot" data-count={catStats.length}>
          <div class="grid-y" aria-hidden="true">
            {
              catTicks.map(t => {
                const pct = (t / yMax) * 100;
                const top = 100 - pct;
                return (
                  <div class="grid-row" style={`top:${top}%;`}>
                    <span class="grid-line" />
                    <span class="grid-label">{t}</span>
                  </div>
                );
              })
            }
          </div>
          <div class="bars" data-count={catStats.length} style="--bar-w:70px;">
            {
              catStats.map(cat => {
                const hPct = cat.total === 0 ? 0 : (cat.total / yMax) * 100;
                const isHigh = hPct > 90;
                const isTall = hPct > 38; // 視認性閾値: 値ラベルを内部に収める境界
                const { color } = catStyle(cat.name);
                const id = `cat-${cat.name.replace(/\s+/g, '-').toLowerCase()}`;
                return (
                  <div
                    class="bar-box"
                    style={`--h:${hPct}%;`}
                    data-color={color}
                    data-id={id}
                    data-zero={cat.total === 0}
                    title={`${catLabel(cat.name)}: ${cat.total}件`}
                    data-high={isHigh}
                    data-tall={isTall}
                  >
                    <div class="bar-hit" aria-label={`${catLabel(cat.name)} ${cat.total}件`}>
                      <span class="bar-fill" />
                      <span class="bar-value font-mono">{cat.total}</span>
                    </div>
                  </div>
                );
              })
            }
          </div>
          <div class="axis-x" aria-hidden="true"></div>
        </div>
        <div class="bar-labels" aria-hidden="false">
          {
            catStats.map(cat => {
              const { color } = catStyle(cat.name);
              const id = `cat-${cat.name.replace(/\s+/g, '-').toLowerCase()}`;
              return (
                <div
                  class="x-label badge-pill"
                  data-color={color}
                  data-id={id}
                  tabindex="0"
                  aria-label={`${catLabel(cat.name)} カテゴリ`}
                >
                  {catLabel(cat.name)}
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
    <p id="cat-note" class="chart-note unified-note" aria-label="カテゴリ分類注釈">
      ※ カテゴリ区分は主に AWS サービス分類 (Console / Docs, 2025年時点)
      を参考にしつつポートフォリオ用途で簡略化・統合しています。
    </p>
    {/** Experimental duplicate cloud chart removed */}
  </section>
  <script>
    // @ts-nocheck 単一プロバイダ版: バー/ラベル相互ハイライト
    document.addEventListener('DOMContentLoaded', () => {
      function attachChartInteractions(chartSelector) {
        const chartEl = document.querySelector(chartSelector);
        if (!chartEl) return;
        const bars = Array.from(chartEl.querySelectorAll('.bar-box'));
        const labels = Array.from(chartEl.querySelectorAll('.bar-labels .x-label'));
        const activate = id => {
          bars.forEach(b => b.classList.toggle('active', !!id && b.dataset.id === id));
          labels.forEach(l => {
            const on = !!id && l.dataset.id === id;
            l.classList.toggle('active', on);
            l.classList.toggle('glow', on); // 追加: 光るエフェクト
          });
        };
        const clear = () => activate(null);
        bars.forEach(b => {
          const id = b.dataset.id || '';
          const hit = b.querySelector('.bar-hit');
          if (hit) hit.tabIndex = 0;
          ['mouseenter', 'focus'].forEach(ev => b.addEventListener(ev, () => activate(id)));
          ['mouseleave', 'blur'].forEach(ev => b.addEventListener(ev, clear));
          b.addEventListener('click', () => activate(id));
          b.addEventListener('keydown', e => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              activate(id);
            }
            if (e.key === 'Escape') clear();
          });
        });
        labels.forEach(l => {
          const id = l.dataset.id || '';
          ['mouseenter', 'focus'].forEach(ev => l.addEventListener(ev, () => activate(id)));
          ['mouseleave', 'blur'].forEach(ev => l.addEventListener(ev, clear));
          l.addEventListener('click', () => activate(id));
          l.addEventListener('keydown', e => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              activate(id);
            } else if (e.key === 'Escape') clear();
          });
        });
      }
      // クラウド & アプリ両方に適用
      attachChartInteractions('.vchart');
      attachChartInteractions('.pchart');
      // Esc で全解除
      document.addEventListener('keydown', e => {
        if (e.key === 'Escape') {
          document
            .querySelectorAll('.badge-pill.active, .badge-pill.glow, .bar-box.active')
            .forEach(el => {
              el.classList.remove('active', 'glow');
            });
        }
      });
      // トグル制御
      const toggleButtons = Array.from(document.querySelectorAll('[data-chart-toggle]'));
      const cloudSection = document.getElementById('cloud-chart-section');
      const appSection = document.getElementById('app-chart-section');
      function setChart(which) {
        if (!cloudSection || !appSection) return;
        const showCloud = which === 'cloud';
        cloudSection.hidden = !showCloud;
        appSection.hidden = showCloud;
        toggleButtons.forEach(btn => {
          const active = btn.dataset.target === which;
          btn.classList.toggle('active', active);
          btn.setAttribute('aria-pressed', String(active));
        });
      }
      toggleButtons.forEach(btn => {
        btn.addEventListener('click', () => setChart(btn.dataset.target));
        btn.addEventListener('keydown', e => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            setChart(btn.dataset.target);
          }
          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
            e.preventDefault();
            const idx = toggleButtons.indexOf(btn);
            const dir = e.key === 'ArrowRight' ? 1 : -1;
            const next = (idx + dir + toggleButtons.length) % toggleButtons.length;
            toggleButtons[next].focus();
          }
        });
      });
      setChart('cloud');
    });
  </script>

  {/** Parity harness removed */}

  <section
    class="patterns-section chart-section"
    aria-labelledby="pattern-chart-title"
    id="app-chart-section"
    hidden
  >
    {/** REFACTOR-STAGE2 BLOCK START: 重複チャート構造 (cloud と対) */}
    <h3 id="pattern-chart-title" class="mb-6 text-lg font-semibold text-green-400">
      アプリケーションパターン
    </h3>
    <div class="chart-wrapper">
      <div
        class="pchart"
        role="img"
        aria-label={`アプリケーションパターン出現数 Y軸最大 ${patternYMax}`}
        aria-describedby="pattern-note"
      >
        <div class="plot" data-count={patternStats.length}>
          <div class="grid-y" aria-hidden="true">
            {
              patternTicks.map(t => {
                const pct = (t / patternYMax) * 100;
                const top = 100 - pct;
                return (
                  <div class="grid-row" style={`top:${top}%;`}>
                    <span class="grid-line" />
                    <span class="grid-label">{t}</span>
                  </div>
                );
              })
            }
          </div>
          <div class="bars pattern-bars" data-count={patternStats.length} style="--bar-w:60px;">
            {
              patternStats.map(p => {
                const hPct = p.total === 0 ? 0 : (p.total / patternYMax) * 100;
                const id = `pat-${p.name.replace(/\s+/g, '-').toLowerCase()}`;
                const isHigh = hPct > 90;
                const isTall = hPct > 38;
                return (
                  <div
                    class="bar-box"
                    style={`--h:${hPct}%;`}
                    data-color={p.color}
                    data-id={id}
                    data-zero={p.total === 0}
                    data-high={isHigh}
                    data-tall={isTall}
                  >
                    <div class="bar-hit" aria-label={`${patternLabel(p.name)} ${p.total}件`}>
                      <span class="bar-fill" />
                      <span class="bar-value font-mono">{p.total}</span>
                    </div>
                  </div>
                );
              })
            }
          </div>
          <div class="axis-x" aria-hidden="true"></div>
        </div>
        <div class="bar-labels pattern-labels" aria-hidden="false">
          {
            patternStats.map(p => {
              const id = `pat-${p.name.replace(/\s+/g, '-').toLowerCase()}`;
              return (
                <div
                  class="x-label badge-pill"
                  data-color={p.color}
                  data-id={id}
                  tabindex="0"
                  aria-label={`${patternLabel(p.name)} パターン`}
                >
                  {patternLabel(p.name)}
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
    <p id="pattern-note" class="chart-note unified-note">
      ※ 値は experiences の件数（1エントリー=1）です。uses 反映ロジック(仕様#3) 未適用。
    </p>
    {/** Experimental duplicate pattern chart removed */}
  </section>
</Layout>

<!-- refactor markers present; provider switch legacy removed -->

<style>
  @import '../styles/chart-base.css';
</style>

<!-- provider switch 用スタイル削除 -->
