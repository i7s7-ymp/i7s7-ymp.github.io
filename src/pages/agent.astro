---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Layout title="AI Agent - i7s7-ymp Portfolio">
  <div class="flex h-full min-h-0 flex-col">
    <PageHeader
      title="AI Agent Chat"
      subtitle="i7s7-ympのパーソナルAIアシスタント"
      icon="🤖"
      statusLabel="オンライン"
    />

    <!-- メインチャットエリア -->
    <div class="flex min-h-0 flex-1 space-x-6">
      <!-- チャットコンテナ -->
      <div
        class="flex min-h-0 flex-1 flex-col rounded-2xl border border-primary-600/30 bg-dark-900/80 shadow-2xl backdrop-blur-md"
      >
        <!-- チャットヘッダー -->
        <div class="border-b border-primary-600/30 p-4">
          <div class="flex items-center space-x-3">
            <div class="relative">
              <div
                class="flex h-12 w-12 items-center justify-center rounded-full bg-gradient-to-r from-accent-blue to-accent-cyan shadow-lg"
              >
                <span class="text-xl">🎯</span>
              </div>
              <div
                class="absolute -bottom-1 -right-1 h-4 w-4 rounded-full border-2 border-dark-900 bg-accent-neon"
              >
              </div>
            </div>
            <div>
              <h3 class="font-semibold text-white">i7s7-ymp AI</h3>
              <p class="text-sm text-slate-400">エンジニア・クリエイター</p>
            </div>
          </div>
        </div>

        <!-- チャットメッセージエリア -->
        <div id="chat-messages" class="min-h-0 flex-1 space-y-4 overflow-y-auto p-4">
          <!-- 初期メッセージ -->
          <div class="flex items-start space-x-3">
            <div
              class="flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-r from-primary-500 to-accent-pink"
            >
              <span class="text-sm">🎯</span>
            </div>
            <div class="flex-1">
              <div class="rounded-2xl bg-primary-600/20 p-3 backdrop-blur-sm">
                <p class="text-white">こんにちは！i7s7-ympのAIアシスタントです✨</p>
                <p class="mt-1 text-primary-200">
                  私の経歴、スキル、プロジェクトについて何でも聞いてください！
                </p>
              </div>
              <p class="mt-1 text-xs text-primary-400">たった今</p>
            </div>
          </div>
        </div>

        <!-- チャット入力エリア -->
        <div class="border-t border-primary-500/30 p-4">
          <div class="flex items-center space-x-3">
            <div class="relative flex-1">
              <input
                type="text"
                id="chat-input"
                placeholder="メッセージを入力してください..."
                class="w-full rounded-xl border border-primary-500/30 bg-dark-800/50 px-4 py-3 text-white placeholder-primary-400 backdrop-blur-sm focus:border-primary-400 focus:outline-none focus:ring-2 focus:ring-primary-400/20"
                autocomplete="off"
              />
            </div>
            <button
              id="send-btn"
              class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-r from-primary-500 to-accent-pink text-white transition-all hover:scale-105 hover:shadow-lg"
            >
              <span class="text-xl">➤</span>
            </button>
          </div>
        </div>
      </div>

      <!-- サイドパネル - プロフィール情報 -->
      <div class="flex h-full w-80 flex-shrink-0 flex-col space-y-4">
        <!-- アバター & ステータス -->
        <div
          class="rounded-2xl border border-primary-500/30 bg-dark-900/80 p-6 shadow-2xl backdrop-blur-md"
        >
          <div class="text-center">
            <div class="relative mx-auto mb-4 h-24 w-24">
              <div
                class="flex h-full w-full animate-glow items-center justify-center rounded-full bg-gradient-to-r from-primary-500 via-accent-pink to-accent-cyan shadow-lg"
              >
                <span class="text-3xl font-bold text-white">i7</span>
              </div>
              <div
                class="absolute -bottom-2 -right-2 h-6 w-6 animate-pulse rounded-full border-2 border-dark-900 bg-accent-neon"
              >
              </div>
            </div>
            <h3 class="text-xl font-bold text-white">i7s7-ymp</h3>
            <p class="text-primary-300">Full Stack Developer</p>
            <p class="text-sm text-primary-400">Creative Technologist</p>
          </div>
        </div>

        <!-- クイック質問 -->
        <div
          class="hide-scrollbar flex-1 overflow-y-auto rounded-2xl border border-primary-500/30 bg-dark-900/80 p-4 shadow-2xl backdrop-blur-md"
        >
          <h4 class="mb-3 font-semibold text-white">💡 よくある質問</h4>
          <div class="space-y-2">
            <button
              class="quick-question w-full rounded-lg bg-primary-600/20 p-3 text-left text-sm text-primary-200 transition-colors hover:bg-primary-600/30"
            >
              経歴について教えて
            </button>
            <button
              class="quick-question w-full rounded-lg bg-primary-600/20 p-3 text-left text-sm text-primary-200 transition-colors hover:bg-primary-600/30"
            >
              得意な技術スタックは？
            </button>
            <button
              class="quick-question w-full rounded-lg bg-primary-600/20 p-3 text-left text-sm text-primary-200 transition-colors hover:bg-primary-600/30"
            >
              最近のプロジェクトは？
            </button>
            <button
              class="quick-question w-full rounded-lg bg-primary-600/20 p-3 text-left text-sm text-primary-200 transition-colors hover:bg-primary-600/30"
            >
              趣味や興味のあることは？
            </button>
          </div>
        </div>

        <!-- スキル概要 -->
        <!-- 主要スキルセクション削除済み -->
      </div>
    </div>
  </div>

  <script>
    // チャット機能の詳細な実装
    const chatMessages = document.getElementById('chat-messages');
    const chatInput = document.getElementById('chat-input') as HTMLInputElement;
    const sendBtn = document.getElementById('send-btn');
    const quickQuestions = document.querySelectorAll('.quick-question');

    // i7s7-ympの詳細な経歴データ
    const profileData = {
      career: {
        title: 'エンジニアとしてのキャリア',
        content:
          'Webエンジニアとして5年以上の経験があります。フロントエンドからバックエンド、インフラまで幅広く携わっています。特にReact、Vue.js、Node.js、Pythonを得意としており、最近はAI/ML分野にも注力しています。',
      },
      skills: {
        title: '技術スキル',
        content:
          '【Frontend】React, Vue.js, TypeScript, Tailwind CSS\n【Backend】Node.js, Python, Go, PostgreSQL\n【Infrastructure】Docker, Kubernetes, AWS, GCP\n【AI/ML】TensorFlow, PyTorch, OpenAI API\n【Others】Git, CI/CD, Agile development',
      },
      projects: {
        title: '最近のプロジェクト',
        content:
          '最近は、このポートフォリオサイト（Astro + TypeScript + Tailwind）の開発や、AIを活用したコードレビューボット、自動タスクスケジューラーなどを手がけています。すべてのプロジェクトでユーザー体験を重視した設計を心がけています。',
      },
      interests: {
        title: '趣味・興味',
        content:
          '新しい技術の探求が大好きです。特にWeb3、AR/VR、AIの可能性に興味があります。プライベートでは音楽制作、ゲーム開発、写真撮影も楽しんでいます。クリエイティブな活動と技術を組み合わせることに情熱を注いでいます。',
      },
    };

    // AIレスポンス生成
    function generateResponse(userMessage: string): string {
      const message = userMessage.toLowerCase();

      if (message.includes('経歴') || message.includes('キャリア') || message.includes('仕事')) {
        return profileData.career.content;
      } else if (
        message.includes('技術') ||
        message.includes('スキル') ||
        message.includes('言語')
      ) {
        return profileData.skills.content;
      } else if (
        message.includes('プロジェクト') ||
        message.includes('作品') ||
        message.includes('開発')
      ) {
        return profileData.projects.content;
      } else if (message.includes('趣味') || message.includes('興味') || message.includes('好き')) {
        return profileData.interests.content;
      } else if (message.includes('こんにちは') || message.includes('はじめまして')) {
        return 'こんにちは！i7s7-ympです。Webエンジニア兼クリエイターとして活動しています。技術的なことから趣味のことまで、何でもお気軽に聞いてくださいね！✨';
      } else if (message.includes('ありがとう')) {
        return 'どういたしまして！他にも何か知りたいことがあれば、いつでもお聞きください😊';
      } else {
        const responses = [
          '面白い質問ですね！もう少し詳しく教えていただけますか？',
          'その分野について詳しく話せます。具体的にはどの部分が気になりますか？',
          '技術的なことなら何でもお答えできます！',
          'プログラミングやクリエイティブな作業について話すのが大好きです！',
          'どんなプロジェクトや技術に興味をお持ちですか？',
        ];
        return (
          responses[Math.floor(Math.random() * responses.length)] ||
          '申し訳ありませんが、うまく回答できませんでした。別の質問をしてみてください。'
        );
      }
    }

    // メッセージを追加
    function addMessage(content: string, isUser: boolean = false) {
      if (!chatMessages) return;

      const messageDiv = document.createElement('div');
      messageDiv.className = 'flex items-start space-x-3';

      const now = new Date();
      const timeStr = now.toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' });

      if (isUser) {
        messageDiv.innerHTML = `
          <div class="flex-1 flex justify-end">
            <div>
              <div class="rounded-2xl bg-gradient-to-r from-primary-500 to-accent-pink p-3 backdrop-blur-sm">
                <p class="text-white">${content}</p>
              </div>
              <p class="text-xs text-primary-400 mt-1 text-right">${timeStr}</p>
            </div>
          </div>
          <div class="flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-r from-accent-cyan to-accent-neon">
            <span class="text-sm">👤</span>
          </div>
        `;
      } else {
        messageDiv.innerHTML = `
          <div class="flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-r from-primary-500 to-accent-pink">
            <span class="text-sm">🎯</span>
          </div>
          <div class="flex-1">
            <div class="rounded-2xl bg-primary-600/20 p-3 backdrop-blur-sm">
              <p class="text-white whitespace-pre-line">${content}</p>
            </div>
            <p class="text-xs text-primary-400 mt-1">${timeStr}</p>
          </div>
        `;
      }

      chatMessages.appendChild(messageDiv);
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    // メッセージ送信
    function sendMessage() {
      if (!chatInput) return;

      const message = chatInput.value.trim();
      if (!message) return;

      // ユーザーメッセージを表示
      addMessage(message, true);
      chatInput.value = '';

      // AIの返答をタイピング風に表示
      setTimeout(
        () => {
          const response = generateResponse(message);
          addMessage(response, false);
        },
        500 + Math.random() * 1000
      );
    }

    // イベントリスナー
    if (sendBtn) {
      sendBtn.addEventListener('click', sendMessage);
    }

    if (chatInput) {
      chatInput.addEventListener('keypress', e => {
        if (e.key === 'Enter') {
          sendMessage();
        }
      });
    }

    // クイック質問
    quickQuestions.forEach(btn => {
      btn.addEventListener('click', () => {
        const question = (btn as HTMLElement).textContent;
        if (question && chatInput) {
          chatInput.value = question;
          sendMessage();
        }
      });
    });
  </script>
  <style>
    /* チャット欄スクロールバー非表示 */
    #chat-messages {
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    #chat-messages::-webkit-scrollbar {
      display: none;
    }
    /* サイドパネルスクロールバー非表示 */
    .hide-scrollbar {
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .hide-scrollbar::-webkit-scrollbar {
      display: none;
    }
  </style>
</Layout>
