---
import Layout from '../layouts/Layout.astro';
---

<Layout title="AI Agent - i7s7-ymp Portfolio">
  <div class="flex h-full flex-col">
    <!-- ヘッダー -->
    <div
      class="mb-6 rounded-2xl border border-primary-500/30 bg-gradient-to-r from-primary-600/20 to-accent-pink/20 p-6 shadow-2xl backdrop-blur-md"
    >
      <div class="flex items-center space-x-4">
        <div
          class="flex h-16 w-16 animate-glow items-center justify-center rounded-2xl bg-neon-gradient shadow-lg"
        >
          <span class="text-2xl font-bold text-white">🤖</span>
        </div>
        <div>
          <h1
            class="bg-gradient-to-r from-white to-primary-200 bg-clip-text text-3xl font-bold text-transparent"
          >
            AI Agent Chat
          </h1>
          <p class="text-lg text-primary-200">i7s7-ympのパーソナルAIアシスタント</p>
        </div>
        <div class="ml-auto flex items-center space-x-2">
          <div class="h-3 w-3 animate-pulse rounded-full bg-accent-neon"></div>
          <span class="text-sm text-primary-200">オンライン</span>
        </div>
      </div>
    </div>

    <!-- メインチャットエリア -->
    <div class="flex flex-1 space-x-6">
      <!-- チャットコンテナ -->
      <div
        class="flex flex-1 flex-col rounded-2xl border border-primary-500/30 bg-dark-900/80 shadow-2xl backdrop-blur-md"
      >
        <!-- チャットヘッダー -->
        <div class="border-b border-primary-500/30 p-4">
          <div class="flex items-center space-x-3">
            <div class="relative">
              <div
                class="flex h-12 w-12 items-center justify-center rounded-full bg-gradient-to-r from-primary-500 to-accent-pink shadow-lg"
              >
                <span class="text-xl">🎯</span>
              </div>
              <div
                class="absolute -bottom-1 -right-1 h-4 w-4 rounded-full border-2 border-dark-900 bg-accent-neon"
              >
              </div>
            </div>
            <div>
              <h3 class="font-semibold text-white">i7s7-ymp AI</h3>
              <p class="text-sm text-primary-300">エンジニア・クリエイター</p>
            </div>
          </div>
        </div>

        <!-- チャットメッセージエリア -->
        <div
          id="chat-messages"
          class="flex-1 space-y-4 overflow-y-auto p-4"
          style="max-height: 400px;"
        >
          <!-- 初期メッセージ -->
          <div class="flex items-start space-x-3">
            <div
              class="flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-r from-primary-500 to-accent-pink"
            >
              <span class="text-sm">🎯</span>
            </div>
            <div class="flex-1">
              <div class="rounded-2xl bg-primary-600/20 p-3 backdrop-blur-sm">
                <p class="text-white">こんにちは！i7s7-ympのAIアシスタントです✨</p>
                <p class="mt-1 text-primary-200">
                  私の経歴、スキル、プロジェクトについて何でも聞いてください！
                </p>
              </div>
              <p class="mt-1 text-xs text-primary-400">たった今</p>
            </div>
          </div>
        </div>

        <!-- チャット入力エリア -->
        <div class="border-t border-primary-500/30 p-4">
          <div class="flex items-center space-x-3">
            <div class="relative flex-1">
              <input
                type="text"
                id="chat-input"
                placeholder="メッセージを入力してください..."
                class="w-full rounded-xl border border-primary-500/30 bg-dark-800/50 px-4 py-3 text-white placeholder-primary-400 backdrop-blur-sm focus:border-primary-400 focus:outline-none focus:ring-2 focus:ring-primary-400/20"
                autocomplete="off"
              />
            </div>
            <button
              id="send-btn"
              class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-r from-primary-500 to-accent-pink text-white transition-all hover:scale-105 hover:shadow-lg"
            >
              <span class="text-xl">➤</span>
            </button>
          </div>
        </div>
      </div>

      <!-- サイドパネル - プロフィール情報 -->
      <div class="w-80 space-y-4">
        <!-- アバター & ステータス -->
        <div
          class="rounded-2xl border border-primary-500/30 bg-dark-900/80 p-6 shadow-2xl backdrop-blur-md"
        >
          <div class="text-center">
            <div class="relative mx-auto mb-4 h-24 w-24">
              <div
                class="flex h-full w-full animate-glow items-center justify-center rounded-full bg-gradient-to-r from-primary-500 via-accent-pink to-accent-cyan shadow-lg"
              >
                <span class="text-3xl font-bold text-white">i7</span>
              </div>
              <div
                class="absolute -bottom-2 -right-2 h-6 w-6 animate-pulse rounded-full border-2 border-dark-900 bg-accent-neon"
              >
              </div>
            </div>
            <h3 class="text-xl font-bold text-white">i7s7-ymp</h3>
            <p class="text-primary-300">Full Stack Developer</p>
            <p class="text-sm text-primary-400">Creative Technologist</p>
          </div>
        </div>

        <!-- クイック質問 -->
        <div
          class="rounded-2xl border border-primary-500/30 bg-dark-900/80 p-4 shadow-2xl backdrop-blur-md"
        >
          <h4 class="mb-3 font-semibold text-white">💡 よくある質問</h4>
          <div class="space-y-2">
            <button
              class="quick-question w-full rounded-lg bg-primary-600/20 p-3 text-left text-sm text-primary-200 transition-colors hover:bg-primary-600/30"
            >
              経歴について教えて
            </button>
            <button
              class="quick-question w-full rounded-lg bg-primary-600/20 p-3 text-left text-sm text-primary-200 transition-colors hover:bg-primary-600/30"
            >
              得意な技術スタックは？
            </button>
            <button
              class="quick-question w-full rounded-lg bg-primary-600/20 p-3 text-left text-sm text-primary-200 transition-colors hover:bg-primary-600/30"
            >
              最近のプロジェクトは？
            </button>
            <button
              class="quick-question w-full rounded-lg bg-primary-600/20 p-3 text-left text-sm text-primary-200 transition-colors hover:bg-primary-600/30"
            >
              趣味や興味のあることは？
            </button>
          </div>
        </div>

        <!-- スキル概要 -->
        <div
          class="rounded-2xl border border-primary-500/30 bg-dark-900/80 p-4 shadow-2xl backdrop-blur-md"
        >
          <h4 class="mb-3 font-semibold text-white">🛠️ 主要スキル</h4>
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-sm text-primary-200">Frontend</span>
              <div class="flex space-x-1">
                <div class="h-2 w-2 rounded-full bg-accent-neon"></div>
                <div class="h-2 w-2 rounded-full bg-accent-neon"></div>
                <div class="h-2 w-2 rounded-full bg-accent-neon"></div>
                <div class="h-2 w-2 rounded-full bg-accent-neon"></div>
                <div class="h-2 w-2 rounded-full bg-primary-600"></div>
              </div>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-primary-200">Backend</span>
              <div class="flex space-x-1">
                <div class="h-2 w-2 rounded-full bg-accent-cyan"></div>
                <div class="h-2 w-2 rounded-full bg-accent-cyan"></div>
                <div class="h-2 w-2 rounded-full bg-accent-cyan"></div>
                <div class="h-2 w-2 rounded-full bg-accent-cyan"></div>
                <div class="h-2 w-2 rounded-full bg-primary-600"></div>
              </div>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-primary-200">AI/ML</span>
              <div class="flex space-x-1">
                <div class="h-2 w-2 rounded-full bg-accent-pink"></div>
                <div class="h-2 w-2 rounded-full bg-accent-pink"></div>
                <div class="h-2 w-2 rounded-full bg-accent-pink"></div>
                <div class="h-2 w-2 rounded-full bg-primary-600"></div>
                <div class="h-2 w-2 rounded-full bg-primary-600"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // チャット機能の詳細な実装
    const chatMessages = document.getElementById('chat-messages');
    const chatInput = document.getElementById('chat-input') as HTMLInputElement;
    const sendBtn = document.getElementById('send-btn');
    const quickQuestions = document.querySelectorAll('.quick-question');

    // i7s7-ympの詳細な経歴データ
    const profileData = {
      career: {
        title: 'エンジニアとしてのキャリア',
        content:
          'Webエンジニアとして5年以上の経験があります。フロントエンドからバックエンド、インフラまで幅広く携わっています。特にReact、Vue.js、Node.js、Pythonを得意としており、最近はAI/ML分野にも注力しています。',
      },
      skills: {
        title: '技術スキル',
        content:
          '【Frontend】React, Vue.js, TypeScript, Tailwind CSS\n【Backend】Node.js, Python, Go, PostgreSQL\n【Infrastructure】Docker, Kubernetes, AWS, GCP\n【AI/ML】TensorFlow, PyTorch, OpenAI API\n【Others】Git, CI/CD, Agile development',
      },
      projects: {
        title: '最近のプロジェクト',
        content:
          '最近は、このポートフォリオサイト（Astro + TypeScript + Tailwind）の開発や、AIを活用したコードレビューボット、自動タスクスケジューラーなどを手がけています。すべてのプロジェクトでユーザー体験を重視した設計を心がけています。',
      },
      interests: {
        title: '趣味・興味',
        content:
          '新しい技術の探求が大好きです。特にWeb3、AR/VR、AIの可能性に興味があります。プライベートでは音楽制作、ゲーム開発、写真撮影も楽しんでいます。クリエイティブな活動と技術を組み合わせることに情熱を注いでいます。',
      },
    };

    // AIレスポンス生成
    function generateResponse(userMessage: string): string {
      const message = userMessage.toLowerCase();

      if (message.includes('経歴') || message.includes('キャリア') || message.includes('仕事')) {
        return profileData.career.content;
      } else if (
        message.includes('技術') ||
        message.includes('スキル') ||
        message.includes('言語')
      ) {
        return profileData.skills.content;
      } else if (
        message.includes('プロジェクト') ||
        message.includes('作品') ||
        message.includes('開発')
      ) {
        return profileData.projects.content;
      } else if (message.includes('趣味') || message.includes('興味') || message.includes('好き')) {
        return profileData.interests.content;
      } else if (message.includes('こんにちは') || message.includes('はじめまして')) {
        return 'こんにちは！i7s7-ympです。Webエンジニア兼クリエイターとして活動しています。技術的なことから趣味のことまで、何でもお気軽に聞いてくださいね！✨';
      } else if (message.includes('ありがとう')) {
        return 'どういたしまして！他にも何か知りたいことがあれば、いつでもお聞きください😊';
      } else {
        const responses = [
          '面白い質問ですね！もう少し詳しく教えていただけますか？',
          'その分野について詳しく話せます。具体的にはどの部分が気になりますか？',
          '技術的なことなら何でもお答えできます！',
          'プログラミングやクリエイティブな作業について話すのが大好きです！',
          'どんなプロジェクトや技術に興味をお持ちですか？',
        ];
        return (
          responses[Math.floor(Math.random() * responses.length)] ||
          '申し訳ありませんが、うまく回答できませんでした。別の質問をしてみてください。'
        );
      }
    }

    // メッセージを追加
    function addMessage(content: string, isUser: boolean = false) {
      if (!chatMessages) return;

      const messageDiv = document.createElement('div');
      messageDiv.className = 'flex items-start space-x-3';

      const now = new Date();
      const timeStr = now.toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' });

      if (isUser) {
        messageDiv.innerHTML = `
          <div class="flex-1 flex justify-end">
            <div>
              <div class="rounded-2xl bg-gradient-to-r from-primary-500 to-accent-pink p-3 backdrop-blur-sm">
                <p class="text-white">${content}</p>
              </div>
              <p class="text-xs text-primary-400 mt-1 text-right">${timeStr}</p>
            </div>
          </div>
          <div class="flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-r from-accent-cyan to-accent-neon">
            <span class="text-sm">👤</span>
          </div>
        `;
      } else {
        messageDiv.innerHTML = `
          <div class="flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-r from-primary-500 to-accent-pink">
            <span class="text-sm">🎯</span>
          </div>
          <div class="flex-1">
            <div class="rounded-2xl bg-primary-600/20 p-3 backdrop-blur-sm">
              <p class="text-white whitespace-pre-line">${content}</p>
            </div>
            <p class="text-xs text-primary-400 mt-1">${timeStr}</p>
          </div>
        `;
      }

      chatMessages.appendChild(messageDiv);
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    // メッセージ送信
    function sendMessage() {
      if (!chatInput) return;

      const message = chatInput.value.trim();
      if (!message) return;

      // ユーザーメッセージを表示
      addMessage(message, true);
      chatInput.value = '';

      // AIの返答をタイピング風に表示
      setTimeout(
        () => {
          const response = generateResponse(message);
          addMessage(response, false);
        },
        500 + Math.random() * 1000
      );
    }

    // イベントリスナー
    if (sendBtn) {
      sendBtn.addEventListener('click', sendMessage);
    }

    if (chatInput) {
      chatInput.addEventListener('keypress', e => {
        if (e.key === 'Enter') {
          sendMessage();
        }
      });
    }

    // クイック質問
    quickQuestions.forEach(btn => {
      btn.addEventListener('click', () => {
        const question = (btn as HTMLElement).textContent;
        if (question && chatInput) {
          chatInput.value = question;
          sendMessage();
        }
      });
    });
  </script>
</Layout>

<!-- AI プロジェクト -->
<div class="rounded-lg border border-green-400/30 bg-gray-800/50 p-4">
  <h3 class="mb-4 text-lg font-semibold text-green-400">
    <span class="text-gray-400">></span> ls ai_projects/
  </h3>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <!-- プロジェクト1 -->
    <div class="rounded-lg border border-blue-400/30 bg-gray-900/50 p-4">
      <h4 class="mb-2 font-semibold text-blue-400">Code Review Bot</h4>
      <p class="mb-3 text-sm text-gray-300">
        GitHubプルリクエストを自動でレビューし、コード品質をチェックするボット
      </p>
      <div class="mb-3 flex flex-wrap gap-2">
        <span class="rounded bg-blue-400/20 px-2 py-1 text-xs text-blue-400">Python</span>
        <span class="rounded bg-green-400/20 px-2 py-1 text-xs text-green-400">GPT-4</span>
        <span class="rounded bg-purple-400/20 px-2 py-1 text-xs text-purple-400">GitHub API</span>
      </div>
      <div class="text-xs text-gray-400">
        Status: <span class="text-green-400">Active</span> • Uptime: 99.8%
      </div>
    </div>

    <!-- プロジェクト2 -->
    <div class="rounded-lg border border-purple-400/30 bg-gray-900/50 p-4">
      <h4 class="mb-2 font-semibold text-purple-400">Smart Task Scheduler</h4>
      <p class="mb-3 text-sm text-gray-300">
        機械学習を使ってタスクの優先度を自動判定し、最適なスケジュールを提案
      </p>
      <div class="mb-3 flex flex-wrap gap-2">
        <span class="rounded bg-purple-400/20 px-2 py-1 text-xs text-purple-400">TensorFlow</span>
        <span class="rounded bg-yellow-400/20 px-2 py-1 text-xs text-yellow-400">ML</span>
        <span class="rounded bg-cyan-400/20 px-2 py-1 text-xs text-cyan-400">FastAPI</span>
      </div>
      <div class="text-xs text-gray-400">
        Status: <span class="text-yellow-400">Beta</span> • Accuracy: 87%
      </div>
    </div>

    <!-- プロジェクト3 -->
    <div class="rounded-lg border border-cyan-400/30 bg-gray-900/50 p-4">
      <h4 class="mb-2 font-semibold text-cyan-400">Data Analysis Agent</h4>
      <p class="mb-3 text-sm text-gray-300">
        自然言語でデータ分析のクエリを受け取り、自動でレポートを生成
      </p>
      <div class="mb-3 flex flex-wrap gap-2">
        <span class="rounded bg-cyan-400/20 px-2 py-1 text-xs text-cyan-400">Pandas</span>
        <span class="rounded bg-orange-400/20 px-2 py-1 text-xs text-orange-400">LangChain</span>
        <span class="rounded bg-red-400/20 px-2 py-1 text-xs text-red-400">Plotly</span>
      </div>
      <div class="text-xs text-gray-400">
        Status: <span class="text-green-400">Production</span> • Queries: 1.2k/day
      </div>
    </div>

    <!-- プロジェクト4 -->
    <div class="rounded-lg border border-green-400/30 bg-gray-900/50 p-4">
      <h4 class="mb-2 font-semibold text-green-400">DevOps Automation</h4>
      <p class="mb-3 text-sm text-gray-300">
        インフラの監視とトラブルシューティングを自動化するAIエージェント
      </p>
      <div class="mb-3 flex flex-wrap gap-2">
        <span class="rounded bg-green-400/20 px-2 py-1 text-xs text-green-400">Kubernetes</span>
        <span class="rounded bg-blue-400/20 px-2 py-1 text-xs text-blue-400">Prometheus</span>
        <span class="rounded bg-pink-400/20 px-2 py-1 text-xs text-pink-400">Slack Bot</span>
      </div>
      <div class="text-xs text-gray-400">
        Status: <span class="text-green-400">Running</span> • Incidents: -73%
      </div>
    </div>
  </div>
</div>

<!-- システムログ -->
<div class="rounded-lg border border-green-400/30 bg-gray-800/50 p-4">
  <h3 class="mb-4 text-lg font-semibold text-green-400">
    <span class="text-gray-400">></span> tail -f system.log
  </h3>
  <div class="max-h-48 space-y-1 overflow-y-auto rounded-lg bg-black p-4 font-mono text-xs">
    <div id="log-container">
      <div class="text-gray-400">[2024-01-15 15:30:01] INFO: Agent initialized successfully</div>
      <div class="text-green-400">[2024-01-15 15:30:02] SUCCESS: ML models loaded</div>
      <div class="text-blue-400">[2024-01-15 15:30:03] INFO: API endpoints ready</div>
      <div class="text-yellow-400">[2024-01-15 15:30:04] WARN: High CPU usage detected</div>
      <div class="text-green-400">[2024-01-15 15:30:05] SUCCESS: Auto-scaling triggered</div>
      <div class="text-gray-400">[2024-01-15 15:30:06] INFO: Backup completed</div>
    </div>
  </div>
</div>

<script>
  // チャット機能
  const chatContainer = document.getElementById('chat-container');
  const userInput = document.getElementById('user-input');
  const sendButton = document.getElementById('send-button');

  const responses = [
    '面白い質問ですね！技術的な詳細についてお話ししましょう。',
    'それは私の専門分野の一つです。どの部分について詳しく知りたいですか？',
    '良いポイントですね。実際のプロジェクトでも同様の課題に取り組んでいます。',
    'プログラミングについてなら何でもお任せください！',
    'その技術については実装経験があります。具体的にどんなことを知りたいですか？',
    'AIと機械学習について話すのは大好きです！',
    'コードレビューも得意です。何かお手伝いできることはありますか？',
  ];

  function addMessage(sender: string, message: string, isUser = false) {
    const messageDiv = document.createElement('div');
    messageDiv.className = 'flex items-start space-x-2';
    messageDiv.innerHTML = `
        <span class="font-mono ${isUser ? 'text-green-400' : 'text-blue-400'}">${sender}:</span>
        <span class="text-gray-300">${message}</span>
      `;
    if (chatContainer) {
      chatContainer.appendChild(messageDiv);
      chatContainer.scrollTop = chatContainer.scrollHeight;
    }
  }

  function sendMessage() {
    if (!userInput) return;

    const message = (userInput as HTMLInputElement).value.trim();
    if (!message) return;

    addMessage('You', message, true);
    (userInput as HTMLInputElement).value = '';

    // 簡単なレスポンス生成
    setTimeout(
      () => {
        const randomResponse = responses[Math.floor(Math.random() * responses.length)];
        if (randomResponse) {
          addMessage('Agent', randomResponse);
        }
      },
      500 + Math.random() * 1000
    );
  }

  if (sendButton) {
    sendButton.addEventListener('click', sendMessage);
  }

  if (userInput) {
    userInput.addEventListener('keypress', e => {
      if (e.key === 'Enter') {
        sendMessage();
      }
    });
  }

  // ログの動的更新
  const logContainer = document.getElementById('log-container');
  const logMessages = [
    { level: 'INFO', message: 'Processing user request' },
    { level: 'SUCCESS', message: 'Task completed successfully' },
    { level: 'INFO', message: 'System health check passed' },
    { level: 'WARN', message: 'Memory usage high' },
    { level: 'SUCCESS', message: 'Garbage collection completed' },
    { level: 'INFO', message: 'New model deployed' },
  ];

  function addLogEntry() {
    if (!logContainer) return;

    const now = new Date();
    const timestamp = now.toISOString().replace('T', ' ').substring(0, 19);
    const randomLog = logMessages[Math.floor(Math.random() * logMessages.length)];

    if (!randomLog) return;

    const logDiv = document.createElement('div');
    const colors: Record<string, string> = {
      INFO: 'text-gray-400',
      SUCCESS: 'text-green-400',
      WARN: 'text-yellow-400',
      ERROR: 'text-red-400',
    };

    logDiv.className = colors[randomLog.level] || 'text-gray-400';
    logDiv.textContent = `[${timestamp}] ${randomLog.level}: ${randomLog.message}`;

    logContainer.appendChild(logDiv);

    // 古いログエントリを削除
    if (logContainer.children.length > 20) {
      const firstChild = logContainer.firstChild;
      if (firstChild) {
        logContainer.removeChild(firstChild);
      }
    }

    logContainer.scrollTop = logContainer.scrollHeight;
  }

  // 定期的にログを追加
  setInterval(addLogEntry, 3000);
</script>
