---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home - i7s7-ymp Portfolio">
  <div class="space-y-6">
    <!-- ターミナル風ヘッダー -->
    <div class="rounded-lg border border-green-400/30 bg-gray-800/50 p-4">
      <div class="mb-2 text-green-400">
        <span class="text-gray-400">$</span> cat README.md
      </div>
      <div class="space-y-2">
        <h2 class="text-2xl font-bold text-green-400"># Welcome to i7s7-ymp's Portfolio</h2>
        <p class="text-gray-300">
          > A passionate developer exploring the intersection of technology and creativity
        </p>
      </div>
    </div>

    <!-- プロフィール情報 -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      <!-- About -->
      <div class="rounded-lg border border-green-400/30 bg-gray-800/50 p-4">
        <h3 class="mb-3 text-lg font-semibold text-green-400">
          <span class="text-gray-400">></span> whoami
        </h3>
        <div class="space-y-2 text-gray-300">
          <p class="text-sm">
            <span class="text-green-400">name:</span> "i7s7-ymp"<br />
            <span class="text-green-400">role:</span> "Full Stack Developer"<br />
            <span class="text-green-400">location:</span> "Japan"<br />
            <span class="text-green-400">status:</span> "Always Learning"
          </p>
        </div>
      </div>

      <!-- Skills -->
      <div class="rounded-lg border border-green-400/30 bg-gray-800/50 p-4">
        <h3 class="mb-3 text-lg font-semibold text-green-400">
          <span class="text-gray-400">></span> skills --list
        </h3>
        <div class="space-y-2">
          <div class="flex items-center space-x-2">
            <span class="text-yellow-400">▶</span>
            <span class="text-gray-300">JavaScript/TypeScript</span>
            <div class="ml-2 h-2 flex-1 rounded-full bg-gray-700">
              <div class="h-2 w-5/6 rounded-full bg-green-400"></div>
            </div>
          </div>
          <div class="flex items-center space-x-2">
            <span class="text-yellow-400">▶</span>
            <span class="text-gray-300">React/Vue/Astro</span>
            <div class="ml-2 h-2 flex-1 rounded-full bg-gray-700">
              <div class="h-2 w-4/5 rounded-full bg-green-400"></div>
            </div>
          </div>
          <div class="flex items-center space-x-2">
            <span class="text-yellow-400">▶</span>
            <span class="text-gray-300">Node.js/Python</span>
            <div class="ml-2 h-2 flex-1 rounded-full bg-gray-700">
              <div class="h-2 w-3/4 rounded-full bg-green-400"></div>
            </div>
          </div>
          <div class="flex items-center space-x-2">
            <span class="text-yellow-400">▶</span>
            <span class="text-gray-300">Docker/AWS</span>
            <div class="ml-2 h-2 flex-1 rounded-full bg-gray-700">
              <div class="h-2 w-2/3 rounded-full bg-green-400"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ターミナル風の最近のアクティビティ -->
    <div class="rounded-lg border border-green-400/30 bg-gray-800/50 p-4">
      <h3 class="mb-3 text-lg font-semibold text-green-400">
        <span class="text-gray-400">></span> git log --oneline -5
      </h3>
      <div class="space-y-2 font-mono text-sm">
        <div class="text-gray-300">
          <span class="text-yellow-400">a1b2c3d</span> feat: Add new portfolio design system
        </div>
        <div class="text-gray-300">
          <span class="text-yellow-400">e4f5g6h</span> refactor: Optimize component architecture
        </div>
        <div class="text-gray-300">
          <span class="text-yellow-400">i7j8k9l</span> docs: Update project documentation
        </div>
        <div class="text-gray-300">
          <span class="text-yellow-400">m0n1o2p</span> fix: Resolve responsive layout issues
        </div>
        <div class="text-gray-300">
          <span class="text-yellow-400">q3r4s5t</span> feat: Implement dark mode toggle
        </div>
      </div>
    </div>

    <!-- ASCII Art -->
    <div class="rounded-lg border border-green-400/30 bg-gray-800/50 p-4">
      <h3 class="mb-3 text-lg font-semibold text-green-400">
        <span class="text-gray-400">></span> figlet "i7s7-ymp"
      </h3>
      <pre
        class="text-xs leading-tight text-green-400">
 _ _____ ____ _____ _                           
(_)___  / ___|___  | |__  _   _ _ __ ___  _ __  
| |  / /\___ \  / /| '_ \| | | | '_ ` _ \| '_ \ 
| | / /  ___) |/ / | |_) | |_| | | | | | | |_) |
|_|/_/  |____/_/  |_.__/ \__, |_| |_| |_| .__/ 
                         |___/          |_|    
      </pre>
    </div>
  </div>
</Layout>
