---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home - i7s7-ymp Portfolio">
  <div class="space-y-8">
    <!-- ウェルカムセクション -->
    <div
      class="relative overflow-hidden rounded-2xl border border-primary-600/30 bg-gradient-to-r from-primary-700/20 to-accent-cyan/20 p-8 shadow-2xl backdrop-blur-md"
    >
      <div class="absolute -right-20 -top-20 h-40 w-40 rounded-full bg-accent-blue/20 blur-3xl">
      </div>
      <div class="relative z-10">
        <div class="mb-4 flex items-center space-x-4">
          <div
            class="flex h-16 w-16 animate-glow items-center justify-center rounded-2xl bg-neon-gradient shadow-lg"
          >
            <span class="text-2xl font-bold text-white">i7</span>
          </div>
          <div>
            <h1
              class="bg-gradient-to-r from-white to-slate-300 bg-clip-text text-4xl font-bold text-transparent"
            >
              Welcome to i7s7-ymp's Universe
            </h1>
            <p class="mt-2 text-lg text-slate-300">Creative Developer & Digital Artist ✨</p>
          </div>
        </div>
        <div class="mt-6 flex space-x-2">
          <span
            class="rounded-full border border-accent-cyan/50 bg-accent-cyan/30 px-4 py-2 text-sm font-medium text-white"
          >
            #Creative
          </span>
          <span
            class="rounded-full border border-accent-blue/50 bg-accent-blue/30 px-4 py-2 text-sm font-medium text-white"
          >
            #Developer
          </span>
          <span
            class="rounded-full border border-accent-neon/50 bg-accent-neon/30 px-4 py-2 text-sm font-medium text-white"
          >
            #Technology
          </span>
        </div>
      </div>
    </div>

    <!-- プロフィール情報 -->
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <!-- About -->
      <div
        class="group relative overflow-hidden rounded-2xl border border-primary-500/30 bg-gradient-to-br from-primary-600/10 to-accent-pink/10 p-6 shadow-xl backdrop-blur-md transition-all duration-300 hover:scale-105 hover:shadow-2xl"
      >
        <div
          class="absolute -right-10 -top-10 h-20 w-20 rounded-full bg-accent-gold/20 blur-2xl transition-all group-hover:blur-xl"
        >
        </div>
        <div class="relative z-10">
          <div class="mb-4 flex items-center space-x-3">
            <div class="h-3 w-3 animate-pulse rounded-full bg-accent-neon"></div>
            <h3 class="text-xl font-bold text-white">Profile.json</h3>
          </div>
          <div class="space-y-3 font-mono text-sm">
            <div class="flex justify-between">
              <span class="text-primary-300">name:</span>
              <span class="text-white">"i7s7-ymp"</span>
            </div>
            <div class="flex justify-between">
              <span class="text-primary-300">role:</span>
              <span class="text-accent-pink">"Creative Developer"</span>
            </div>
            <div class="flex justify-between">
              <span class="text-primary-300">location:</span>
              <span class="text-accent-cyan">"Tokyo, Japan"</span>
            </div>
            <div class="flex justify-between">
              <span class="text-primary-300">status:</span>
              <span class="animate-pulse text-accent-neon">"Building the future"</span>
            </div>
            <div class="flex justify-between">
              <span class="text-primary-300">vibe:</span>
              <span class="text-accent-gold">"YOASOBI energy ⚡"</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Skills -->
      <div
        class="group relative overflow-hidden rounded-2xl border border-primary-500/30 bg-gradient-to-br from-accent-cyan/10 to-primary-600/10 p-6 shadow-xl backdrop-blur-md transition-all duration-300 hover:scale-105 hover:shadow-2xl"
      >
        <div
          class="absolute -left-10 -top-10 h-20 w-20 rounded-full bg-accent-coral/20 blur-2xl transition-all group-hover:blur-xl"
        >
        </div>
        <div class="relative z-10">
          <div class="mb-4 flex items-center space-x-3">
            <div class="h-3 w-3 animate-pulse rounded-full bg-accent-cyan"></div>
            <h3 class="text-xl font-bold text-white">Skills.config</h3>
          </div>
          <div class="space-y-4">
            <div class="skill-item">
              <div class="mb-2 flex items-center justify-between">
                <span class="font-medium text-white">JavaScript/TypeScript</span>
                <span class="text-sm text-accent-neon">90%</span>
              </div>
              <div class="h-2 overflow-hidden rounded-full bg-dark-800">
                <div
                  class="skill-bar h-2 rounded-full bg-gradient-to-r from-accent-neon to-accent-cyan"
                  style="width: 90%"
                >
                </div>
              </div>
            </div>
            <div class="skill-item">
              <div class="mb-2 flex items-center justify-between">
                <span class="font-medium text-white">React/Vue/Astro</span>
                <span class="text-sm text-accent-pink">85%</span>
              </div>
              <div class="h-2 overflow-hidden rounded-full bg-dark-800">
                <div
                  class="skill-bar h-2 rounded-full bg-gradient-to-r from-accent-pink to-primary-400"
                  style="width: 85%"
                >
                </div>
              </div>
            </div>
            <div class="skill-item">
              <div class="mb-2 flex items-center justify-between">
                <span class="font-medium text-white">Node.js/Python</span>
                <span class="text-sm text-accent-gold">80%</span>
              </div>
              <div class="h-2 overflow-hidden rounded-full bg-dark-800">
                <div
                  class="skill-bar h-2 rounded-full bg-gradient-to-r from-accent-gold to-accent-coral"
                  style="width: 80%"
                >
                </div>
              </div>
            </div>
            <div class="skill-item">
              <div class="mb-2 flex items-center justify-between">
                <span class="font-medium text-white">Docker/AWS</span>
                <span class="text-sm text-accent-cyan">75%</span>
              </div>
              <div class="h-2 overflow-hidden rounded-full bg-dark-800">
                <div
                  class="skill-bar h-2 rounded-full bg-gradient-to-r from-accent-cyan to-primary-600"
                  style="width: 75%"
                >
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- アクティビティログ -->
    <div
      class="relative overflow-hidden rounded-2xl border border-primary-500/30 bg-gradient-to-br from-dark-900/60 to-primary-900/20 p-6 shadow-xl backdrop-blur-md"
    >
      <div class="absolute -bottom-20 -right-20 h-40 w-40 rounded-full bg-accent-pink/10 blur-3xl">
      </div>
      <div class="relative z-10">
        <div class="mb-6 flex items-center space-x-3">
          <div class="h-3 w-3 animate-pulse rounded-full bg-accent-coral"></div>
          <h3 class="text-xl font-bold text-white">Recent Activity</h3>
          <div class="rounded-full bg-accent-neon/20 px-3 py-1 font-mono text-xs text-accent-neon">
            LIVE
          </div>
        </div>
        <div class="space-y-3 font-mono text-sm">
          <div
            class="flex items-center space-x-4 rounded-lg border border-primary-500/20 bg-primary-600/10 p-3 transition-colors hover:bg-primary-600/20"
          >
            <div class="h-2 w-2 animate-ping rounded-full bg-accent-neon"></div>
            <span class="text-accent-gold">2024.12</span>
            <span class="text-white">New portfolio design system launched</span>
          </div>
          <div
            class="flex items-center space-x-4 rounded-lg border border-primary-500/20 bg-primary-600/10 p-3 transition-colors hover:bg-primary-600/20"
          >
            <div class="h-2 w-2 rounded-full bg-accent-cyan"></div>
            <span class="text-accent-gold">2024.11</span>
            <span class="text-white">Component architecture optimization</span>
          </div>
          <div
            class="flex items-center space-x-4 rounded-lg border border-primary-500/20 bg-primary-600/10 p-3 transition-colors hover:bg-primary-600/20"
          >
            <div class="h-2 w-2 rounded-full bg-accent-pink"></div>
            <span class="text-accent-gold">2024.10</span>
            <span class="text-white">Project documentation update</span>
          </div>
          <div
            class="flex items-center space-x-4 rounded-lg border border-primary-500/20 bg-primary-600/10 p-3 transition-colors hover:bg-primary-600/20"
          >
            <div class="h-2 w-2 rounded-full bg-accent-coral"></div>
            <span class="text-accent-gold">2024.09</span>
            <span class="text-white">Responsive layout improvements</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Creative Banner -->
    <div
      class="relative overflow-hidden rounded-2xl border border-primary-500/30 bg-gradient-to-r from-primary-600/20 via-accent-pink/20 to-accent-cyan/20 p-8 shadow-2xl backdrop-blur-md"
    >
      <div
        class="absolute inset-0 bg-gradient-to-r from-primary-600/10 via-transparent to-accent-cyan/10"
      >
      </div>
      <div class="relative z-10 text-center">
        <h3
          class="mb-4 bg-gradient-to-r from-accent-pink via-white to-accent-cyan bg-clip-text text-2xl font-bold text-transparent"
        >
          ✨ Creative Developer ✨
        </h3>
        <div class="flex justify-center space-x-8 text-6xl">
          <span class="animate-bounce" style="animation-delay: 0s;">🎨</span>
          <span class="animate-bounce" style="animation-delay: 0.2s;">💻</span>
          <span class="animate-bounce" style="animation-delay: 0.4s;">🚀</span>
          <span class="animate-bounce" style="animation-delay: 0.6s;">✨</span>
        </div>
        <p class="mt-4 text-lg text-primary-200">Building the future with code and creativity</p>
      </div>
    </div>
  </div>

  <style>
    .skill-bar {
      animation: skill-fill 2s ease-out forwards;
      transform-origin: left;
    }

    @keyframes skill-fill {
      from {
        transform: scaleX(0);
      }
      to {
        transform: scaleX(1);
      }
    }

    .skill-item:hover .skill-bar {
      box-shadow: 0 0 20px currentColor;
    }
  </style>
</Layout>
