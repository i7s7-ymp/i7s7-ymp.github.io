---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Layout title="Home - i7s7-ymp Portfolio">
  <div
    class="mx-auto w-full max-w-[min(1200px,calc(100vw-19rem))] space-y-10 overflow-x-hidden px-4 lg:px-6"
  >
    <!-- 統一ヘッダー -->
    <PageHeader
      title="i7s7-ymp のユニバースへようこそ"
      subtitle="クリエイティブ × コード ✨"
      icon="i7"
      iconTextClass="text-2xl font-bold text-white"
    >
      <div slot="extra" class="flex flex-wrap gap-2 pt-2">
        <span
          class="rounded-full border border-accent-cyan/50 bg-accent-cyan/30 px-4 py-2 text-xs font-medium text-white"
          >#Creative</span
        >
        <span
          class="rounded-full border border-accent-blue/50 bg-accent-blue/30 px-4 py-2 text-xs font-medium text-white"
          >#Developer</span
        >
        <span
          class="rounded-full border border-accent-neon/50 bg-accent-neon/30 px-4 py-2 text-xs font-medium text-white"
          >#Technology</span
        >
      </div>
    </PageHeader>
    <!-- プロフィール情報 -->
    <div class="grid max-w-full grid-cols-1 gap-6 overflow-x-hidden lg:grid-cols-2">
      <!-- About -->
      <div class="section-card overflow-hidden p-6">
        <div class="absolute -right-10 -top-10 h-20 w-20 rounded-full bg-accent-gold/20 blur-2xl">
        </div>
        <div class="relative z-10">
          <div class="mb-4 flex items-center space-x-3">
            <div class="h-3 w-3 animate-pulse rounded-full bg-accent-neon"></div>
            <h3 class="text-xl font-bold text-white">プロフィール</h3>
          </div>
          <div class="space-y-3 font-mono text-sm">
            <div class="flex justify-between">
              <span class="text-primary-300">name:</span>
              <span class="text-white">"i7s7-ymp"</span>
            </div>
            <div class="flex justify-between">
              <span class="text-primary-300">role:</span>
              <span class="text-accent-pink">"フルスタックエンジニア"</span>
            </div>
            <div class="flex justify-between">
              <span class="text-primary-300">location:</span>
              <span class="text-accent-cyan">"東京 🇯🇵"</span>
            </div>
            <div class="flex justify-between">
              <span class="text-primary-300">status:</span>
              <span class="animate-pulse text-accent-neon">"未来を構築中"</span>
            </div>
            <div class="flex justify-between">
              <span class="text-primary-300">mood:</span>
              <span class="text-accent-gold">"YOASOBI energy ⚡"</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Skills -->
      <div class="section-card overflow-hidden p-6">
        <div class="absolute -left-10 -top-10 h-20 w-20 rounded-full bg-accent-coral/20 blur-2xl">
        </div>
        <div class="relative z-10">
          <div class="mb-4 flex items-center space-x-3">
            <div class="h-3 w-3 animate-pulse rounded-full bg-accent-cyan"></div>
            <h3 class="text-xl font-bold text-white">スキル</h3>
          </div>
          <div class="space-y-4">
            <div class="skill-item">
              <div class="mb-2 flex items-center justify-between">
                <span class="font-medium text-white">JavaScript / TypeScript</span>
                <span class="text-sm text-accent-neon">90%</span>
              </div>
              <div class="h-2 overflow-hidden rounded-full bg-dark-800">
                <div
                  class="skill-bar h-2 rounded-full bg-gradient-to-r from-accent-neon to-accent-cyan"
                  style="width: 90%"
                >
                </div>
              </div>
            </div>
            <div class="skill-item">
              <div class="mb-2 flex items-center justify-between">
                <span class="font-medium text-white">React / Vue / Astro</span>
                <span class="text-sm text-accent-pink">85%</span>
              </div>
              <div class="h-2 overflow-hidden rounded-full bg-dark-800">
                <div
                  class="skill-bar h-2 rounded-full bg-gradient-to-r from-accent-pink to-primary-400"
                  style="width: 85%"
                >
                </div>
              </div>
            </div>
            <div class="skill-item">
              <div class="mb-2 flex items-center justify-between">
                <span class="font-medium text-white">Node.js / Python</span>
                <span class="text-sm text-accent-gold">80%</span>
              </div>
              <div class="h-2 overflow-hidden rounded-full bg-dark-800">
                <div
                  class="skill-bar h-2 rounded-full bg-gradient-to-r from-accent-gold to-accent-coral"
                  style="width: 80%"
                >
                </div>
              </div>
            </div>
            <div class="skill-item">
              <div class="mb-2 flex items-center justify-between">
                <span class="font-medium text-white">Docker / AWS</span>
                <span class="text-sm text-accent-cyan">75%</span>
              </div>
              <div class="h-2 overflow-hidden rounded-full bg-dark-800">
                <div
                  class="skill-bar h-2 rounded-full bg-gradient-to-r from-accent-cyan to-primary-600"
                  style="width: 75%"
                >
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- アクティビティログ -->
    <div class="section-card relative max-w-full overflow-hidden p-6">
      <div
        class="absolute bottom-0 right-0 h-32 w-32 translate-x-10 translate-y-10 rounded-full bg-accent-pink/10 blur-3xl"
      >
      </div>
      <div class="relative z-10">
        <div class="mb-6 flex items-center space-x-3">
          <div class="h-3 w-3 animate-pulse rounded-full bg-accent-coral"></div>
          <h3 class="text-xl font-bold text-white">最近の活動</h3>
          <div class="rounded-full bg-accent-neon/20 px-3 py-1 font-mono text-xs text-accent-neon">
            LIVE
          </div>
        </div>
        <div class="space-y-3 font-mono text-sm">
          <div
            class="flex items-center space-x-4 rounded-lg border border-primary-500/20 bg-primary-600/10 p-3 transition-colors hover:bg-primary-600/20"
          >
            <div class="h-2 w-2 animate-ping rounded-full bg-accent-neon"></div>
            <span class="text-accent-gold">2024.12</span>
            <span class="text-white">デザインシステムを刷新・導入</span>
          </div>
          <div
            class="flex items-center space-x-4 rounded-lg border border-primary-500/20 bg-primary-600/10 p-3 transition-colors hover:bg-primary-600/20"
          >
            <div class="h-2 w-2 rounded-full bg-accent-cyan"></div>
            <span class="text-accent-gold">2024.11</span>
            <span class="text-white">コンポーネント構造の最適化</span>
          </div>
          <div
            class="flex items-center space-x-4 rounded-lg border border-primary-500/20 bg-primary-600/10 p-3 transition-colors hover:bg-primary-600/20"
          >
            <div class="h-2 w-2 rounded-full bg-accent-pink"></div>
            <span class="text-accent-gold">2024.10</span>
            <span class="text-white">ドキュメント整備とアップデート</span>
          </div>
          <div
            class="flex items-center space-x-4 rounded-lg border border-primary-500/20 bg-primary-600/10 p-3 transition-colors hover:bg-primary-600/20"
          >
            <div class="h-2 w-2 rounded-full bg-accent-coral"></div>
            <span class="text-accent-gold">2024.09</span>
            <span class="text-white">レスポンシブレイアウト改善</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Creative Banner -->
    <div class="section-card relative max-w-full overflow-hidden p-8">
      <div
        class="absolute inset-0 bg-gradient-to-r from-primary-600/10 via-transparent to-accent-cyan/10"
      >
      </div>
      <div class="relative z-10 text-center">
        <h3
          class="mb-4 bg-gradient-to-r from-accent-pink via-white to-accent-cyan bg-clip-text text-2xl font-bold text-transparent"
        >
          ✨ クリエイティブ × デベロッパー ✨
        </h3>
        <div class="flex justify-center space-x-8 text-6xl">
          <span class="animate-bounce" style="animation-delay: 0s;">🎨</span>
          <span class="animate-bounce" style="animation-delay: 0.2s;">💻</span>
          <span class="animate-bounce" style="animation-delay: 0.4s;">🚀</span>
          <span class="animate-bounce" style="animation-delay: 0.6s;">✨</span>
        </div>
        <p class="mt-4 text-lg text-primary-200">コードと創造性で未来をハックする</p>
      </div>
    </div>
  </div>

  <style>
    .skill-bar {
      animation: skill-fill 2s ease-out forwards;
      transform-origin: left;
    }

    @keyframes skill-fill {
      from {
        transform: scaleX(0);
      }
      to {
        transform: scaleX(1);
      }
    }

    /* hover発光アニメーションを削除 */
  </style>
</Layout>
