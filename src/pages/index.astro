    /* タイトル文字 フリッカー + ネオングロー */
    .cyber-sign h1 {
      position: relative;
      text-shadow:
        0 0 6px #22d3ee,
        0 0 14px rgba(34, 211, 238, 0.55),
        0 0 28px rgba(236, 72, 153, 0.35);
