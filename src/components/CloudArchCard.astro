---
/** CloudArchCard
 * Props:
 *  - id: string (data-id)
 *  - title: string
 *  - summary: string
 *  - image?: string (public パス)
 *  - services?: string[]
 *  - year?: number
 */
export interface Props {
  id: string;
  title: string;
  summary: string;
  image?: string | undefined;
  services?: string[] | undefined;
  year?: number | undefined;
  class?: string;
  provider?: string | undefined; // 'AWS' | 'GCP' | etc.
}
const {
  id,
  title,
  summary,
  image = undefined,
  services = [],
  year = undefined,
  class: extra = '',
  provider = undefined,
} = Astro.props as Props;
const hasImg = !!image;

// Placeholder SVG generator (deterministic by id for color consistency)
function genPlaceholder(id: string, title: string): string {
  const base: number = Array.from(id).reduce((acc, c) => acc + c.charCodeAt(0), 0);
  const hues: number[] = [190, 210, 165, 250, 330, 20];
  const h: number = hues[base % hues.length] ?? 200;
  const h2 = (h + 40) % 360;
  const bg1 = `hsl(${h} 70% 18%)`;
  const bg2 = `hsl(${h2} 70% 12%)`;
  const accent = `hsl(${h} 85% 62%)`;
  const short = title.trim().slice(0, 2).toUpperCase();
  const safeTitle = title.replace(/&/g, '&amp;').replace(/</g, '&lt;');
  return `<?xml version='1.0' encoding='UTF-8'?>\n<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 320 240' role='img' aria-label='${safeTitle} placeholder'>\n  <defs>\n    <linearGradient id='grad-${id}' x1='0' y1='0' x2='1' y2='1'>\n      <stop offset='0%' stop-color='${bg1}'/>\n      <stop offset='100%' stop-color='${bg2}'/>\n    </linearGradient>\n    <pattern id='pat-${id}' width='32' height='32' patternUnits='userSpaceOnUse' patternTransform='rotate(25)'>\n      <rect width='32' height='32' fill='none'/>\n      <path d='M0 16H32 M16 0V32' stroke='${accent}' stroke-opacity='0.08' stroke-width='4' />\n    </pattern>\n    <mask id='fade-${id}'>\n      <rect width='320' height='240' fill='url(#grad-${id})'/>\n    </mask>\n  </defs>\n  <rect width='320' height='240' fill='url(#grad-${id})'/>\n  <rect width='320' height='240' fill='url(#pat-${id})' mask='url(#fade-${id})'/>\n  <circle cx='260' cy='40' r='60' fill='${accent}' fill-opacity='0.08'/>\n  <text x='50%' y='54%' text-anchor='middle' font-family='system-ui,Helvetica,Arial,sans-serif' font-size='92' font-weight='600' fill='${accent}' fill-opacity='0.75' letter-spacing='2' dy='.35em'>${short}</text>\n  <text x='50%' y='86%' text-anchor='middle' font-family='system-ui,Helvetica,Arial,sans-serif' font-size='18' font-weight='400' fill='${accent}' fill-opacity='0.55'>No Diagram</text>\n</svg>`;
}
const placeholderSvg = genPlaceholder(id, title);
const placeholderDataUri = `data:image/svg+xml;utf8,${encodeURIComponent(placeholderSvg)}`;

// アイコン/ツールチップ機能は不要のため削除 (シンプルバッジのみ)
---

<article class={`cloud-arch-card ${extra}`.trim()} role="listitem" data-id={id}>
  <div class="ca-head">
    <h4 class="ca-title">{title}</h4>
    <div class="ca-meta">
      {
        provider && (
          <span class={`ca-provider ca-provider-${provider.toLowerCase()}`}>{provider}</span>
        )
      }
      {
        year && (
          <span class="ca-year" aria-label="設計年">
            {year}
          </span>
        )
      }
    </div>
  </div>
  <div class="ca-media" aria-hidden="false">
    {
      hasImg ? (
        <img
          loading="lazy"
          decoding="async"
          src={image}
          alt={`${title} 図`}
          onerror={`this.onerror=null;this.src='${placeholderDataUri}';`}
        />
      ) : (
        <img
          loading="lazy"
          decoding="async"
          src={placeholderDataUri}
          alt={`${title} 代替図 (プレースホルダ)`}
        />
      )
    }
  </div>
  <p class="ca-summary">{summary}</p>
  {
    services.length > 0 && (
      <ul class="ca-services" aria-label="使用サービス">
        {services.map(s => (
          <li class="ca-svc-item">{s}</li>
        ))}
      </ul>
    )
  }
  <slot />
</article>

<style>
  .cloud-arch-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: var(--cloud-arch-card-h, 360px); /* 一定高さ */
    background: linear-gradient(145deg, rgba(32, 40, 56, 0.9), rgba(18, 22, 30, 0.9));
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 1rem 1rem 1.1rem;
    box-shadow:
      0 2px 4px -2px rgba(0, 0, 0, 0.4),
      0 4px 18px -4px rgba(0, 0, 0, 0.5);
    transition:
      border-color 0.25s,
      box-shadow 0.25s,
      transform 0.3s;
    overflow: hidden;
  }
  .cloud-arch-card:focus-within,
  .cloud-arch-card:hover {
    border-color: rgba(56, 189, 248, 0.4);
    box-shadow:
      0 3px 6px -2px rgba(0, 0, 0, 0.5),
      0 6px 28px -4px rgba(14, 165, 233, 0.45);
  }
  .cloud-arch-card:hover {
    transform: translateY(-3px);
  }
  .ca-head {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }
  .ca-meta {
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }
  .ca-title {
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.25;
    color: #e0f2fe;
  }
  .ca-provider,
  .ca-year {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.4px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    padding: 0.22rem 0.5rem 0.25rem;
    border-radius: 0.55rem;
    backdrop-filter: blur(2px);
    border: 1px solid transparent;
    position: relative;
  }
  .ca-provider {
    text-transform: uppercase;
  }
  .ca-year {
    background: rgba(56, 189, 248, 0.15);
    color: #67e8f9;
    border-color: rgba(56, 189, 248, 0.35);
  }
  .ca-provider-aws {
    /* (swapped) previously AWS style now uses former GCP palette */
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    color: #fde047;
    border-color: #fbbf24;
  }
  .ca-provider-gcp {
    /* (swapped) previously GCP style now uses former AWS palette */
    background: linear-gradient(135deg, #1e3a8a 0%, #0f172a 100%);
    color: #93c5fd;
    border-color: #1d4ed8;
  }
  .ca-provider-azure {
    background: linear-gradient(135deg, #0a3b78, #061e3a);
    color: #60a5fa;
    border-color: #1d4ed8;
  }
  .ca-provider + .ca-year {
    margin-left: 0.15rem;
  }
  .ca-media {
    /* 固定サイズ (全カード統一) */
    --media-h: var(--cloud-arch-media-h, 180px);
    height: var(--media-h);
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.05);
    margin-bottom: 0.6rem;
    position: relative;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ca-media img {
    width: 100%;
    height: 100%;
    object-fit: contain; /* 図をトリミングせず全体表示 */
    display: block;
    filter: saturate(1.05);
    image-rendering: -webkit-optimize-contrast;
  }
  .ca-media-placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    font-size: 0.72rem;
    color: #64748b;
    opacity: 0.7;
    padding: 0.5rem;
    text-align: center;
  }
  .ca-summary {
    font-size: 0.72rem;
    line-height: 1.35;
    color: #cbd5e1;
    margin: 0 0 0.55rem;
    flex-grow: 1; /* 余白を埋め高さ調整 */
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5; /* 行数制限 */
  }
  .ca-services {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.45rem;
    padding: 0;
    margin: 0;
    margin-top: auto; /* 下端寄せ */
  }
  .ca-svc-item {
    font-size: 0.58rem;
    letter-spacing: 0.3px;
    padding: 0.25rem 0.45rem 0.28rem;
    border-radius: 0.45rem;
    background: linear-gradient(135deg, rgba(14, 165, 233, 0.18), rgba(14, 116, 233, 0.12));
    color: #7dd3fc;
    border: 1px solid rgba(14, 165, 233, 0.35);
    backdrop-filter: blur(2px);
    line-height: 1.1;
  }
  @media (min-width: 920px) {
    .ca-title {
      font-size: 1.02rem;
    }
    .ca-summary {
      font-size: 0.74rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cloud-arch-card {
      transition: none;
    }
    .cloud-arch-card:hover {
      transform: none;
    }
  }
</style>
