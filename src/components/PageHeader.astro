---
interface Props {
  title: string;
  subtitle?: string;
  icon?: string; // 絵文字やテキスト
  iconBgClass?: string; // アイコン背景用クラス
  iconTextClass?: string; // アイコンテキスト用クラス
  statusLabel?: string;
  statusDotClass?: string; // ステータスドット色
  statusTextClass?: string; // ステータステキスト色
  gradientFrom?: string; // 背景グラデーション開始色クラス
  gradientTo?: string; // 背景グラデーション終了色クラス
  class?: string; // 追加ラッパークラス
}

const {
  title,
  subtitle,
  icon = '✨',
  iconBgClass = 'bg-neon-gradient',
  iconTextClass = 'text-2xl font-bold text-white',
  statusLabel,
  statusDotClass = 'bg-accent-neon',
  statusTextClass = 'text-slate-400',
  gradientFrom = 'from-primary-700/20',
  gradientTo = 'to-accent-cyan/20',
  class: extraClass = '',
} = Astro.props as Props;
---

<div
  class={`rounded-2xl border border-primary-600/30 bg-gradient-to-r ${gradientFrom} ${gradientTo} p-6 shadow-2xl backdrop-blur-md relative overflow-hidden ${extraClass}`}
>
  <div class="${extraClass.includes('cyber-sign') ? 'relative' : ''} flex items-center space-x-4">
    <div
      class={`flex h-16 w-16 animate-glow items-center justify-center rounded-2xl shadow-lg ${iconBgClass}`}
    >
      <span class={iconTextClass}>{icon}</span>
    </div>
    <div>
      <h1
        data-text={title}
        class={`text-3xl font-bold ${extraClass.includes('cyber-sign') ? 'text-white tracking-wider' : 'bg-gradient-to-r from-white to-slate-300 bg-clip-text text-transparent'}`}
      >
        {title}
      </h1>
      {
        subtitle && !extraClass.includes('cyber-sign') && (
          <p class="text-lg text-slate-300">{subtitle}</p>
        )
      }
      {
        subtitle && extraClass.includes('cyber-sign') && (
          <p class="long text-lg text-slate-300">
            <span>{subtitle}</span>
          </p>
        )
      }
    </div>
    {
      statusLabel && (
        <div class="ml-auto flex items-center space-x-2">
          <div class={`h-3 w-3 animate-pulse rounded-full ${statusDotClass}`} />
          <span class={`text-sm ${statusTextClass}`}>{statusLabel}</span>
        </div>
      )
    }
  </div>
  <div class="mt-4">
    <slot name="extra" />
  </div>
  {extraClass.includes('cyber-sign') && <div class="sign-bottom-bar" />}
</div>

<style>
  /* スロットが空の場合非表示 */
  div > .mt-4:empty {
    display: none;
  }
</style>
