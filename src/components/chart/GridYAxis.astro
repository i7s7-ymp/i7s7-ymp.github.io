---
export interface Props {
  ticks: number[];
  yMax: number;
  /** class 拡張が必要な場合用 (未使用なら省略) */
  class?: string;
}
const { ticks, yMax, class: className = '' } = Astro.props as Props;
---

<div class={`grid-y ${className}`.trim()} aria-hidden="true">
  {
    ticks.map(t => {
      const pct = (t / yMax) * 100;
      const top = 100 - pct;
      return (
        <div class="grid-row" style={`top:${top}%;`}>
          <span class="grid-line" />
          <span class="grid-label">{t}</span>
        </div>
      );
    })
  }
</div>
