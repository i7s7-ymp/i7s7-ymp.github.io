---
/**
 * ChartBase (Stage6 draft)
 * 共通レイアウトとアクセシビリティ構造を集約。
 * 既存 vchart / pchart DOM と同一構造を保持するため slots 利用。
 * Props:
 *  id: string (DOM id)
 *  kind: 'vchart' | 'pchart'
 *  ariaLabel: string
 *  describedBy?: string
 *  barWidth?: string (CSS var --bar-w)
 *  barsClass?: string (追加で .bars に付与するクラス)
 *  labelsClass?: string (追加で .bar-labels に付与するクラス)
 */
export interface Props {
  id?: string;
  kind?: 'vchart' | 'pchart';
  ariaLabel: string;
  describedBy?: string;
  barWidth?: string; // e.g. 70px
  class?: string;
  count?: number;
  barsClass?: string;
  labelsClass?: string;
}
const {
  id = '',
  kind = 'vchart',
  ariaLabel,
  describedBy = '',
  barWidth,
  class: extClass = '',
  count = 0,
  barsClass = '',
  labelsClass = '',
} = Astro.props as Props;
---

<div
  class={`${kind} ${extClass}`.trim()}
  id={id || undefined}
  role="img"
  aria-label={ariaLabel}
  aria-describedby={describedBy || undefined}
  data-count={count}
  style={barWidth ? `--bar-w:${barWidth};` : undefined}
>
  <div class="plot" data-count={count}>
    <div class="grid-y" aria-hidden="true">
      <slot name="ticks" />
    </div>
    <div class={`bars ${barsClass}`.trim()} data-count={count}>
      <slot name="bars" />
    </div>
    <div class="axis-x" aria-hidden="true"></div>
  </div>
  <div class={`bar-labels ${labelsClass}`.trim()} aria-hidden="false">
    <slot name="labels" />
  </div>
</div>
<!-- NOTE: 既存スタイルは各ページ側に保持。将来的に tokens + 専用CSSへ抽出 -->
